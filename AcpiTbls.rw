		}
		Device(PRRE)
		{
			Name(_HID, EISAID("PNP0C02"))
			Name(_UID, "PCHRESV")
			Name(_STA, 0x08)
			Method(_CRS, 0, Serialized)
			{
				Name(BUF0, ResourceTemplate()
				{
					Memory32Fixed(ReadWrite, 0xFE000000, 0x00020000)
					Memory32Fixed(ReadWrite, 0xFE04C000, 0x00004000)
					Memory32Fixed(ReadWrite, 0xFE050000, 0x00060000)
					Memory32Fixed(ReadWrite, 0xFE0D0000, 0x00030000)
					Memory32Fixed(ReadWrite, 0xFE200000, 0x00600000)
					Memory32Fixed(ReadOnly, 0xFF000000, 0x01000000)
					IO(Decode16, 0x0000, 0x0000, 0x01, 0xFF)
				})
				CreateWordField(BUF0, 0x4A, AMIN)
				CreateWordField(BUF0, 0x4C, AMAX)
				Store(PMBS, AMIN)
				Store(PMBS, AMAX)
				Name(SBR0, ResourceTemplate()
				{
					Memory32Fixed(ReadWrite, 0x00000000, 0x00D10000)
				})
				CreateDWordField(SBR0, 0x04, BAS0)
				Store(SBRG, BAS0)
				ConcatenateResTemplate(BUF0, SBR0, Local0)
				Name(SBRE, ResourceTemplate()
				{
					Memory32Fixed(ReadWrite, 0x00000000, 0x00000000)
				})
				CreateDWordField(SBRE, 0x04, BAS3)
				CreateDWordField(SBRE, 0x08, LEN3)
				Store(Add(SBRG, 0x00D60000), BAS3)
				Store(Subtract(Add(SBRG, 0x10000000), BAS3), LEN3)
				ConcatenateResTemplate(Local0, SBRE, Local2)
				Return(Local2)
			}
		}
		Device(IOTR)
		{
			Name(_HID, EISAID("PNP0C02"))
			Name(_UID, "IoTraps")
			Method(_CRS, 0, NotSerialized)
			{
				Name(BUF0, ResourceTemplate()
				{
					IO(Decode16, 0x0000, 0x0000, 0x01, 0xFF)
				})
				Name(BUF1, ResourceTemplate()
				{
					IO(Decode16, 0x0000, 0x0000, 0x01, 0xFF)
				})
				Name(BUF2, ResourceTemplate()
				{
					IO(Decode16, 0x0000, 0x0000, 0x01, 0xFF)
				})
				Name(BUF3, ResourceTemplate()
				{
					IO(Decode16, 0x0000, 0x0000, 0x01, 0xFF)
				})
				CreateWordField(BUF0, 0x02, AMI0)
				CreateWordField(BUF0, 0x04, AMA0)
				CreateWordField(BUF1, 0x02, AMI1)
				CreateWordField(BUF1, 0x04, AMA1)
				CreateWordField(BUF2, 0x02, AMI2)
				CreateWordField(BUF2, 0x04, AMA2)
				CreateWordField(BUF3, 0x02, AMI3)
				CreateWordField(BUF3, 0x04, AMA3)
				Store(Zero, Local2)
				If(LEqual(ITS0, One))
				{
					Store(ITA0, AMI0)
					Store(ITA0, AMA0)
					Store(BUF0, Local0)
					Store(One, Local2)
				}
				If(LEqual(ITS1, One))
				{
					Store(ITA1, AMI1)
					Store(ITA1, AMA1)
					If(LEqual(Local2, One))
					{
						ConcatenateResTemplate(BUF1, Local0, Local1)
						Store(Local1, Local0)
					}
					Else
					{
						Store(BUF1, Local0)
						Store(One, Local2)
					}
				}
				If(LEqual(ITS2, One))
				{
					Store(ITA2, AMI2)
					Store(ITA2, AMA2)
					If(LEqual(Local2, One))
					{
						ConcatenateResTemplate(BUF2, Local0, Local1)
						Store(Local1, Local0)
					}
					Else
					{
						Store(BUF2, Local0)
						Store(One, Local2)
					}
				}
				If(LEqual(ITS3, One))
				{
					Store(ITA3, AMI3)
					Store(ITA3, AMA3)
					If(LEqual(Local2, One))
					{
						ConcatenateResTemplate(BUF3, Local0, Local1)
						Store(Local1, Local0)
					}
					Else
					{
						Store(BUF3, Local0)
						Store(One, Local2)
					}
				}
				If(LEqual(Local2, One))
				{
					Return(Local0)
				}
				Else
				{
					Return(
					)
				}
			}
		}
