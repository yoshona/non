					{
						Return(WEDT)
					}
					If(LEqual(Arg2, 0x0B))
					{
						If(CondRefOf(DRIE))
						{
							If(CondRefOf(CRFI))
							{
								If(LAnd(LEqual(DRIE, One), LEqual(CRFI, One)))
								{
