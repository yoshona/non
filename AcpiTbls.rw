			}
			Return(DM_B)
		}
		Method(_CRS, 0, Serialized)
		{
			CreateWordField(BUF0, 0x0A, PBMX)
			CreateWordField(BUF0, 0x0E, PBLN)
			CreateWordField(BUF0, 0x08, PBMN)
			Store(GPCL(), Local0)
			Store(Subtract(ShiftRight(Local0, 0x14), 0x02), PBMX)
			Store(Subtract(ShiftRight(Local0, 0x14), One), PBLN)
			If(CondRefOf(\VMDE))
			{
				If(LAnd(LEqual(VMDE, One), LGreater(PBMX, 0xDF)))
				{
					Store(0xDF, PBMX)
					Store(0xE0, PBLN)
					ADBG(Concatenate("[ASL]VMD is enabled, restricting Bus numbers to -", ToHexString(PBMX)))
				}
			}
			If(^MC.PM1L)
			{
				CreateDWordField(BUF0, 0x7C, C0LN)
				Store(Zero, C0LN)
