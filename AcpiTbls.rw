	Scope(_SB)
	{
		Method(GDSC, 0, NotSerialized)
		{
			If(LEqual(PCHS, 0x04))
			{
				Return(GPCS)
			}
			Else
			{
				Return(GPCM)
			}
		}
		Method(GMXG, 0, NotSerialized)
		{
			If(LEqual(PCHS, 0x04))
			{
				Return(0x08)
			}
			Else
			{
				Return(0x0E)
			}
		}
		Method(GCMP, 1, NotSerialized)
		{
			Store(GDSC(), Local0)
			Return(DerefOf(Index(DerefOf(Index(Local0, Arg0)), Zero)))
		}
		Method(GINF, 3, NotSerialized)
		{
			Store(GDSC(), Local0)
			Return(DerefOf(Index(DerefOf(Index(DerefOf(Index(DerefOf(Index(Local0, Arg0)), One)), Arg1)), Arg2)))
		}
		Method(GCOM, 1, Serialized)
		{
			And(ShiftRight(Arg0, 0x0A), 0x07, Local0)
			Return(Local0)
		}
		Method(GGRP, 1, Serialized)
		{
			And(ShiftRight(Arg0, 0x07), 0x07, Local0)
			Return(Local0)
		}
		Method(GNMB, 1, Serialized)
		{
			Return(And(Arg0, 0x7F))
		}
		Method(GADR, 2, NotSerialized)
		{
			Store(GGRP(Arg0), Local2)
			Store(GCOM(Arg0), Local3)
			Store(Add(GCMP(Local3), SBRG), Local0)
			Store(GINF(Local3, Local2, Arg1), Local1)
			Return(Add(Local0, Local1))
		}
		Method(GNUM, 1, NotSerialized)
		{
			Store(GNMB(Arg0), Local0)
			Store(GGRP(Arg0), Local1)
			Store(GCOM(Arg0), Local2)
			Return(Add(GINF(Local2, Local1, 0x07), Local0))
		}
		Method(GGGP, 1, NotSerialized)
		{
			Store(GGRP(Arg0), Local0)
			Store(GCOM(Arg0), Local1)
			Return(GINF(Local1, Local0, 0x08))
		}
		Method(INUM, 1, NotSerialized)
		{
			Return(And(GPC1(Arg0), 0x7F))
		}
		Method(GGPE, 1, NotSerialized)
		{
			Store(GGGP(Arg0), Local0)
			Store(GNMB(Arg0), Local1)
			Store(ShiftRight(Local1, 0x05), Local2)
			If(LNot(Or(Or(LAnd(LEqual(GEI0, Local0), LEqual(GED0, Local2)), LAnd(LEqual(GEI1, Local0), LEqual(GED1, Local2))), LAnd(LEqual(GEI2, Local0), LEqual(GED2, Local2)))))
			{
				Return(0x6F)
			}
			Else
			{
				If(LAnd(LEqual(GEI0, Local0), LEqual(GED0, Local2)))
				{
					Store(Zero, Local3)
				}
				Else
				{
					If(LAnd(LEqual(GEI1, Local0), LEqual(GED1, Local2)))
					{
						Store(One, Local3)
					}
					Else
					{
						If(LAnd(LEqual(GEI2, Local0), LEqual(GED2, Local2)))
						{
							Store(0x02, Local3)
						}
						Else
						{
							BreakPoint
							Return(Zero)
						}
					}
				}
				Return(Add(Multiply(Subtract(Local3, Local2), 0x20), Local1))
			}
		}
		Method(GPC0, 1, Serialized)
		{
			Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
			OperationRegion(PDW0, SystemMemory, Local2, 0x04)
			Field(PDW0, AnyAcc, NoLock, Preserve)
