							Arg1
							Arg2
							Arg3
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(LEqual(Arg0, ToUUID("BAD01B75-22A84F48-8792BDDE9467747D")}))
						{
