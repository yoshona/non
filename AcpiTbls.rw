		})
		Name(CREI, ResourceTemplate()
		{
			Memory32Fixed(ReadWrite, 0xFED40000, 0x00005000)
			Interrupt(ResourceConsumer, Level, ActiveLow, Shared,,,)
			{
				0x00000000
			}
		})
		Method(_CRS, 0, Serialized)
		{
			If(LEqual(AMDT, One))
			{
				CreateDWordField(CRST, 0x04, MTFB)
				CreateDWordField(CRST, 0x08, LTFB)
				Store(TPMB, MTFB)
				Store(TPBS, LTFB)
				CreateDWordField(CRST, 0x10, MTFC)
				CreateDWordField(CRST, 0x14, LTFC)
				Store(TPMC, MTFC)
				Store(TPCS, LTFC)
				Return(CRST)
			}
			Else
			{
				If(LEqual(DTP1, One))
				{
					CreateDWordField(CRSD, 0x04, MTFE)
					CreateDWordField(CRSD, 0x08, LTFE)
					Store(0xFED40000, MTFE)
					Store(0x5000, LTFE)
					Return(CRSD)
				}
				Else
				{
					If(LEqual(TTPF, One))
					{
						If(LOr(LEqual(TMRQ, Zero), LEqual(TMRQ, 0xFFFFFFFF)))
						{
							CreateDWordField(CRID, 0x04, MTFD)
							CreateDWordField(CRID, 0x08, LTFD)
							Store(0xFED40000, MTFD)
							Store(0x5000, LTFD)
							Return(CRID)
						}
						Else
						{
							CreateDWordField(CREI, 0x11, LIRQ)
							Store(TMRQ, LIRQ)
							Return(CREI)
						}
					}
					Else
					{
						If(LEqual(TTPF, Zero))
						{
							CreateDWordField(CRST, 0x10, MTFF)
							Store(FTPM, MTFF)
							Return(CRST)
						}
					}
				}
				Store(Zero, MTFE)
				Store(Zero, LTFE)
				Return(CRID)
			}
			Return(CRID)
		}
		Method(_SRS, 1, Serialized)
		{
			If(LAnd(LNotEqual(TMRQ, Zero), LNotEqual(TMRQ, 0xFFFFFFFF)))
			{
				CreateDWordField(Arg0, 0x11, IRQ0)
				CreateDWordField(CREI, 0x11, LIRQ)
				Store(IRQ0, LIRQ)
				Store(IRQ0, TMRQ)
				CreateBitField(Arg0,0x79,ITRG)
				CreateBitField(CREI,0x79,LTRG)
				Store(ITRG, LTRG)
				CreateBitField(Arg0,0x7A,ILVL)
				CreateBitField(CREI,0x7A,LLVL)
				Store(ILVL, LLVL)
				If(LOr(LEqual(And(IDTF, 0x0F), Zero), LEqual(And(IDTF, 0x0F), 0x0F)))
				{
					If(LLess(IRQ0, 0x10))
					{
						Store(And(IRQ0, 0x0F), INTV)
					}
					If(LEqual(ITRG, One))
					{
						Or(INTE, 0x10, INTE)
					}
					Else
					{
						And(INTE, 0xFFFFFFEF, INTE)
					}
					If(LEqual(ILVL, Zero))
					{
						Or(INTE, 0x08, INTE)
					}
					Else
					{
						And(INTE, 0xFFFFFFF7, INTE)
					}
				}
			}
		}
