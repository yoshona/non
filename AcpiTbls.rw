			ADBG(Concatenate("PON Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
			If(CondRefOf(CEMP))
			{
				CEMP
				One
			}
			If(CondRefOf(WAKG))
			{
				If(LNotEqual(WAKG, Zero))
				{
					\_SB.PGPI.SHPO
					WAKG
					One
					\_SB.PGPI.CGPI
					WAKG
					ADBG(Concatenate("WAKG: set GPIO mode ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
				}
			}
			If(LAnd(CondRefOf(PRTP), LEqual(PRTP, 0x02)))
			{
				\_SB.PSD0(SLOT)
			}
			If(CondRefOf(SCLK))
			{
				If(CondRefOf(PRTP))
				{
					If(LEqual(PRTP, 0x02))
					{
						\_SB.PCLK.SPCO
						SCLK
						One
					}
					Else
					{
						SPCO(SCLK, One)
					}
				}
			}
			If(CondRefOf(PWRG))
			{
				If(CondRefOf(WOFF))
				{
					If(LNotEqual(WOFF, Zero))
					{
						Timer(), WOFF), 0x2710, , Local0)
						If(LLess(Local0, PDOD))
						{
							Sleep(Subtract(PDOD, Local0))
							ADBG(Concatenate("Rtd3Pcie Generic _ON Sleep time : ", ToHexString(Subtract(PDOD, Local0))))
							ADBG(Concatenate("Rtd3Pcie Generic _ON Local0 time : ", ToHexString(Local0)))
						}
						Store(Zero, WOFF)
					}
				}
				ADBG(Concatenate("Rtd3Pcie Generic _ON PDOD time : ", ToHexString(PDOD)))
				Timer())))
				\PPIN.ON
				PWRG
				Store(Zero, Local0)
				Store(0x0A, PGOD)
				While(LNotEqual(\_SB.PGPI.GGIV, 0x00160017))
				{
					One
					Subtract(PGOD, One, PGOD)
					If(LEqual(PGOD, Zero))
					{
						Store(One, Local0)
						Break
					}
					Sleep(One)
				}
				Sleep(0x0A)
			}
			\PPIN.OFF
			RSTG
			Sleep(0x01F4)
		}
		Method(POFF, 0, NotSerialized)
		{
			ADBG(Concatenate("POFF Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
