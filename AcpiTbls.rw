								^PC02.RP11.PXSX.FHRF
								Arg0
							}
							Sleep(Arg1)
							ADBG(Concatenate("WFRT Delay1  ", ToDecimalString(Arg1)))
							Notify(^PC02.RP11.PXSX, One)
							If(CondRefOf(\_SB.PC02.RP11.PXSX.SHRF))
							{
								^PC02.RP11.PXSX.SHRF
							}
							Sleep(Arg2)
							ADBG(Concatenate("WFRT Delay2  ", ToDecimalString(Arg2)))
							Notify(^PC02.RP11.PXSX, One)
							ADBG("End WWAN Warm Reset")
							Release(WWMT)
							Store(Zero, Local0)
							ADBG("WWAN Warm Reset Mutex: Release Done")
							If(CondRefOf(\_SB.PC02.RP11.PXSX.DOSV))
							{
								^PC02.RP11.PXSX.DOSV
							}
						}
						If(LEqual(WWRP, 0x0C))
						{
							If(LEqual(Arg0, Zero))
							{
								ADBG("Start WWAN Warm Reset")
							}
							Else
							{
								ADBG("Start WWAN Cold Reset")
							}
							If(CondRefOf(\_SB.PC02.RP12.PXSX.FHRF))
							{
								^PC02.RP12.PXSX.FHRF
								Arg0
							}
							Sleep(Arg1)
							ADBG(Concatenate("WFRT Delay1  ", ToDecimalString(Arg1)))
							Notify(^PC02.RP12.PXSX, One)
							If(CondRefOf(\_SB.PC02.RP12.PXSX.SHRF))
							{
								^PC02.RP12.PXSX.SHRF
							}
							Sleep(Arg2)
							ADBG(Concatenate("WFRT Delay2  ", ToDecimalString(Arg2)))
							Notify(^PC02.RP12.PXSX, One)
							ADBG("End WWAN Warm Reset")
							Release(WWMT)
							Store(Zero, Local0)
							ADBG("WWAN Warm Reset Mutex: Release Done")
							If(CondRefOf(\_SB.PC02.RP12.PXSX.DOSV))
							{
								^PC02.RP12.PXSX.DOSV
							}
						}
						If(LEqual(Local0, One))
						{
							Release(WWMT)
						}
					}
				}
				Device(MFFD)
				{
					Name(_HID, "INTC1073")
					Name(_STR, Unicode("Modem Firmware Flash Device")})
					Method(_STA, 0, NotSerialized)
					{
						If(LEqual(WFFD, One))
						{
							Return(0x0F)
						}
						Else
						{
							Return(Zero)
						}
					}
					Method(_DSM, 4, Serialized)
					{
						If(LEqual(Arg0, ToUUID("0F3D57AA-604647B2-8A9A88F1021D3865")}))
						{
							If(LEqual(Arg2, Zero))
							{
								If(LEqual(Arg1, Zero))
								{
									Return(Buffer(One)
									{
										0x07
									})
								}
								Else
								{
									Return(Buffer(One)
									{
										0x00
									})
								}
							}
							If(LEqual(Arg2, One))
							{
								ADBG("MFFD FLDR")
								WFRT
								Zero
								DerefOf(Index(Arg3, Zero))
								DerefOf(Index(Arg3, One))
								Return(Buffer(One)
								{
									0x00
								})
							}
							If(LEqual(Arg2, 0x02))
							{
								ADBG("MFFD PLDR")
								WFRT
								One
								DerefOf(Index(Arg3, Zero))
								DerefOf(Index(Arg3, One))
								Return(Buffer(One)
								{
									0x00
								})
							}
							Return(Zero)
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
				}
			}
		}
	}
