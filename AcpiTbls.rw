					{
						If(LNotEqual(^H_EC.DUMY.ERVP, PWRS))
						{
							Store(^H_EC.DUMY.ERVP, PWRS)
							SPNT()
							BPNT()
						}
					}
					Else
					{
						If(LNotEqual(^H_EC.DUMY.ERAP, PWRS))
						{
							Store(^H_EC.DUMY.ERAP, PWRS)
							SPNT()
							BPNT()
