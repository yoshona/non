			}
			Return(LEqual(CSTS, 0x03))
		}
		Method(GNOT, 2, NotSerialized)
		{
			If(PDRD())
			{
				Return(One)
			}
			Store(Arg0, CEVT)
			Store(0x03, CSTS)
			If(LEqual(Arg1, Zero))
			{
				Notify(\_SB.PC00.GFX0, Arg1)
			}
			If(CondRefOf(HNOT))
			{
				HNOT
				Arg0
			}
			Else
			{
				Notify(\_SB.PC00.GFX0, 0x80)
			}
			Return(Zero)
		}
		Method(GLID, 1, NotSerialized)
		{
			If(LEqual(Arg0, One))
			{
				Store(0x03, CLID)
			}
			Else
			{
				Store(Arg0, CLID)
			}
			If(GNOT(0x02, Zero))
			{
				Or(CLID, 0x80000000, CLID)
				Return(One)
			}
			Return(Zero)
		}
		Method(GDCK, 1, NotSerialized)
