										{
											Store(Zero, PLST)
										}
										Store(Zero, GUPS)
									}
									Else
									{
										If(LEqual(ToInteger(GPPC), 0x03))
										{
											GC6O()
											If(LNotEqual(ToInteger(PLPC), Zero))
											{
												Store(Zero, PLST)
											}
											Store(One, GPWO)
											Store(One, GUPS)
										}
										Else
										{
											If(LEqual(ToInteger(GPPC), 0x04))
											{
												GC6O()
												If(LNotEqual(ToInteger(PLPC), Zero))
												{
													Store(Zero, PLST)
												}
												Store(One, GPWO)
												Store(One, GUPS)
											}
											Else
											{
												Store("<<< GETS >>>", Debug)
												If(LEqual(\_SB.PGPI.GGIV, 0x00160017))
												{
													One
													Store("<<< GETS() return 0x1 >>>", Debug)
													Store(One, GPWO)
													Store(One, GUPS)
												}
												Else
												{
													Store("<<< GETS() return 0x3 >>>", Debug)
													Store(Zero, GPWO)
													Store(0x03, GUPS)
												}
											}
										}
									}
								}
								Return(JTPC)
							}
							Else
							{
								If(LEqual(_T_0, 0x04))
								{
									Store("   JT fun4 JT_FUNC_PLATPOLICY", Debug)
									CreateField(Arg3,0x02,One,PAUD)
									CreateField(Arg3,0x03,One,PADM)
									CreateField(Arg3,0x04,0x04,PDGS)
									Store(Zero, Local0)
									ShiftLeft(\_SB.PC00.RP09.PXSX.NHDA, 0x02, Local0)
									Return(Local0)
								}
							}
						}
					}
				}
				Break
			}
			Return(0x80000002)
		}
	}
	Scope(\_SB.PC00.RP09.PXSX)
	{
		Name(NLIM, One)
		Name(PSLS, Zero)
		Name(CTGP, Zero)
		Name(GPSP, Buffer(0x28){})
		CreateDWordField(GPSP, Zero, RETN)
		CreateDWordField(GPSP, 0x04, VRV1)
		CreateDWordField(GPSP, 0x08, TGPU)
		CreateDWordField(GPSP, 0x0C, PDTS)
		CreateDWordField(GPSP, 0x10, SFAN)
		CreateDWordField(GPSP, 0x14, SKNT)
		CreateDWordField(GPSP, 0x18, CPUE)
		CreateDWordField(GPSP, 0x1C, TMP1)
		CreateDWordField(GPSP, 0x20, TMP2)
		Method(GPS, 4, Serialized)
		{
			Name(_T_1, Zero)
			Name(_T_0, Zero)
			Store("------- NV GPS DSM --------", Debug)
			If(LNotEqual(Arg1, 0x0200))
			{
				Return(0x80000002)
			}
			While(One)
			{
				Store(ToInteger(Arg2), _T_0)
				If(LEqual(_T_0, Zero))
				{
					Store("GPS fun 0", Debug)
					Return(Buffer(0x08)
					{
						0x01, 0x00, 0x0C, 0x00, 0x01, 0x04, 0x00, 0x00
					})
				}
				Else
				{
					If(LEqual(_T_0, 0x12))
					{
						Store("GPS fun 18", Debug)
					}
					Else
					{
						If(LEqual(_T_0, 0x13))
						{
							Store("GPS fun 19", Debug)
							CreateDWordField(Arg3, Zero, TEMP)
							If(LEqual(TEMP, Zero))
							{
								Return(0x04)
							}
							If(LAnd(TEMP, 0x04))
							{
								Return(0x04)
							}
						}
						Else
						{
							If(LEqual(_T_0, 0x20))
							{
								Store("GPS fun 32", Debug)
								Name(RET1, Zero)
								CreateBitField(Arg3,0x02,SPBI)
								If(NLIM)
								{
									Or(RET1, One, RET1)
								}
								If(PSLS)
								{
									Or(RET1, 0x02, RET1)
								}
								If(CTGP)
								{
									Or(RET1, 0x00400000, RET1)
								}
								Return(RET1)
							}
							Else
							{
								If(LEqual(_T_0, 0x2A))
								{
									Store("GPS fun 42", Debug)
									CreateField(Arg3,Zero,0x04,PSH0)
									CreateBitField(Arg3,0x08,GPUT)
									Store(0x00010000, VRV1)
									While(One)
									{
										Store(ToInteger(PSH0), _T_1)
										If(LEqual(_T_1, Zero))
										{
											Return(GPSP)
										}
										Else
										{
											If(LEqual(_T_1, One))
											{
												Store(0x0100, RETN)
												Or(RETN, ToInteger(PSH0), RETN)
												Return(GPSP)
											}
											Else
											{
												If(LEqual(_T_1, 0x02))
												{
													Store(0x0102, RETN)
													If(CondRefOf(\_SB.PC00.LPCB.EC0.CGCT))
													{
														Store(\_SB.PC00.LPCB.EC0.CGCT, TGPU)
													}
													Else
													{
														Store(0x57, TGPU)
													}
													Return(GPSP)
												}
											}
										}
										Break
									}
									Return(0x80000002)
								}
							}
						}
					}
				}
				Break
			}
			Return(0x80000002)
		}
	}
