	Method(GMIO, 3, Serialized)
	{
		OperationRegion(PXCS, SystemMemory, \_SB.PC00.PC2M(Arg1, Arg0), 0x20)
		Field(PXCS, AnyAcc, NoLock, Preserve)
		{
			Offset(0x18),	//Offset(24),
			PBUS, 8,
			SBUS, 8,
		}
		Store(\_SB.PC00.GPCB(), Local0)
		Add(Local0, ShiftRight(And(Arg2, 0x001F0000), One), Local0)
		Add(Local0, ShiftLeft(And(Arg2, 0x07), 0x0C), Local0)
		Add(Local0, ShiftLeft(SBUS, 0x14), Local0)
		Return(Local0)
	}
	If(CondRefOf(\_SB.PC00.RP17.PXSX))
	{
		Scope(_SB.PC00.RP17.PXSX)
		{
			OperationRegion(RPXX, SystemMemory, GMIO(PBNU, ^_ADR, _ADR), 0x30)
			Field(RPXX, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x2C),	//Offset(44),
				SVID, 16,
			}
			OperationRegion(FLDR, SystemMemory, Add(GMIO(PBNU, ^_ADR, _ADR), WDCO), 0x06)
			Field(FLDR, ByteAcc, NoLock, Preserve)
			{
				DCAP, 32,
				DCTR, 16,
			}
			OperationRegion(VSEC, SystemMemory, Add(GMIO(PBNU, ^_ADR, _ADR), WVHO), 0x10)
			Field(VSEC, AnyAcc, NoLock, Preserve)
			{
				Offset(0xC),	//Offset(12),
				, 1,
				BTIE, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				PDRC, 1,
			}
			OperationRegion(PBRR, SystemMemory, GMIO(PBNU, ^_ADR, _ADR), 0x02B8)
			Field(PBRR, AnyAcc, NoLock, Preserve)
			{
				Offset(0x18C),	//Offset(396),
				MSNL, 32,
				Offset(0x198),	//Offset(408),
				L1C1, 32,
				L1C2, 32,
				Offset(0x2B4),	//Offset(692),
				PTMR, 32,
			}
			Method(WIST, 0, Serialized)
			{
				Name(_T_0, Zero)
				If(CondRefOf(VDID))
				{
					While(One)
					{
						Store(ToInteger(VDID), _T_0)
						If(LEqual(_T_0, 0x25268086))
						{
							Return(One)
						}
						Else
						{
							If(LEqual(_T_0, 0x271B8086))
							{
								Return(One)
							}
							Else
							{
								If(LEqual(_T_0, 0x27238086))
								{
									Return(One)
								}
								Else
								{
									If(LEqual(_T_0, 0x27258086))
									{
										Return(One)
									}
									Else
									{
										If(LEqual(_T_0, 0x272B8086))
										{
											Return(One)
										}
										Else
										{
											If(LEqual(SVDC, One))
											{
												Return(One)
											}
											Return(Zero)
										}
									}
								}
							}
						}
						Break
					}
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(WWST, 0, Serialized)
			{
				Name(_T_0, Zero)
				If(CondRefOf(VDID))
				{
					While(One)
					{
						Store(ToInteger(VDID), _T_0)
						If(LEqual(_T_0, 0x73608086))
						{
							Return(One)
						}
						Else
						{
							If(LEqual(_T_0, 0x75608086))
							{
								Return(One)
							}
							Else
							{
								If(LEqual(_T_0, 0x4D7514C3))
								{
									Return(One)
								}
								Else
								{
									If(LEqual(_T_0, 0x080014C3))
									{
										Return(One)
									}
									Else
									{
										Return(Zero)
									}
								}
							}
						}
						Break
					}
				}
				Else
				{
					Return(Zero)
				}
			}
			If(WIST)
			{
				Name(RSTY, Zero)
				Name(FLRC, Zero)
				Name(BOFC, Zero)
				Name(DPRS, Zero)
				PowerResource(WRST, 5, 0)
				{
					Method(_STA, 0, NotSerialized)
					{
						ADBG("Wifi PR _STA")
						Return(One)
					}
					Method(_ON, 0, NotSerialized)
					{
						ADBG("Wifi PR _ON")
					}
					Method(_OFF, 0, NotSerialized)
					{
						ADBG("Wifi PR _OFF")
					}
					Method(_RST, 0, NotSerialized)
					{
						If(LEqual(RSTY, One))
						{
							ADBG("Wifi Product RST")
							Store(Acquire(CNMT, 0x03E8), Local0)
							If(LEqual(Local0, Zero))
							{
								If(LEqual(FLRC, One))
								{
									Store(DCTR, Local0)
									Or(Local0, 0x8000, Local0)
									Store(Local0, DCTR)
									Sleep(FDEL)
								}
								Store(One, DPRS)
								If(LEqual(BOFC, One))
								{
									If(LEqual(BRMT, Zero))
									{
										BTRK(Zero)
									}
									Else
									{
										If(LNotEqual(WVHO, Zero))
										{
											Store(Zero, BTIE)
										}
									}
									Sleep(RDLY)
								}
								Store(One, PDRC)
								Sleep(VDEL)
								^^^^^PGPI.SGOV
								WLRT
								Zero
								Sleep(PDEL)
								^^^^^PGPI.SGOV
								WLRT
								One
								If(LEqual(BOFC, One))
								{
									If(LEqual(BRMT, Zero))
									{
										BTRK(One)
									}
									Else
									{
										If(LNotEqual(WVHO, Zero))
										{
											Store(One, BTIE)
										}
									}
									Sleep(RDLY)
								}
								Store(0x02, DPRS)
								Release(CNMT)
							}
						}
						Else
						{
							ADBG("Wifi Core RST")
							If(And(DCAP, 0x10000000))
							{
								Store(DCTR, Local0)
								Or(Local0, 0x8000, Local0)
								Store(Local0, DCTR)
							}
							Store(One, DPRS)
						}
						Sleep(0x07D0)
						Store(DR01, MSNL)
						Store(DR02, L1C1)
						Store(DR03, L1C2)
						Store(DR04, PTMR)
						Sleep(0x07D0)
					}
				}
				Name(SPLX, Package(2)
				{
					Zero, 
					Package(3) {0x80000000, 0x80000000, 0x80000000}
				})
				Method(SPLC, 0, Serialized)
				{
					Store(DOM1, Index(DerefOf(Index(SPLX, One)), Zero))
					Store(LIM1, Index(DerefOf(Index(SPLX, One)), One))
					Store(TIM1, Index(DerefOf(Index(SPLX, One)), 0x02))
					Return(SPLX)
				}
				Name(WANX, Package(3)
				{
					Zero, 
					Package(3) {0x80000000, 0x80000000, 0x80000000}, 
					Package(3) {0x80000000, 0x80000000, 0x80000000}
				})
				Method(WAND, 0, Serialized)
				{
					Store(Zero, Index(DerefOf(Index(WANX, One)), Zero))
					Store(TRD0, Index(DerefOf(Index(WANX, One)), One))
					Store(TRL0, Index(DerefOf(Index(WANX, One)), 0x02))
					Store(One, Index(DerefOf(Index(WANX, 0x02)), Zero))
					Store(TRD1, Index(DerefOf(Index(WANX, 0x02)), One))
					Store(TRL1, Index(DerefOf(Index(WANX, 0x02)), 0x02))
					Return(WANX)
				}
				Name(WRDX, Package(2)
				{
					Zero, 
					Package(2) {0x80000000, 0x8000}
				})
				Method(WRDD, 0, Serialized)
