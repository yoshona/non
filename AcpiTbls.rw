					ADBG("Let's push TBT RPs to D3Cold together")
					If(LNotEqual(\_SB.PC00.TRP2.VDID, 0xFFFFFFFF))
					{
						ADBG(Concatenate("PC00.TRP2.PDSX -", ToHexString(\_SB.PC00.TRP2.PDSX)))
						If(LEqual(\_SB.PC00.TRP2.PDSX, One))
						{
							Store(One, CTP1)
						}
						\_SB.PC00.TRP2.D3CE()
					}
					If(LNotEqual(\_SB.PC00.TRP3.VDID, 0xFFFFFFFF))
					{
						ADBG(Concatenate("PC00.TRP3.PDSX -", ToHexString(\_SB.PC00.TRP3.PDSX)))
						If(LEqual(\_SB.PC00.TRP3.PDSX, One))
						{
							Store(One, CTP1)
						}
						\_SB.PC00.TRP3.D3CE()
					}
				}
			}
			ADBG("TG1F End")
		}
		If(ITRT)
		{
			Method(TBON, 1, NotSerialized)
			{
				If(ITIM)
				{
					If(LEqual(Arg0, Zero))
					{
						ADBG("TBT0 Group ON Start")
						TG0N()
						ADBG("TBT0 Group ON End")
					}
					Else
					{
						ADBG("TBT1 Group ON Start")
						TG1N()
						ADBG("TBT1 Group ON End")
					}
				}
				Else
				{
					ADBG("TBT IMR is not valid")
				}
			}
			Method(TBOF, 1, NotSerialized)
			{
				If(ITIM)
				{
					If(LEqual(Arg0, Zero))
					{
						ADBG("TBT0 Group OFF Start")
						ADBG(Concatenate("Skip D3C entry? ", ToHexString(\_SB.PC00.TDM0.SD3C)))
						If(LEqual(\_SB.PC00.TDM0.SD3C, Zero))
						{
							TG0F()
						}
						ADBG("TBT0 Group OFF End")
					}
					Else
					{
						ADBG("TBT1 Group OFF Start")
						ADBG(Concatenate("Skip D3C entry? ", ToHexString(\_SB.PC00.TDM1.SD3C)))
						If(LEqual(\_SB.PC00.TDM1.SD3C, Zero))
						{
							TG1F()
						}
						ADBG("TBT1 Group OFF End")
					}
				}
				Else
				{
					ADBG("TBT IMR is not valid")
				}
			}
			PowerResource(TBT0, 0, 1)
			{
				Method(_STA, 0, NotSerialized)
				{
					ADBG(Concatenate("DMA0 D3C STAT -", ToHexString(\_SB.PC00.TDM0.STAT)))
					Return(\_SB.PC00.TDM0.STAT)
				}
				Method(_ON, 0, NotSerialized)
				{
					ADBG("TBT0 _ON")
					If(LEqual(\_SB.PC00.TDM0.SCME, Zero))
					{
						TBON
						Zero
					}
				}
				Method(_OFF, 0, NotSerialized)
				{
					ADBG("TBT0 _OFF")
					If(LEqual(\_SB.PC00.TDM0.SCME, Zero))
					{
						TBOF
						Zero
					}
				}
			}
			PowerResource(TBT1, 0, 1)
			{
				Method(_STA, 0, NotSerialized)
				{
					ADBG(Concatenate("DMA1 D3C STAT -", ToHexString(\_SB.PC00.TDM1.STAT)))
					Return(\_SB.PC00.TDM1.STAT)
				}
				Method(_ON, 0, NotSerialized)
				{
					ADBG("TBT1 _ON")
					If(LEqual(\_SB.PC00.TDM1.SCME, Zero))
					{
						TBON
						One
					}
				}
				Method(_OFF, 0, NotSerialized)
				{
					ADBG("TBT1 _OFF")
					If(LEqual(\_SB.PC00.TDM1.SCME, Zero))
					{
						TBOF
						One
					}
				}
			}
		}
		If(TRTD)
		{
			Method(TCON, 0, NotSerialized)
			{
				ADBG("TCSS ON")
				ADBG("TCON")
				If(LEqual(TD3C, One))
				{
					ADBG(Concatenate("TACK before D3 cold exit -", ToHexString(TACK)))
					Store(Zero, TD3C)
					Store(Zero, Local0)
					While(LAnd(LNotEqual(TACK, Zero), LLess(Local0, 0x64)))
					{
						Sleep(One)
						Increment(Local0)
					}
					ADBG(Concatenate("TACK after D3 cold exit -", ToHexString(TACK)))
					ADBG(Concatenate("Time for wait TACK - ", ToHexString(Local0)))
					If(LEqual(Local0, 0x64))
					{
						ADBG("Error: Timeout occurred")
					}
					Else
					{
						ADBG("D3Cold Exit")
						If(LAnd(LEqual(TDCE, One), LEqual(IMRY, One)))
						{
							ADBG("IOM.D3.TDCE")
							\_SB.PC00.TXDC.SINT
							TCIT
							TCIR
							ADBG("IOM.D3.TDCE Done")
						}
					}
				}
				Else
				{
					ADBG("Drop TCON due to it is already exit D3 cold")
					Return(Zero)
				}
				ADBG("TCSS ON End")
			}
			Method(TCOF, 0, NotSerialized)
			{
				ADBG("TCSS OFF Start")
				ADBG("TCOF")
				ADBG(Concatenate("DMA0 Skip D3C entry? ", ToHexString(\_SB.PC00.TDM0.SD3C)))
				ADBG(Concatenate("DMA1 Skip D3C entry? ", ToHexString(\_SB.PC00.TDM1.SD3C)))
				ADBG(Concatenate("XHCI Skip D3C entry? ", ToHexString(\_SB.PC00.TXHC.SD3C)))
				If(LOr(LNotEqual(\_SB.PC00.TXHC.SD3C, Zero), LOr(LNotEqual(\_SB.PC00.TDM0.SD3C, Zero), LNotEqual(\_SB.PC00.TDM1.SD3C, Zero))))
				{
					Return(Zero)
				}
				ADBG("D3Cold Entry")
				Store(One, TD3C)
				ADBG(Concatenate("IOM D3Cold -", ToHexString(TD3C)))
				ADBG("TCSS OFF End")
			}
			PowerResource(D3C, 0, 0)
			{
				Name(STAT, One)
				Method(_STA, 0, NotSerialized)
				{
					ADBG(Concatenate("TCSS D3C STAT -", ToHexString(STAT)))
					Return(STAT)
				}
				Method(_ON, 0, NotSerialized)
				{
					\_SB.PC00.TCON
					Store(One, STAT)
				}
				Method(_OFF, 0, NotSerialized)
				{
					\_SB.PC00.TCOF
					Store(Zero, STAT)
				}
			}
		}
		Device(TXHC)
		{
			Name(_ADR, 0x000D0000)
			Name(_DDN, "ICL North XHCI controller")
			Name(_STR, Unicode("ICL North XHCI controller")})
			Name(DCPM, 0x04)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS xHCI _STA", ToHexString(THCE)))
				If(LEqual(THCE, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(BASE, 0, NotSerialized)
			{
				Store(And(_ADR, 0x07), Local0)
				Store(And(ShiftRight(_ADR, 0x10), 0x1F), Local1)
				Add(ShiftLeft(Local0, 0x0C), ShiftLeft(Local1, 0x0F), Local2)
				Add(\_SB.PC00.GPCB(), Local2, Local3)
				ADBG(Concatenate("CPU XHCI PCIe MMIO Address", ToHexString(Local3)))
				Return(Local3)
			}
			Method(_PS0, 0, Serialized)
			{
				ADBG("CPU XHCI _PS0 Start")
				If(LEqual(\_SB.PC00.TXHC.PMEE, One))
				{
					ADBG("Clear PME_EN of CPU XHCI")
					Store(Zero, \_SB.PC00.TXHC.PMEE)
				}
				ADBG("CPU XHCI _PS0 End")
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG("CPU XHCI _PS3 Start")
				If(LEqual(\_SB.PC00.TXHC.PMEE, Zero))
				{
					ADBG("PME_EN was not set. Set PME_EN of CPU XHCI")
					Store(One, \_SB.PC00.TXHC.PMEE)
				}
				ADBG("CPU XHCI _PS3 End")
			}
			Method(_S0W, 0, NotSerialized)
			{
				If(TRTD)
				{
					Return(0x04)
				}
				Else
				{
					Return(0x03)
				}
			}
			Name(SD3C, Zero)
			If(TRTD)
			{
				Method(_PR0, 0, NotSerialized)
				{
					Return(Package(1) {\_SB.PC00.D3C})
				}
				Method(_PR3, 0, NotSerialized)
				{
					Return(Package(1) {\_SB.PC00.D3C})
				}
			}
			OperationRegion(XPRT, SystemMemory, BASE, 0x0100)
			Field(XPRT, ByteAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x74),	//Offset(116),
				D0D3, 2,
				, 6,
				PMEE, 1,
				, 6,
				PMES, 1,
			}
			Name(XFLT, Zero)
			Method(_DSM, 4, Serialized)
			{
				ADBG("XHCI _DSM")
				If(PCIC(Arg0))
				{
					Return(PCID)
					Arg0
					Arg1
					Arg2
					Arg3
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Method(_S3D, 0, NotSerialized)
			{
				Return(0x03)
			}
			Method(_S4D, 0, NotSerialized)
			{
				Return(0x03)
			}
			Method(_S3W, 0, NotSerialized)
			{
				Return(0x03)
			}
			Method(_S4W, 0, NotSerialized)
			{
				Return(0x03)
			}
			Method(_PRW, 0, NotSerialized)
			{
				If(CondRefOf(GP1E))
				{
					If(LNotEqual(GP1E, Zero))
					{
						Return(GPRW(0x80, 0x04))
					}
				}
				Return(GPRW(0x6D, 0x04))
			}
			Method(_DSW, 3, NotSerialized)
			{
				ADBG("TCSS XHCI _DSW")
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				ADBG(Concatenate("Arg2 -", ToHexString(Arg2)))
				C2PM(Arg0, Arg1, Arg2, DCPM)
				Store(Arg1, SD3C)
				ADBG(Concatenate("SD3C -", ToHexString(SD3C)))
			}
			Device(RHUB)
			{
				Name(_ADR, Zero)
				Method(_DSM, 4, Serialized)
				{
					ADBG("TCSS XHCI RHUB _DSM")
					If(LEqual(Arg0, ToUUID("CE2EE385-00E648CB-9F052EDB927C4899")}))
					{
						If(LEqual(Arg2, Zero))
						{
							ADBG("TCSS XHCI RHUB F0")
							Return(Buffer(One)
							{
								0x81
							})
						}
						If(LEqual(Arg2, 0x07))
						{
							ADBG("TCSS XHCI RHUB F7")
							Return(Buffer(One)
							{
								0x01
							})
						}
					}
					Return(Buffer(One)
					{
						0x00
					})
				}
				Method(TPLD, 2, Serialized)
				{
					Name(PCKG, Package(1)
					{
						Buffer(0x10){}
					})
					CreateField(DerefOf(Index(PCKG, Zero)),Zero,0x07,REV)
					Store(One, REV)
					CreateField(DerefOf(Index(PCKG, Zero)),0x40,One,VISI)
					Store(Arg0, VISI)
					CreateField(DerefOf(Index(PCKG, Zero)),0x57,0x08,GPOS)
					Store(Arg1, GPOS)
					CreateField(DerefOf(Index(PCKG, Zero)),0x4A,0x04,SHAP)
					Store(One, SHAP)
					CreateField(DerefOf(Index(PCKG, Zero)),0x20,0x10,WID)
					Store(0x08, WID)
					CreateField(DerefOf(Index(PCKG, Zero)),0x30,0x10,HGT)
					Store(0x03, HGT)
					Return(PCKG)
				}
				Method(TUPC, 3, Serialized)
				{
					Name(PCKG, Package(4) {One, Zero, Zero, Zero})
					Store(Arg0, Index(PCKG, Zero))
					Store(Arg1, Index(PCKG, One))
					Store(Arg2, Index(PCKG, 0x02))
					Return(PCKG)
				}
				Device(HS01)
				{
					Name(_ADR, One)
					Method(_UPC, 0, NotSerialized)
					{
						Return(TUPC(Zero, Zero, Zero))
					}
					Method(_PLD, 0, NotSerialized)
					{
						Return(TPLD(Zero, Zero))
					}
				}
				Device(SS01)
				{
					Name(_ADR, 0x02)
					If(CondRefOf(U4CM))
					{
						If(LAnd(LEqual(And(U4CM, 0x07), One), LEqual(DME0, One)))
						{
							ADBG(Concatenate("CTEM -", ToHexString(CTEM)))
							If(LEqual(And(CTEM, One), One))
							{
								Method(_DSD, 0, NotSerialized)
								{
									ADBG("XHC SS01 _DSD")
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
											0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
										}, 
										Package(2)
										{
											Package(2) {"usb4-host-interface", \_SB.PC00.TDM0}, 
											Package(2) {"usb4-port-number", Zero}
										}
									})
								}
							}
						}
					}
					Method(_DSM, 4, NotSerialized)
					{
						ADBG("TCSS XHCI SS01 _DSM")
						If(LEqual(Arg0, ToUUID("CE2EE385-00E648CB-9F052EDB927C4899")}))
						{
							ADBG("TCSS XHCI SS01 GUID")
							If(LEqual(Arg2, Zero))
							{
								ADBG("TCSS XHCI SS01 F0")
								Return(Buffer(One)
								{
									0x21
								})
							}
							If(LEqual(Arg2, 0x05))
							{
								ADBG("TCSS XHCI SS01 F5")
								If(LEqual(Arg1, Zero))
								{
									If(LEqual(And(RTBM, One), One))
									{
										ADBG("XHC SS01 _DSM U1U2 disable")
										Return(One)
									}
									Return(Zero)
								}
							}
						}
						Return(Buffer(One)
						{
							0x00
						})
					}
				}
				Device(SS02)
				{
					Name(_ADR, 0x03)
					If(CondRefOf(U4CM))
					{
						If(LAnd(LEqual(And(U4CM, 0x07), One), LEqual(DME0, One)))
						{
							If(LEqual(And(CTEM, 0x02), 0x02))
							{
								Method(_DSD, 0, NotSerialized)
								{
									ADBG("XHC SS02 _DSD")
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
											0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
										}, 
										Package(2)
										{
											Package(2) {"usb4-host-interface", \_SB.PC00.TDM0}, 
											Package(2) {"usb4-port-number", One}
										}
									})
								}
							}
						}
					}
					Method(_DSM, 4, NotSerialized)
					{
						ADBG("TCSS XHCI SS02 _DSM")
						If(LEqual(Arg0, ToUUID("CE2EE385-00E648CB-9F052EDB927C4899")}))
						{
							ADBG("TCSS XHCI SS02 GUID")
							If(LEqual(Arg2, Zero))
							{
								ADBG("TCSS XHCI SS02 F0")
								Return(Buffer(One)
								{
									0x21
								})
							}
							If(LEqual(Arg2, 0x05))
							{
								ADBG("TCSS XHCI SS02 F5")
								If(LEqual(Arg1, Zero))
								{
									If(LEqual(And(RTBM, 0x02), 0x02))
									{
										ADBG("XHC SS02 _DSM U1U2 disable")
										Return(One)
									}
									Return(Zero)
								}
							}
						}
						Return(Buffer(One)
						{
							0x00
						})
					}
				}
				Device(SS03)
				{
					Name(_ADR, 0x04)
					If(CondRefOf(U4CM))
					{
						If(LAnd(LEqual(And(U4CM, 0x07), One), LEqual(DME1, One)))
						{
							If(LEqual(And(CTEM, 0x04), 0x04))
							{
								Method(_DSD, 0, NotSerialized)
								{
									ADBG("XHC SS03 _DSD")
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
											0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
										}, 
										Package(2)
										{
											Package(2) {"usb4-host-interface", \_SB.PC00.TDM1}, 
											Package(2) {"usb4-port-number", 0x02}
										}
									})
								}
							}
						}
					}
					Method(_DSM, 4, NotSerialized)
					{
						ADBG("TCSS XHCI SS03 _DSM")
						If(LEqual(Arg0, ToUUID("CE2EE385-00E648CB-9F052EDB927C4899")}))
						{
							ADBG("TCSS XHCI SS03 GUID")
							If(LEqual(Arg2, Zero))
							{
								ADBG("TCSS XHCI SS03 F0")
								Return(Buffer(One)
								{
									0x21
								})
							}
							If(LEqual(Arg2, 0x05))
							{
								ADBG("TCSS XHCI SS03 F5")
								If(LEqual(Arg1, Zero))
								{
									If(LEqual(And(RTBM, 0x04), 0x04))
									{
										ADBG("XHC SS03 _DSM U1U2 disable")
										Return(One)
									}
									Return(Zero)
								}
							}
						}
						Return(Buffer(One)
						{
							0x00
						})
					}
				}
				Device(SS04)
				{
					Name(_ADR, 0x05)
					If(CondRefOf(U4CM))
					{
						If(LAnd(LEqual(And(U4CM, 0x07), One), LEqual(DME1, One)))
						{
							If(LEqual(And(CTEM, 0x08), 0x08))
							{
								Method(_DSD, 0, NotSerialized)
								{
									ADBG("XHC SS04 _DSD")
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
											0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
										}, 
										Package(2)
										{
											Package(2) {"usb4-host-interface", \_SB.PC00.TDM1}, 
											Package(2) {"usb4-port-number", 0x03}
										}
									})
								}
							}
						}
					}
					Method(_DSM, 4, NotSerialized)
					{
						ADBG("TCSS XHCI SS04 _DSM")
						If(LEqual(Arg0, ToUUID("CE2EE385-00E648CB-9F052EDB927C4899")}))
						{
							ADBG("TCSS XHCI SS04 GUID")
							If(LEqual(Arg2, Zero))
							{
								ADBG("TCSS XHCI SS04 F0")
								Return(Buffer(One)
								{
									0x21
								})
							}
							If(LEqual(Arg2, 0x05))
							{
								ADBG("TCSS XHCI SS04 F5")
								If(LEqual(Arg1, Zero))
								{
									If(LEqual(And(RTBM, 0x08), 0x08))
									{
										ADBG("XHC SS04 _DSM U1U2 disable")
										Return(One)
									}
									Return(Zero)
								}
							}
						}
						Return(Buffer(One)
						{
							0x00
						})
					}
				}
				Method(_PS0, 0, Serialized)
				{
					ADBG("TCSS RHUB XHCI PS0")
				}
				Method(_PS2, 0, Serialized)
				{
					ADBG("TCSS RHUB XHCI PS2")
				}
				Method(_PS3, 0, Serialized)
				{
					ADBG("TCSS RHUB XHCI PS3")
				}
			}
		}
		If(LEqual(TDCE, One))
		{
			Device(TXDC)
			{
				Name(_ADR, 0x000D0001)
				Name(_DDN, "ICL North XDCI controller")
				Name(_STR, Unicode("ICL North XDCI controller")})
				Name(DCPM, 0x05)
				Method(_STA, 0, NotSerialized)
				{
					ADBG(Concatenate("TCSS xDCI _STA", ToHexString(TDCE)))
					If(LEqual(TDCE, One))
					{
						Return(0x0F)
					}
					Return(Zero)
				}
				Method(SINT, 2, Serialized)
				{
					ADBG("xDCI.SINT")
					If(LEqual(IMRY, One))
					{
						ShiftLeft(Arg0, 0x08, Local0)
						ShiftLeft(Arg1, 0x14, Local1)
						Add(Local0, Local1, Local0)
						ADBG(Concatenate("TCSS xDCI SINT", ToHexString(Local0)))
						IMMC(0x02, Zero, One, Zero, Local0)
					}
					Else
					{
						ADBG("IOM not ready")
					}
					ADBG("xDCI.SINT Done")
				}
				Method(_S0W, 0, NotSerialized)
				{
					Return(0x03)
				}
				OperationRegion(XDCS, PCI_Config, Zero, 0x0100)
				Field(XDCS, DWordAcc, NoLock, Preserve)
				{
					DVID, 16,
					Offset(0x10),	//Offset(16),
					XDCB, 64,
				}
				Field(XDCS, ByteAcc, NoLock, Preserve)
				{
					Offset(0x84),	//Offset(132),
					D0I3, 2,
				}
				Method(XDBA, 0, NotSerialized)
				{
					Return(And(^XDCB, 0x00FFFFFFFFFFFFFF))
				}
				OperationRegion(XDMM, SystemMemory, XDBA, 0x00110000)
				Field(XDMM, WordAcc, NoLock, Preserve)
				{
					Offset(0xC110),	//Offset(49424),
					GCTL, 32,
					Offset(0x10F810),	//Offset(1112080),
					, 8,
					U2CP, 2,
					U3CP, 2,
					Offset(0x10F818),	//Offset(1112088),
					PUPS, 2,
					, 1,
					PURC, 1,
					Offset(0x10F81A),	//Offset(1112090),
					Offset(0x10F81C),	//Offset(1112092),
					, 3,
					UXPE, 2,
					Offset(0x10F81E),	//Offset(1112094),
				}
				Method(_DSM, 4, Serialized)
				{
					Name(_T_0, Zero)
					If(PCIC(Arg0))
					{
						Return(PCID)
						Arg0
						Arg1
						Arg2
						Arg3
					}
					ADBG("TXDC DSM")
					If(LEqual(Arg0, ToUUID("732B85D5-B7A74A1B-9BA04BBD00FFD511")}))
					{
						If(LEqual(Arg1, One))
						{
							Method(SPPT, 2, Serialized)
							{
								ADBG("TXDC Set PMU Power State")
								Store(Arg0, Local1)
								Store(Arg1, Local2)
								If(LEqual(Local1, Zero))
								{
									ADBG("TXDC PMU D0")
									Store(Zero, UXPE)
									Store(Zero, Local0)
									While(LLess(Local0, 0x0A))
									{
										Stall(0x64)
										Increment(Local0)
									}
									Store(Zero, PUPS)
									Store(Zero, Local0)
									While(LLess(Local0, 0x07D0))
									{
										Stall(0x64)
										If(LAnd(LEqual(U2CP, Zero), LEqual(U3CP, Zero)))
										{
											Break
										}
										Increment(Local0)
									}
									If(LNotEqual(U2CP, Zero))
									{
										ADBG("TXDC U2 not in D0")
									}
									If(LNotEqual(U3CP, Zero))
									{
										ADBG("TXDC U3 not in D0")
									}
									Return(Zero)
								}
								If(LEqual(Local1, 0x03))
								{
									ADBG("TXDC PMU D3")
									If(LNotEqual(U2CP, Zero))
									{
										ADBG("TXDC U2 not in D0")
									}
									If(LNotEqual(U3CP, Zero))
									{
										ADBG("TXDC U3 not in D0")
									}
									Store(0x03, PUPS)
									Store(Zero, Local0)
									While(LLess(Local0, 0x07D0))
									{
										Stall(0x64)
										If(LAnd(LEqual(U2CP, 0x03), LEqual(U3CP, 0x03)))
										{
											Break
										}
										Increment(Local0)
									}
									If(LNotEqual(U2CP, 0x03))
									{
										ADBG("TXDC U2 not in D3")
									}
									If(LNotEqual(U3CP, 0x03))
									{
										ADBG("TXDC U3 not in D3")
									}
									Store(Local2, UXPE)
									Return(Zero)
								}
								Return(Zero)
							}
							While(One)
							{
								Store(ToInteger(Arg2), _T_0)
								If(LEqual(_T_0, Zero))
								{
									ADBG("TXDC Fn0")
									Return(Buffer(0x02)
									{
										0xF3, 0x03
									})
								}
								Else
								{
									If(LEqual(_T_0, One))
									{
										ADBG("TXDC Fn1")
										Return(One)
									}
									Else
									{
										If(LEqual(_T_0, 0x04))
										{
											ADBG("TXDC Fn4")
											Store(DerefOf(Index(Arg3, Zero)), Local1)
											ADBG(Local1)
											SPPT
											Local1
											Zero
										}
										Else
										{
											If(LEqual(_T_0, 0x05))
											{
												ADBG("TXDC Fn5")
												If(CondRefOf(XDAT))
												{
													If(LEqual(XDAT, One))
													{
														ADBG("USB Attach")
														Notify(\_SB.PC00.TXDC, 0x80)
													}
													Else
													{
														ADBG("USB Detach")
														Notify(\_SB.PC00.TXDC, 0x81)
													}
												}
												Return(Zero)
											}
											Else
											{
												If(LEqual(_T_0, 0x06))
												{
													ADBG("TXDC Fn6")
													If(LEqual(OTHC, Zero))
													{
														Store(One, CSFR)
														Store(Zero, Local0)
														While(LLess(Local0, 0x64))
														{
															If(LEqual(CSFR, Zero))
															{
																Break
															}
															Sleep(One)
														}
													}
													Return(Zero)
												}
												Else
												{
													If(LEqual(_T_0, 0x07))
													{
														ADBG("TXDC Fn7")
														Store(PUPS, Local0)
														Return(Local0)
													}
													Else
													{
														If(LEqual(_T_0, 0x08))
														{
															ADBG("TXDC Fn8")
															Return(One)
														}
														Else
														{
															If(LEqual(_T_0, 0x09))
															{
																ADBG("TXDC Fn9")
																And(TCDS, 0xFFF80000, Local1)
																ShiftRight(Local1, 0x13, Local1)
																ADBG(Concatenate("CPU XDCI: Func9 Return Val = ", ToHexString(Local1)))
																Return(Local1)
															}
														}
													}
												}
											}
										}
									}
								}
								Break
							}
						}
					}
					Return(Buffer(One)
					{
						0x00
					})
				}
				Method(_PRW, 0, NotSerialized)
				{
					If(CondRefOf(GP1E))
					{
						If(LNotEqual(GP1E, Zero))
						{
							Return(GPRW(0x80, 0x04))
						}
					}
					Return(GPRW(0x6D, 0x04))
				}
				Method(_DSW, 3, NotSerialized)
				{
					C2PM(Arg0, Arg1, Arg2, DCPM)
				}
			}
		}
		Device(TDM0)
		{
			Name(_ADR, 0x000D0002)
			Name(_DDN, "ICL TBT DMA0 controller")
			Name(_STR, Unicode("ICL TBT DMA0 controller")})
			Name(DUID, Zero)
			Name(DCPM, 0x06)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS DMA0 _STA", ToHexString(DME0)))
				If(LEqual(DME0, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(BASE, 0, NotSerialized)
			{
				Add(\_SB.PC00.GPCB(), 0x0006A000, Local0)
				ADBG(Concatenate("TDM0 MMIO Address", ToHexString(Local0)))
				Return(Local0)
			}
			OperationRegion(DPME, SystemMemory, BASE, 0x0100)
			Field(DPME, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x84),	//Offset(132),
				PMST, 2,
				, 6,
				PMEE, 1,
				, 6,
				PMES, 1,
				Offset(0xFC),	//Offset(252),
				DD3E, 1,
				DFPE, 1,
				Offset(0xFF),	//Offset(255),
				DMAD, 8,
			}
			Name(STAT, One)
			Name(ALCT, Zero)
			Name(WACT, Zero)
			Name(SCME, Zero)
			Method(_PS0, 0, Serialized)
			{
				ADBG(Concatenate("TBT DMA PS0 Start, DUID -", ToHexString(DUID)))
				ADBG(Concatenate("DMA VDID -", ToHexString(VDID)))
				ADBG(Concatenate("PMST -", ToHexString(PMST)))
				ADBG(Concatenate("PMEE -", ToHexString(PMEE)))
				ADBG(Concatenate("PMES -", ToHexString(PMES)))
				ADBG(Concatenate("SCME -", ToHexString(SCME)))
				If(LEqual(SCME, One))
				{
					TBON
					DUID
				}
				Else
				{
					If(LEqual(WACT, One))
					{
						Store(0x02, WACT)
						WFCC(ITCT)
						Store(Zero, WACT)
					}
					Else
					{
						If(LEqual(WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				ADBG(Concatenate("TBT DMA PS0 End, DUID -", ToHexString(DUID)))
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG(Concatenate("TBT DMA PS3 Start, DUID -", ToHexString(DUID)))
				ADBG(Concatenate("DMA VDID -", ToHexString(VDID)))
				ADBG(Concatenate("PMST -", ToHexString(PMST)))
				ADBG(Concatenate("PMEE -", ToHexString(PMEE)))
				ADBG(Concatenate("PMES -", ToHexString(PMES)))
				ADBG(Concatenate("SCME -", ToHexString(SCME)))
				If(LEqual(SCME, One))
				{
					TBOF
					DUID
				}
				ADBG(Concatenate("TBT DMA PS3 End, DUID -", ToHexString(DUID)))
			}
			Method(_S0W, 0, NotSerialized)
			{
				ADBG("TDMA S0W")
				If(ITRT)
				{
					Return(0x04)
				}
				Else
				{
					Return(0x03)
				}
			}
			If(ITRT)
			{
				Method(_PR0, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(SCME)
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LEqual(DUID, Zero))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LEqual(DUID, Zero))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
				Method(_PR3, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(SCME)
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LEqual(DUID, Zero))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LEqual(DUID, Zero))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
			}
			Method(D3CX, 0, Serialized)
			{
				ADBG("Disable DMA RTD3 bit")
				ADBG(Concatenate("DUID -", ToHexString(DUID)))
				Store(Zero, DD3E)
				Store(One, STAT)
			}
			Method(D3CE, 0, Serialized)
			{
				ADBG("Enable DMA RTD3 bit")
				ADBG(Concatenate("DUID -", ToHexString(DUID)))
				Store(One, DD3E)
				Store(Zero, STAT)
				If(LEqual(SCME, Zero))
				{
					Store(One, ALCT)
				}
			}
			Name(SD3C, Zero)
			Method(_DSW, 3, NotSerialized)
			{
				ADBG(Concatenate("TCSS DMA _DSW DUID -", ToHexString(DUID)))
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				Store(Arg1, SD3C)
				ADBG(Concatenate("SD3C -", ToHexString(SD3C)))
			}
			Method(_PRW, 0, NotSerialized)
			{
				Return(GPRW(0x6D, Zero))
			}
			Method(_DSD, 0, NotSerialized)
			{
				ADBG(Concatenate("TBT _DSD IMR_VALID =", ToHexString(ITIM)))
				ADBG(Concatenate("TBT _DSD WAKE_SUPPORTED =", ToHexString(TIVS)))
				If(ITIM)
				{
					If(TIVS)
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", One}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", One}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", One}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", Zero}
							}
						})
					}
				}
				Else
				{
					If(TIVS)
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", Zero}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", One}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
