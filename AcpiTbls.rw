										If(LEqual(_T_2, One))
										{
											ADBG("THC THC_CONNECTION_SPEED")
											Return(ToInteger(T030))
										}
										Else
										{
											If(LEqual(_T_2, 0x02))
											{
												ADBG("THC THC_LIMIT_PACKET_SIZE")
												Return(ToInteger(T0C0))
											}
											Else
											{
												If(LEqual(_T_2, 0x03))
												{
													ADBG("THC THC_PERFORMANCE_LIMITATION")
													Return(ToInteger(T0D0))
												}
												Else
												{
													Return(Buffer(One)
													{
														0x00
													})
												}
											}
										}
									}
									Break
								}
							}
						}
						If(LEqual(Arg0, ToUUID("84005682-5B7141A4-8D668130F787A138")}))
						{
							While(One)
							{
								Store(ToInteger(Arg2), _T_3)
								If(LEqual(_T_3, Zero))
								{
									Return(Buffer(One)
									{
										0x03
									})
								}
								Else
								{
									If(LEqual(_T_3, One))
									{
										ADBG("THC THC_ACTIVE_LTR")
										Return(ToInteger(T0A0))
									}
									Else
									{
										If(LEqual(_T_3, 0x02))
										{
											ADBG("THC THC_IDLE_LTR")
											Return(ToInteger(T0B0))
										}
										Else
										{
											Return(Buffer(One)
											{
												0x00
											})
										}
									}
								}
								Break
							}
						}
						If(LEqual(Arg0, ToUUID("9B1E77C4-53DB43BD-A276F7287604D1BD")}))
						{
							While(One)
							{
								Store(ToInteger(Arg2), _T_4)
								If(LEqual(_T_4, Zero))
								{
									Return(Buffer(One)
									{
										0x01
									})
								}
								Else
								{
									If(LEqual(_T_4, One))
									{
										ADBG("THC THC_DISPLAY_FRAME_SYNC_PERIOD")
										Return(ToInteger(T0E0))
									}
									Else
									{
										Return(Buffer(One)
										{
											0x00
										})
