						RSPT
						RSPI
						RLA
						Sleep(0x64)
						Store(Zero, ID3C)
					}
					Method(VPOF, 0, Serialized)
					{
						ADBG(Concatenate("VPOFs: ", ToHexString(_ADR)))
						If(LNot(D3CV))
						{
							RSPT
							RSPI
							Return(Zero)
						}
						RL23
						VDOF
						RSPT
						RSPI
						Store(One, ID3C)
					}
					Method(RL23, 0, Serialized)
					{
						Name(DCFB, Zero)
						Store(CBAR, RPB)
						RPD
						RPF
						DCFB
						OperationRegion(DCFG, SystemMemory, DCFB, 0x0C80)
						Field(DCFG, DWordAcc, NoLock, Preserve)
						{
							VDID, 32,
							Offset(0x50),	//Offset(80),
							L0SE, 1,
							, 3,
							LDIS, 1,
							, 3,
							, 8,
							Offset(0x53),	//Offset(83),
							, 5,
							LASX, 1,
							Offset(0x68),	//Offset(104),
							Offset(0x69),	//Offset(105),
							, 2,
							LNRE, 1,
							Offset(0xE0),	//Offset(224),
							SCB0, 1,
							Offset(0xE2),	//Offset(226),
							, 2,
							L23E, 1,
							Offset(0x328),	//Offset(808),
							Offset(0x32B),	//Offset(811),
							LTSM, 8,
							Offset(0x404),	//Offset(1028),
							LSOE, 1,
							LNSE, 1,
						}
						ADBG(Concatenate("VMD PCIe RP LTSSM at RL23 Start -", ToHexString(LTSM)))
						If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
						{
							If(LOr(LEqual(LSOE, One), LEqual(LNSE, One)))
							{
								Store(One, LNRE)
								Sleep(One)
								Store(Zero, LNRE)
								ADBG("Toggle LNRE")
							}
						}
						Store(One, L23E)
						Sleep(0x10)
						Store(Zero, Local0)
						While(L23E)
						{
							If(LGreater(Local0, 0x04))
							{
								ADBG(Concatenate("VMD POF L23E TO", ToHexString(_ADR)))
								Break
							}
							Sleep(0x10)
							Increment(Local0)
						}
						Store(One, SCB0)
						ADBG(Concatenate("VMD PCIe RP LTSSM at RL23 End -", ToHexString(LTSM)))
					}
					Method(RLA, 0, Serialized)
					{
						Name(DCFB, Zero)
						Store(CBAR, RPB)
						RPD
						RPF
						DCFB
						OperationRegion(DCFG, SystemMemory, DCFB, 0x0C80)
						Field(DCFG, DWordAcc, NoLock, Preserve)
						{
							VDID, 32,
							Offset(0x52),	//Offset(82),
							Offset(0x53),	//Offset(83),
							, 5,
							LASX, 1,
							Offset(0xE0),	//Offset(224),
							SCB0, 1,
							Offset(0xE2),	//Offset(226),
							, 3,
							L23R, 1,
							Offset(0x328),	//Offset(808),
							Offset(0x32B),	//Offset(811),
							LTSM, 8,
							Offset(0x420),	//Offset(1056),
							Offset(0x423),	//Offset(1059),
							, 6,
							DPGE, 1,
						}
						ADBG(Concatenate("VMD PCIe RP LTSSM at RLA Start  -", ToHexString(LTSM)))
						If(LNotEqual(SCB0, One))
						{
							ADBG(Concatenate("VMD PON- Sticky bit is not set to 1 to: ", ToHexString(_ADR)))
							Return(Zero)
						}
						Store(One, L23R)
						Store(Zero, Local0)
						While(L23R)
						{
							If(LGreater(Local0, 0x04))
							{
								ADBG(Concatenate("VMD PCIE L23R TO ", ToHexString(_ADR)))
								Break
							}
							Sleep(0x10)
							Increment(Local0)
						}
						Store(Zero, SCB0)
						Store(Zero, Local0)
						While(LEqual(LASX, Zero))
						{
							If(LGreater(Local0, 0x08))
							{
								ADBG(Concatenate("VMD PCIE LASX TO ", ToHexString(_ADR)))
								Break
							}
							Sleep(0x10)
							Increment(Local0)
						}
						ADBG(Concatenate("VMD PCIe RP LTSSM at L23D End -", ToHexString(LTSM)))
