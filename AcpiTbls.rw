				{
					WKBC(SA00, SA01, SA02, SA03)
				}
				If(LEqual(SAC1, 0x0100))
				{
					RKBC(SA00, SA01)
				}
				If(LEqual(SAC1, 0x0200))
				{
					SCMD(SA00)
					Return(SAC0)
				}
				If(LEqual(SAC1, 0x0300))
				{
					If(LEqual(IGPM, One))
					{
						If(LEqual(SA00, One))
						{
							Return(^^PC00.LPCB.EC0.IGPS(One))
						}
						Else
						{
							If(LEqual(SA00, Zero))
							{
								Return(^^PC00.LPCB.EC0.IGPS(Zero))
							}
							Else
							{
								If(LEqual(SA00, 0x02))
								{
									Return(^^PC00.LPCB.EC0.DGPS())
								}
								Else
								{
									If(LEqual(SA00, 0x03))
									{
										Return(0x55)
									}
								}
							}
						}
					}
				}
				If(LEqual(SAC1, 0x0400))
				{
					Return(MTJM)
				}
				If(LEqual(SAC1, 0x0500))
				{
					If(LEqual(SA00, One))
					{
						^^INOU.CTAF(Zero)
						Return(0xAA)
					}
					Else
					{
						If(LEqual(SA00, 0x02))
						{
							^^INOU.CTAF(One)
							Return(0xBB)
						}
						Else
						{
							If(LEqual(SA00, 0x03))
							{
								Return(0x55)
							}
							Else
							{
								If(LEqual(SA00, 0x08))
								{
									Return(0x55)
								}
								Else
								{
									If(LOr(LOr(LEqual(SA00, 0x09), LEqual(SA00, 0x0A)), LEqual(SA00, 0x0C)))
									{
										^^PC00.LPCB.EC0.PMSF()
									}
									Else
									{
										If(LEqual(SA00, 0x0D))
										{
											^^PGPI.SGOV
											0x0016108C
											Zero
										}
										Else
										{
											If(LEqual(SA00, 0x0E))
											{
												^^PGPI.SGOV
												0x0016108C
												One
											}
											Else
											{
												If(LEqual(SA00, 0x10))
												{
													Store(Zero, FMFG)
