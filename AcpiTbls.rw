				Name(FDEL, Zero)
				Name(PDEL, Zero)
				Name(VDEL, Zero)
				Method(IFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(One)
							{
								0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
