				Store(Add(SBRG, 0x00D10000), CMH0)
				CreateDWordField(RBPS, 0x19, CMH1)
				Store(Add(SBRG, 0x00D20000), CMH1)
				CreateDWordField(RBPS, 0x25, CMH3)
				Store(Add(SBRG, 0x00D30000), CMH3)
				If(LNotEqual(PCHS, 0x04))
				{
					Name(RBFS, ResourceTemplate()
					{
						Memory32Fixed(ReadWrite, 0x00000000, 0x00010000)
						Memory32Fixed(ReadWrite, 0x00000000, 0x00010000)
					})
					CreateDWordField(RBFS, 0x04, CMH4)
					Store(Add(SBRG, 0x00D40000), CMH4)
					CreateDWordField(RBFS, 0x10, CMH5)
					Store(Add(SBRG, 0x00D50000), CMH5)
					ConcatenateResTemplate(RBPS, RBFS, Local0)
					Return(Local0)
				}
				Return(RBPS)
			}
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(GPHD, One))
				{
					Return(0x08)
				}
				Return(0x0F)
			}
		}
	}
