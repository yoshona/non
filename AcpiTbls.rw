		Method(CTOK, 1, Serialized)
		{
			Return(Add(Multiply(Arg0, 0x0A), 0x0AAC))
		}
		Method(C10K, 1, Serialized)
		{
			Name(TMP1, Buffer(0x10)
			{
				0x00
			})
			CreateByteField(TMP1,Zero,TMPL)
			CreateByteField(TMP1,One,TMPH)
			Add(Arg0, 0x0AAC, Local0)
			Store(And(Local0, 0xFF), TMPL)
			Store(ShiftRight(And(Local0, 0xFF00), 0x08), TMPH)
			ToInteger(TMP1, Local1)
			Return(Local1)
		}
		Method(K10C, 1, Serialized)
		{
			If(LGreater(Arg0, 0x0AAC))
			{
				Return(Subtract(Arg0, 0x0AAC))
			}
			Else
			{
				Return(Zero)
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(TFN1)
		{
			Name(_UID, "TFN1")
			Method(_HID, 0, NotSerialized)
			{
				Return(\_SB.PLDT.GHID(_UID))
			}
			Name(_STR, Unicode("Fan 1")})
			Name(PTYP, 0x04)
			Name(FON, One)
			Name(PFLG, Zero)
			Name(FSLV, Zero)
			Name(FNID, Zero)
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(FND1, One))
				{
					Return(0x0F)
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(_FIF, 0, NotSerialized)
			{
				Return(Package(4) {Zero, One, 0x02, Zero})
			}
			Method(_FPS, 0, NotSerialized)
			{
				Return(\_SB.PLDT.FPST(FNID))
			}
			Method(_FSL, 1, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.FNSL))
				{
					If(LNotEqual(Arg0, FSLV))
					{
						\_SB.PC00.LPCB.H_EC.DPTF.FNSL
						FNID
						Arg0
						FSLV
						Store(Arg0, FSLV)
					}
					Else
					{
						ADBG("_FSL: New Fan Level is the same as previous level. Ignoring. No action taken")
					}
				}
				Else
				{
					ADBG("_FSL: FNSL not available")
				}
			}
			Name(TFST, Package(3) {Zero, 0xFFFFFFFF, 0xFFFFFFFF})
			Method(_FST, 0, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.GFNS))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.GFNS, FNID)
					Local0
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Store(FSLV, Index(TFST, One))
						Store(Local0, Index(TFST, 0x02))
					}
					Else
					{
						ADBG("_FST: EC not available")
					}
				}
				Else
				{
					ADBG("_FST: GFNS not available")
				}
				Return(TFST)
			}
			If(LEqual(FNSH, One))
			{
				Method(GFST, 0, Serialized)
				{
					Return(\_SB.PC00.LPCB.H_EC.DPTF.GFTE)
				}
				Method(SFST, 2, Serialized)
				{
					\_SB.PC00.LPCB.H_EC.DPTF.SFTE
					Arg0
					Arg1
				}
				Method(GFCS, 0, Serialized)
				{
					Return(\_SB.PC00.LPCB.H_EC.DPTF.GFCE)
				}
				Method(GFOM, 0, Serialized)
				{
					Return(\_SB.PC00.LPCB.H_EC.DPTF.GFME)
				}
				Method(SFOM, 1, Serialized)
				{
					\_SB.PC00.LPCB.H_EC.DPTF.SFME
					Arg0
				}
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(TFN2)
		{
			Name(_UID, "TFN2")
			Method(_HID, 0, NotSerialized)
			{
				Return(\_SB.PLDT.GHID(_UID))
			}
			Name(_STR, Unicode("DDR Fan")})
			Name(PTYP, 0x04)
			Name(FON, One)
			Name(PFLG, Zero)
			Name(FSLV, Zero)
			Name(FNID, One)
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(FND2, One))
				{
					Return(0x0F)
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(_FIF, 0, NotSerialized)
			{
				Return(Package(4) {Zero, One, 0x02, Zero})
			}
			Method(_FPS, 0, NotSerialized)
			{
				Return(\_SB.PLDT.FPST(FNID))
			}
			Method(_FSL, 1, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.FNSL))
				{
					If(LNotEqual(Arg0, FSLV))
					{
						\_SB.PC00.LPCB.H_EC.DPTF.FNSL
						FNID
						Arg0
						FSLV
						Store(Arg0, FSLV)
					}
					Else
					{
						ADBG("_FSL: New Fan Level is the same as previous level. Ignoring. No action taken")
					}
				}
				Else
				{
					ADBG("_FSL: FNSL not available")
				}
			}
			Name(TFST, Package(3) {Zero, 0xFFFFFFFF, 0xFFFFFFFF})
			Method(_FST, 0, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.GFNS))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.GFNS, FNID)
					Local0
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Store(FSLV, Index(TFST, One))
						Store(Local0, Index(TFST, 0x02))
					}
					Else
					{
						ADBG("_FST: EC not available")
					}
				}
				Else
				{
					ADBG("_FST: GFNS not available")
				}
				Return(TFST)
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(CHRG)
		{
			Name(_UID, "CHRG")
			Method(_HID, 0, NotSerialized)
			{
				Return(\_SB.PLDT.GHID(_UID))
			}
			Name(_STR, Unicode("Charger")})
			Name(PTYP, 0x0B)
			Name(PFLG, Zero)
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(\_SB.CHGE, One))
				{
					Return(0x0F)
				}
				Else
				{
					Return(Zero)
				}
			}
			Name(PSSS, Zero)
			Name(PPPS, Zero)
			Name(PPS1, Package(8)
			{
				Package(8) {0x64, Zero, Zero, Zero, Zero, 0x0DAC, "MilliAmps", Zero}, 
				Package(8) {0x55, Zero, Zero, Zero, One, 0x0BB8, "MilliAmps", Zero}, 
				Package(8) {0x47, Zero, Zero, Zero, 0x02, 0x09C4, "MilliAmps", Zero}, 
				Package(8) {0x39, Zero, Zero, Zero, 0x03, 0x07D0, "MilliAmps", Zero}, 
				Package(8) {0x2A, Zero, Zero, Zero, 0x04, 0x05DC, "MilliAmps", Zero}, 
				Package(8) {0x1C, Zero, Zero, Zero, 0x05, 0x03E8, "MilliAmps", Zero}, 
				Package(8) {0x0E, Zero, Zero, Zero, 0x06, 0x01F4, "MilliAmps", Zero}, 
				Package(8) {Zero, Zero, Zero, Zero, 0x07, Zero, "MilliAmps", Zero}
			})
			Name(PPS2, Package(10)
			{
				Package(8) {0x64, Zero, Zero, Zero, Zero, 0x1194, "MilliAmps", Zero}, 
				Package(8) {0x58, Zero, Zero, Zero, One, 0x0FA0, "MilliAmps", Zero}, 
				Package(8) {0x4D, Zero, Zero, Zero, 0x02, 0x0DAC, "MilliAmps", Zero}, 
				Package(8) {0x42, Zero, Zero, Zero, 0x03, 0x0BB8, "MilliAmps", Zero}, 
				Package(8) {0x37, Zero, Zero, Zero, 0x04, 0x09C4, "MilliAmps", Zero}, 
				Package(8) {0x2C, Zero, Zero, Zero, 0x05, 0x07D0, "MilliAmps", Zero}, 
				Package(8) {0x21, Zero, Zero, Zero, 0x06, 0x05DC, "MilliAmps", Zero}, 
				Package(8) {0x16, Zero, Zero, Zero, 0x07, 0x03E8, "MilliAmps", Zero}, 
				Package(8) {0x0B, Zero, Zero, Zero, 0x08, 0x01F4, "MilliAmps", Zero}, 
				Package(8) {Zero, Zero, Zero, Zero, 0x09, Zero, "MilliAmps", Zero}
			})
			Name(PPS3, Package(4)
			{
				Package(8) {Zero, Zero, Zero, Zero, Zero, 0x3A98, "MilliVoltage", Zero}, 
				Package(8) {Zero, Zero, Zero, Zero, One, 0x2EE0, "MilliVoltage", Zero}, 
				Package(8) {Zero, Zero, Zero, Zero, 0x02, Zero, "", Zero}, 
				Package(8) {Zero, Zero, Zero, Zero, 0x03, Zero, "", Zero}
			})
			Method(PPSS, 0, Serialized)
			{
				ADBG("DTT calls PPSS")
				If(LAnd(LEqual(ODV0, One), LEqual(ODV1, One)))
				{
					ADBG("PPSS: selecting PPS")
					Return(PPS3)
				}
				Else
				{
					If(LAnd(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.FCHG), LEqual(\_SB.PC00.LPCB.H_EC.DPTF.FCHG, One)))
					{
						ADBG("PPSS: selecting FCHG")
						Return(PPS2)
					}
					Else
					{
						ADBG("PPSS: FCHG and PPS are not available")
						Return(PPS1)
					}
				}
			}
			Method(PCAL, 0, Serialized)
			{
				ADBG("PCAL!")
				If(LAnd(LEqual(ODV0, One), LEqual(ODV1, One)))
				{
					ADBG("Save PPS package size to PSSS!")
					Store(SizeOf(PPS3), PSSS)
				}
				Else
				{
					If(LAnd(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.FCHG), LEqual(\_SB.PC00.LPCB.H_EC.DPTF.FCHG, One)))
					{
						Store(SizeOf(PPS2), PSSS)
					}
					Else
					{
						ADBG("PCAL: FCHG not available")
						Store(SizeOf(PPS1), PSSS)
					}
				}
			}
			Method(PPPC, 0, NotSerialized)
			{
				ADBG("PPPC return the present p-state!")
				Return(PPPS)
			}
			Method(SPPC, 1, Serialized)
			{
				ADBG("SPPC to transfer the selected power package!")
				ADBG(Concatenate("Package Index: ", ToHexString(Arg0)))
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.SCHG))
				{
					PCAL()
					If(LLessEqual(ToInteger(Arg0), Subtract(PSSS, One)))
					{
						If(LAnd(LEqual(ODV0, One), LEqual(ODV1, One)))
						{
							Store(DerefOf(Index(DerefOf(Index(PPS3, Arg0)), 0x04)), Local1)
							ADBG(Concatenate("PPS p-state value:", ToHexString(Local1)))
							Store(Local1, PPPS)
							If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.UPPM))
							{
								ADBG(Concatenate("PPS sets P-state: ", ToHexString(Local1)))
								\_SB.PC00.LPCB.H_EC.DPTF.UPPM
								Local1
							}
						}
						Else
						{
							If(LAnd(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.FCHG), LEqual(\_SB.PC00.LPCB.H_EC.DPTF.FCHG, One)))
							{
								Store(DerefOf(Index(DerefOf(Index(PPS2, Arg0)), 0x05)), Local1)
								Store(DerefOf(Index(DerefOf(Index(PPS2, Arg0)), 0x04)), PPPS)
								\_SB.PC00.LPCB.H_EC.DPTF.SCHG
								Local1
							}
							Else
							{
								Store(DerefOf(Index(DerefOf(Index(PPS1, Arg0)), 0x05)), Local1)
								Store(DerefOf(Index(DerefOf(Index(PPS1, Arg0)), 0x04)), PPPS)
								\_SB.PC00.LPCB.H_EC.DPTF.SCHG
								Local1
							}
						}
					}
					Return(Zero)
				}
				ADBG("SPPC: SCHG not available")
			}
			Method(PPDL, 0, NotSerialized)
			{
				ADBG("DTT calls PPDL")
				PCAL()
				Return(Subtract(PSSS, One))
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(TPWR)
		{
			Name(_UID, "TPWR")
			Method(_HID, 0, NotSerialized)
			{
				Return(\_SB.PLDT.GHID(_UID))
			}
			Name(_STR, Unicode("Platform Power")})
			Name(PTYP, 0x11)
			Name(PFLG, Zero)
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(\_SB.PWRE, One))
				{
					Return(0x0F)
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(PSOC, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.B1FC))
				{
					If(LEqual(\_SB.PC00.LPCB.H_EC.DPTF.B1FC, 0xFFFFFFFF))
					{
						ADBG("EC is not available")
						Return(Zero)
					}
					Else
					{
						If(LEqual(\_SB.PC00.LPCB.H_EC.DPTF.B1FC, Zero))
						{
							ADBG("Battery malfunction B1FC")
							Return(Zero)
						}
					}
				}
				If(And(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.B1FC), LEqual(\_SB.PC00.LPCB.H_EC.DPTF.B1FC, Zero)))
				{
					ADBG("Battery malfunction B1FC")
					Return(Zero)
				}
				If(LNot(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.B1RC)))
				{
					ADBG("B1RC not available")
					Return(Zero)
				}
				If(LGreater(\_SB.PC00.LPCB.H_EC.DPTF.B1RC, \_SB.PC00.LPCB.H_EC.DPTF.B1FC))
				{
					ADBG("Battery malfunction RC greater than FC")
					Return(Zero)
				}
				If(LEqual(\_SB.PC00.LPCB.H_EC.DPTF.B1RC, \_SB.PC00.LPCB.H_EC.DPTF.B1FC))
				{
					ADBG("Battery Fully Charged")
					Return(0x64)
				}
				If(LLess(\_SB.PC00.LPCB.H_EC.DPTF.B1RC, \_SB.PC00.LPCB.H_EC.DPTF.B1FC))
				{
					Multiply(\_SB.PC00.LPCB.H_EC.DPTF.B1RC, 0x64, Local0)
					Divide(Local0, \_SB.PC00.LPCB.H_EC.DPTF.B1FC, Local2, Local1)
					Divide(Local2, 0x64, , Local2)
					Divide(\_SB.PC00.LPCB.H_EC.DPTF.B1FC, 0xC8, , Local3)
					If(LGreaterEqual(Local2, Local3))
					{
						Add(Local1, One, Local1)
					}
					ADBG(Concatenate("Battery Current Charge: ", ToDecimalString(Local1)))
					Return(Local1)
				}
				Else
				{
					ADBG("PSOC illegal condition")
					Return(Zero)
				}
			}
			Method(PSRC, 0, Serialized)
			{
				Name(_T_0, Zero)
				ADBG("PSRC")
				If(And(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.PWRT), LEqual(\_SB.PC00.LPCB.H_EC.DPTF.PWRT, 0xFFFFFFFF)))
				{
					ADBG("EC is not available")
					Return(Zero)
				}
				Else
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.PWRT, Local0)
					And(Local0, 0xF0, Local1)
				}
				While(One)
				{
					Store(ToInteger(And(ToInteger(Local0), 0x07)), _T_0)
					If(LEqual(_T_0, Zero))
					{
						ADBG("DC")
						Or(Local1, Zero, Local1)
					}
					Else
					{
						If(LEqual(_T_0, One))
						{
							ADBG("AC")
							Or(Local1, One, Local1)
						}
						Else
						{
							If(LEqual(_T_0, 0x02))
							{
								ADBG("PD")
								Or(Local1, 0x02, Local1)
							}
							Else
							{
								If(LEqual(_T_0, 0x04))
								{
									ADBG("PD and PPS Adapter")
									Or(Local1, 0x02, Local1)
								}
								Else
								{
									ADBG("Default DC")
									Or(Local1, Zero, Local1)
								}
							}
						}
					}
					Break
				}
				Return(Local1)
			}
			Method(ARTG, 0, NotSerialized)
			{
				ADBG("ARTG")
				If(LEqual(And(PSRC(), 0x07), One))
				{
					If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.ARTG))
					{
						Store(\_SB.PC00.LPCB.H_EC.DPTF.ARTG, Local0)
						If(LNotEqual(Local0, 0xFFFFFFFF))
						{
							ADBG(Concatenate("ARTG EC: ", ToHexString(Local0)))
							Return(Local0)
						}
					}
					ADBG("ARTG EC not available")
					Return(0x00015F90)
				}
				Else
				{
					ADBG("ARTG Power Source is  AC")
					Return(Zero)
				}
			}
			Method(PROP, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.PROP))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.PROP, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Multiply(Local0, 0x03E8, Local0)
						ADBG(Concatenate("PROP EC: ", ToHexString(Local0)))
						Return(Local0)
					}
				}
				ADBG("PROP EC not available")
				Return(0x61A8)
			}
			Method(PBOK, 1, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.PBOK))
				{
					Store(And(Arg0, 0x0F), Local0)
					\_SB.PC00.LPCB.H_EC.DPTF.PBOK
					Local0
					Return(Zero)
				}
				ADBG("PBOK not available")
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(BAT1)
		{
			Name(_UID, "1")
			Method(_HID, 0, NotSerialized)
			{
				Return(\_SB.PLDT.GHID(_UID))
			}
			Name(_STR, Unicode("Battery 1 Participant")})
			Name(PTYP, 0x0C)
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(\_SB.BATR, One))
				{
					Return(0x0F)
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(PMAX, 0, Serialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.BMAX))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.BMAX, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						If(Local0)
						{
							Not(Or(0xFFFF0000, Local0, Local0), Local0)
							Multiply(Add(One, Local0, Local0), 0x0A, Local0)
						}
						Return(Local0)
					}
				}
				ADBG("PMAX: EC not available")
				Return(Zero)
			}
			Method(CTYP, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.CTYP))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.CTYP, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Return(Local0)
					}
				}
				ADBG("CTYP: EC not available")
				Return(0x03)
			}
			Method(PBSS, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.PBSS))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.PBSS, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Return(Local0)
					}
				}
				ADBG("PBSS: EC not available")
				Return(0x64)
			}
			Method(DPSP, 0, Serialized)
			{
				Return(\_SB.PPPR)
			}
			Method(RBHF, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.RBHF))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.RBHF, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Return(Local0)
					}
				}
				ADBG("RBHF: EC not available")
				Return(0xFFFFFFFF)
			}
			Method(VBNL, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.VBNL))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.VBNL, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Return(Local0)
					}
				}
				ADBG("VBNL: EC not available")
				Return(0xFFFFFFFF)
			}
			Method(CMPP, 0, NotSerialized)
			{
				If(CondRefOf(\_SB.PC00.LPCB.H_EC.DPTF.CMPP))
				{
					Store(\_SB.PC00.LPCB.H_EC.DPTF.CMPP, Local0)
					If(LNotEqual(Local0, 0xFFFFFFFF))
					{
						Return(Local0)
					}
				}
				ADBG("CMPP: EC not available")
				Return(0xFFFFFFFF)
			}
		}
	}
	Scope(\_SB.IETM)
	{
		Device(SEN2)
		{
