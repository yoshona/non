							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", Zero}
							}
						})
					}
				}
			}
			Method(_DSM, 4, Serialized)
			{
				Name(_T_1, Zero)
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("197DB5E0-F0954F33-B91571DD70833E55")}))
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, One))
						{
							Return(Buffer(One)
							{
								0x07
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x01
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						Name(PCPN, Buffer(One)
						{
							0x00
						})
						CreateBitField(PCPN,Zero,PCP0)
						CreateBitField(PCPN,One,PCP1)
						If(LEqual(DUID, Zero))
						{
							If(LEqual(TRE0, One))
							{
								Store(One, PCP0)
							}
							If(LEqual(TRE1, One))
							{
								Store(One, PCP1)
							}
						}
						Else
						{
							If(LEqual(TRE2, One))
							{
								Store(One, PCP0)
							}
							If(LEqual(TRE3, One))
							{
								Store(One, PCP1)
							}
						}
						Return(PCPN)
					}
					If(LEqual(Arg2, 0x02))
					{
						Name(TCAP, Buffer(One)
						{
							0x00
						})
						CreateBitField(TCAP,Zero,IMRV)
						CreateBitField(TCAP,One,WAKE)
						CreateBitField(TCAP,0x02,TVDS)
						If(ITIM)
						{
							Store(One, IMRV)
						}
						If(TIVS)
						{
							Store(One, WAKE)
						}
						If(ITVD)
						{
							Store(One, TVDS)
						}
						Return(TCAP)
					}
				}
				Else
				{
					If(LEqual(Arg0, ToUUID("1B425232-154C4F34-7B9EB65C946494A3")}))
					{
						While(One)
						{
							Store(ToInteger(Arg2), _T_0)
							If(LEqual(_T_0, Zero))
							{
								ADBG(Concatenate("TBT DMA _DSM DUID:", ToHexString(DUID)))
								While(One)
								{
									Store(ToInteger(Arg1), _T_1)
									If(LEqual(_T_1, One))
									{
										Return(Buffer(One)
										{
											0x03
										})
									}
									Break
								}
								ADBG("return buffer 0x00")
								Return(Buffer(One)
								{
									0x00
								})
							}
							Else
							{
								If(LEqual(_T_0, One))
								{
									ADBG(Concatenate("TBT DMA _DSM Func 1 DUID:", ToHexString(DUID)))
									If(LEqual(DUID, One))
									{
										ADBG(Concatenate("ITM1:", ToHexString(ITM1)))
										Return(ITM1)
									}
									Else
									{
										ADBG(Concatenate("ITM0:", ToHexString(ITM0)))
										Return(ITM0)
									}
								}
							}
							Break
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Method(STCM, 2, Serialized)
			{
				ADBG(Concatenate("STCM DUID = ", ToHexString(DUID)))
				ADBG(Concatenate("Requested CM mode = ", Arg0))
				ADBG(Concatenate("Pre-boot CM Info  = ", ToHexString(Arg1)))
				And(Arg1, 0x07, Local0)
				Store(One, Local1)
				If(LNotEqual(And(Arg1, 0x80), 0x80))
				{
					ADBG("U4CM valid bit is not set!")
					Return(0xFF)
				}
				Else
				{
					Store(Local0, SCME)
					If(LEqual(Arg0, Local0))
					{
						ADBG("Pre-boot CM mode aligns with OS preferred CM mode")
						Store(Zero, Local1)
					}
				}
				If(LEqual(Local1, One))
				{
					If(LEqual(CHCM(Arg0), Zero))
					{
						ADBG(Concatenate("Switch CM mode success, request mode = ", Arg0))
						Store(Arg0, SCME)
					}
					Else
					{
						ADBG(Concatenate("Switch CM mode failure, request mode = ", Arg0))
						Return(0xFF)
					}
				}
				ADBG(Concatenate("SCME - ", ToHexString(SCME)))
				Return(SCME)
			}
			Field(DPME, DWordAcc, NoLock, Preserve)
			{
				Offset(0xC8),	//Offset(200),
				Offset(0xCB),	//Offset(203),
				, 7,
				INFR, 1,
				Offset(0xEC),	//Offset(236),
				TB2P, 32,
				P2TB, 32,
			}
			Method(ITMB, 1, Serialized)
			{
				ADBG(ToHexString(_DDN))
				ADBG(Concatenate("MailBox Cmd ", ToHexString(ShiftRight(Arg0, One))))
				Or(Arg0, One, Local0)
				Store(Local0, P2TB)
				ADBG("Command is sent")
			}
			Method(WFCC, 1, Serialized)
			{
				WTBS(Arg0)
				Store(Zero, P2TB)
				WTBC(Arg0)
			}
			Method(WTBS, 1, Serialized)
			{
				Store(Arg0, Local0)
				ADBG(Concatenate("Wait TB2P to be set, DUID ", ToHexString(DUID)))
				While(LGreater(Local0, Zero))
				{
					If(And(TB2P, One))
					{
						ADBG(Concatenate("TB2P is set, DUID ", ToHexString(DUID)))
						ADBG(Concatenate("Wait count = ", ToHexString(Subtract(Arg0, Local0))))
						Break
					}
					Decrement(Local0)
					Sleep(One)
				}
				If(LEqual(Local0, Zero))
				{
					ADBG(Concatenate("Command Timeout, DUID ", ToHexString(DUID)))
					ADBG(Concatenate("Timeout Value ", ToHexString(Arg0)))
				}
				Return(Local0)
			}
			Method(WTBC, 1, Serialized)
			{
				Store(Arg0, Local0)
				ADBG(Concatenate("Wait TB2P to be clear, DUID ", ToHexString(DUID)))
				While(LGreater(Local0, Zero))
				{
					If(LNotEqual(And(TB2P, One), One))
					{
						ADBG(Concatenate("TB2P is clear, DUID ", ToHexString(DUID)))
						Break
					}
					Decrement(Local0)
					Sleep(One)
				}
				If(LEqual(Local0, Zero))
				{
					ADBG(Concatenate("Command Timeout, DUID ", ToHexString(DUID)))
					ADBG(Concatenate("Timeout Value ", ToHexString(Arg0)))
				}
			}
			Method(CNTP, 0, Serialized)
			{
				ADBG(Concatenate("TCSS Send ITBT CONNECT TOPOLOGY Cmd Start, DUID -", ToHexString(DUID)))
				Store(Zero, Local0)
				If(LEqual(DFPE, Zero))
				{
					Store(0x22, DMAD)
					Store(One, DFPE)
					While(LAnd(LEqual(INFR, Zero), LLess(Local0, ITFP)))
					{
						Sleep(One)
						Increment(Local0)
					}
				}
				If(LNotEqual(Local0, ITFP))
				{
					ITMB(0x3E)
				}
				Else
				{
					ADBG("Force Power Timeout occurred")
				}
				If(LNotEqual(DFPE, Zero))
				{
					ADBG("Unset Force Power")
					Store(Zero, DFPE)
				}
				ADBG(Concatenate("TCSS Send ITBT CONNECT TOPOLOGY Cmd End, DUID -", ToHexString(DUID)))
			}
			Method(CMMB, 1, Serialized)
			{
				If(LEqual(Arg0, Zero))
				{
					ADBG("Set FW CM mode")
					ITMB(0x44)
				}
				Else
				{
					If(LEqual(Arg0, One))
					{
						ADBG("Set SW CM mode")
						ITMB(0x46)
					}
				}
				Store(WTBS(0x01F4), Local0)
				If(LNotEqual(Local0, Zero))
				{
					ADBG("Set CM mode done bit is set")
					Store(Zero, Local1)
				}
				Else
				{
					ADBG("Set CM mode command timeout")
					Store(0xFF, Local1)
				}
				Store(Zero, P2TB)
				Return(Local1)
			}
			Method(CHCM, 1, Serialized)
			{
				ADBG(Concatenate("iTBT CHCM - Switch CM mode to ", Arg0))
				If(LGreater(Arg0, One))
				{
					ADBG("Invalid CM mode value")
					Return(0xFF)
				}
				Store(Zero, Local0)
				If(LEqual(DFPE, Zero))
				{
					ADBG("Set Force Power")
					Store(0x22, DMAD)
					Store(One, DFPE)
					While(LAnd(LEqual(INFR, Zero), LLess(Local0, ITFP)))
					{
						Sleep(One)
						Increment(Local0)
					}
				}
				Else
				{
					ADBG("Force Power has been set")
				}
				If(LNotEqual(Local0, ITFP))
				{
					Store(CMMB(Arg0), Local1)
					If(LAnd(LEqual(Arg0, Zero), LEqual(Local1, Zero)))
					{
						ADBG("Send Connect Topology command")
						ITMB(0x3E)
						Store(WTBS(ITCT), Local2)
						If(LNotEqual(Local2, Zero))
						{
							ADBG("Connect topology command done bit is set")
							Store(Zero, Local1)
						}
						Else
						{
							ADBG("Connect topology command timeout!")
							Store(0xFF, Local1)
						}
						Store(Zero, P2TB)
					}
				}
				Else
				{
					ADBG("Force Power Timeout occurred")
					Store(0xFF, Local1)
				}
				If(LNotEqual(DFPE, Zero))
				{
					ADBG("Unset Force Power")
					Store(Zero, DFPE)
				}
				ADBG(Concatenate("iTBT change CM mode status = ", Local1))
				Return(Local1)
			}
		}
		Device(TDM1)
		{
			Name(_ADR, 0x000D0003)
			Name(_DDN, "ICL TBT DMA1 controller")
			Name(_STR, Unicode("ICL TBT DMA1 controller")})
			Name(DUID, One)
			Name(DCPM, 0x07)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS DMA1 _STA", ToHexString(DME1)))
				If(LEqual(DME1, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(BASE, 0, NotSerialized)
			{
				Add(\_SB.PC00.GPCB(), 0x0006B000, Local0)
				ADBG(Concatenate("TDM1 MMIO Address", ToHexString(Local0)))
				Return(Local0)
			}
			OperationRegion(DPME, SystemMemory, BASE, 0x0100)
			Field(DPME, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x84),	//Offset(132),
				PMST, 2,
				, 6,
				PMEE, 1,
				, 6,
				PMES, 1,
				Offset(0xFC),	//Offset(252),
				DD3E, 1,
				DFPE, 1,
				Offset(0xFF),	//Offset(255),
				DMAD, 8,
			}
			Name(STAT, One)
			Name(ALCT, Zero)
			Name(WACT, Zero)
			Name(SCME, Zero)
			Method(_PS0, 0, Serialized)
			{
				ADBG(Concatenate("TBT DMA PS0 Start, DUID -", ToHexString(DUID)))
				ADBG(Concatenate("DMA VDID -", ToHexString(VDID)))
				ADBG(Concatenate("PMST -", ToHexString(PMST)))
				ADBG(Concatenate("PMEE -", ToHexString(PMEE)))
				ADBG(Concatenate("PMES -", ToHexString(PMES)))
				ADBG(Concatenate("SCME -", ToHexString(SCME)))
				If(LEqual(SCME, One))
				{
					TBON
					DUID
				}
				Else
				{
					If(LEqual(WACT, One))
					{
						Store(0x02, WACT)
						WFCC(ITCT)
						Store(Zero, WACT)
					}
					Else
					{
						If(LEqual(WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				ADBG(Concatenate("TBT DMA PS0 End, DUID -", ToHexString(DUID)))
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG(Concatenate("TBT DMA PS3 Start, DUID -", ToHexString(DUID)))
				ADBG(Concatenate("DMA VDID -", ToHexString(VDID)))
				ADBG(Concatenate("PMST -", ToHexString(PMST)))
				ADBG(Concatenate("PMEE -", ToHexString(PMEE)))
				ADBG(Concatenate("PMES -", ToHexString(PMES)))
				ADBG(Concatenate("SCME -", ToHexString(SCME)))
				If(LEqual(SCME, One))
				{
					TBOF
					DUID
				}
				ADBG(Concatenate("TBT DMA PS3 End, DUID -", ToHexString(DUID)))
			}
			Method(_S0W, 0, NotSerialized)
			{
				ADBG("TDMA S0W")
				If(ITRT)
				{
					Return(0x04)
				}
				Else
				{
					Return(0x03)
				}
			}
			If(ITRT)
			{
				Method(_PR0, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(SCME)
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LEqual(DUID, Zero))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LEqual(DUID, Zero))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
				Method(_PR3, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(SCME)
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LEqual(DUID, Zero))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LEqual(DUID, Zero))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
			}
			Method(D3CX, 0, Serialized)
			{
				ADBG("Disable DMA RTD3 bit")
				ADBG(Concatenate("DUID -", ToHexString(DUID)))
				Store(Zero, DD3E)
				Store(One, STAT)
			}
			Method(D3CE, 0, Serialized)
			{
				ADBG("Enable DMA RTD3 bit")
				ADBG(Concatenate("DUID -", ToHexString(DUID)))
				Store(One, DD3E)
				Store(Zero, STAT)
				If(LEqual(SCME, Zero))
				{
					Store(One, ALCT)
				}
			}
			Name(SD3C, Zero)
			Method(_DSW, 3, NotSerialized)
			{
				ADBG(Concatenate("TCSS DMA _DSW DUID -", ToHexString(DUID)))
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				Store(Arg1, SD3C)
				ADBG(Concatenate("SD3C -", ToHexString(SD3C)))
			}
			Method(_PRW, 0, NotSerialized)
			{
				Return(GPRW(0x6D, Zero))
			}
			Method(_DSD, 0, NotSerialized)
			{
				ADBG(Concatenate("TBT _DSD IMR_VALID =", ToHexString(ITIM)))
				ADBG(Concatenate("TBT _DSD WAKE_SUPPORTED =", ToHexString(TIVS)))
				If(ITIM)
				{
					If(TIVS)
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", One}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", One}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", One}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", Zero}
							}
						})
					}
				}
				Else
				{
					If(TIVS)
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", Zero}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", One}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0x2F, 0x00, 0x4D, 0xC4, 0xF9, 0x69, 0x7D, 0x4E, 
								0xA9, 0x04, 0xA7, 0xBA, 0xAB, 0xDF, 0x43, 0xF7
							}, 
							Package(1)
							{
								Package(2) {"IMR_VALID", Zero}
							}, 
							Buffer(0x10)
							{
								0x03, 0x11, 0x50, 0x6C, 0x89, 0xC1, 0x96, 0x42, 
								0xBA, 0x72, 0x9B, 0xF5, 0xA2, 0x6E, 0xBE, 0x5D
							}, 
							Package(1)
							{
								Package(2) {"WAKE_SUPPORTED", Zero}
							}
						})
					}
				}
			}
			Method(_DSM, 4, Serialized)
			{
				Name(_T_1, Zero)
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("197DB5E0-F0954F33-B91571DD70833E55")}))
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, One))
						{
							Return(Buffer(One)
							{
								0x07
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x01
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						Name(PCPN, Buffer(One)
						{
							0x00
						})
						CreateBitField(PCPN,Zero,PCP0)
						CreateBitField(PCPN,One,PCP1)
						If(LEqual(DUID, Zero))
						{
							If(LEqual(TRE0, One))
							{
								Store(One, PCP0)
							}
							If(LEqual(TRE1, One))
							{
								Store(One, PCP1)
							}
						}
						Else
						{
							If(LEqual(TRE2, One))
							{
								Store(One, PCP0)
							}
							If(LEqual(TRE3, One))
							{
								Store(One, PCP1)
							}
						}
						Return(PCPN)
					}
					If(LEqual(Arg2, 0x02))
					{
						Name(TCAP, Buffer(One)
						{
							0x00
						})
						CreateBitField(TCAP,Zero,IMRV)
						CreateBitField(TCAP,One,WAKE)
						CreateBitField(TCAP,0x02,TVDS)
						If(ITIM)
						{
							Store(One, IMRV)
						}
						If(TIVS)
						{
							Store(One, WAKE)
						}
						If(ITVD)
						{
							Store(One, TVDS)
						}
						Return(TCAP)
					}
				}
				Else
				{
					If(LEqual(Arg0, ToUUID("1B425232-154C4F34-7B9EB65C946494A3")}))
					{
						While(One)
						{
							Store(ToInteger(Arg2), _T_0)
							If(LEqual(_T_0, Zero))
							{
								ADBG(Concatenate("TBT DMA _DSM DUID:", ToHexString(DUID)))
								While(One)
								{
									Store(ToInteger(Arg1), _T_1)
									If(LEqual(_T_1, One))
									{
										Return(Buffer(One)
										{
											0x03
										})
									}
									Break
								}
								ADBG("return buffer 0x00")
								Return(Buffer(One)
								{
									0x00
								})
							}
							Else
							{
								If(LEqual(_T_0, One))
								{
									ADBG(Concatenate("TBT DMA _DSM Func 1 DUID:", ToHexString(DUID)))
									If(LEqual(DUID, One))
									{
										ADBG(Concatenate("ITM1:", ToHexString(ITM1)))
										Return(ITM1)
									}
									Else
									{
										ADBG(Concatenate("ITM0:", ToHexString(ITM0)))
										Return(ITM0)
									}
								}
							}
							Break
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Method(STCM, 2, Serialized)
			{
				ADBG(Concatenate("STCM DUID = ", ToHexString(DUID)))
				ADBG(Concatenate("Requested CM mode = ", Arg0))
				ADBG(Concatenate("Pre-boot CM Info  = ", ToHexString(Arg1)))
				And(Arg1, 0x07, Local0)
				Store(One, Local1)
				If(LNotEqual(And(Arg1, 0x80), 0x80))
				{
					ADBG("U4CM valid bit is not set!")
					Return(0xFF)
				}
				Else
				{
					Store(Local0, SCME)
					If(LEqual(Arg0, Local0))
					{
						ADBG("Pre-boot CM mode aligns with OS preferred CM mode")
						Store(Zero, Local1)
					}
				}
				If(LEqual(Local1, One))
				{
					If(LEqual(CHCM(Arg0), Zero))
					{
						ADBG(Concatenate("Switch CM mode success, request mode = ", Arg0))
						Store(Arg0, SCME)
					}
					Else
					{
						ADBG(Concatenate("Switch CM mode failure, request mode = ", Arg0))
						Return(0xFF)
					}
				}
				ADBG(Concatenate("SCME - ", ToHexString(SCME)))
				Return(SCME)
			}
			Field(DPME, DWordAcc, NoLock, Preserve)
			{
				Offset(0xC8),	//Offset(200),
				Offset(0xCB),	//Offset(203),
				, 7,
				INFR, 1,
				Offset(0xEC),	//Offset(236),
				TB2P, 32,
				P2TB, 32,
			}
			Method(ITMB, 1, Serialized)
			{
				ADBG(ToHexString(_DDN))
				ADBG(Concatenate("MailBox Cmd ", ToHexString(ShiftRight(Arg0, One))))
				Or(Arg0, One, Local0)
				Store(Local0, P2TB)
				ADBG("Command is sent")
			}
			Method(WFCC, 1, Serialized)
			{
				WTBS(Arg0)
				Store(Zero, P2TB)
				WTBC(Arg0)
			}
			Method(WTBS, 1, Serialized)
			{
				Store(Arg0, Local0)
				ADBG(Concatenate("Wait TB2P to be set, DUID ", ToHexString(DUID)))
				While(LGreater(Local0, Zero))
				{
					If(And(TB2P, One))
					{
						ADBG(Concatenate("TB2P is set, DUID ", ToHexString(DUID)))
						ADBG(Concatenate("Wait count = ", ToHexString(Subtract(Arg0, Local0))))
						Break
					}
					Decrement(Local0)
					Sleep(One)
				}
				If(LEqual(Local0, Zero))
				{
					ADBG(Concatenate("Command Timeout, DUID ", ToHexString(DUID)))
					ADBG(Concatenate("Timeout Value ", ToHexString(Arg0)))
				}
				Return(Local0)
			}
			Method(WTBC, 1, Serialized)
			{
				Store(Arg0, Local0)
				ADBG(Concatenate("Wait TB2P to be clear, DUID ", ToHexString(DUID)))
				While(LGreater(Local0, Zero))
				{
					If(LNotEqual(And(TB2P, One), One))
					{
						ADBG(Concatenate("TB2P is clear, DUID ", ToHexString(DUID)))
						Break
					}
					Decrement(Local0)
					Sleep(One)
				}
				If(LEqual(Local0, Zero))
				{
					ADBG(Concatenate("Command Timeout, DUID ", ToHexString(DUID)))
					ADBG(Concatenate("Timeout Value ", ToHexString(Arg0)))
				}
			}
			Method(CNTP, 0, Serialized)
			{
				ADBG(Concatenate("TCSS Send ITBT CONNECT TOPOLOGY Cmd Start, DUID -", ToHexString(DUID)))
				Store(Zero, Local0)
				If(LEqual(DFPE, Zero))
				{
					Store(0x22, DMAD)
					Store(One, DFPE)
					While(LAnd(LEqual(INFR, Zero), LLess(Local0, ITFP)))
					{
						Sleep(One)
						Increment(Local0)
					}
				}
				If(LNotEqual(Local0, ITFP))
				{
					ITMB(0x3E)
				}
				Else
				{
					ADBG("Force Power Timeout occurred")
				}
				If(LNotEqual(DFPE, Zero))
				{
					ADBG("Unset Force Power")
					Store(Zero, DFPE)
				}
				ADBG(Concatenate("TCSS Send ITBT CONNECT TOPOLOGY Cmd End, DUID -", ToHexString(DUID)))
			}
			Method(CMMB, 1, Serialized)
			{
				If(LEqual(Arg0, Zero))
				{
					ADBG("Set FW CM mode")
					ITMB(0x44)
				}
				Else
				{
					If(LEqual(Arg0, One))
					{
						ADBG("Set SW CM mode")
						ITMB(0x46)
					}
				}
				Store(WTBS(0x01F4), Local0)
				If(LNotEqual(Local0, Zero))
				{
					ADBG("Set CM mode done bit is set")
					Store(Zero, Local1)
				}
				Else
				{
					ADBG("Set CM mode command timeout")
					Store(0xFF, Local1)
				}
				Store(Zero, P2TB)
				Return(Local1)
			}
			Method(CHCM, 1, Serialized)
			{
				ADBG(Concatenate("iTBT CHCM - Switch CM mode to ", Arg0))
				If(LGreater(Arg0, One))
				{
					ADBG("Invalid CM mode value")
					Return(0xFF)
				}
				Store(Zero, Local0)
				If(LEqual(DFPE, Zero))
				{
					ADBG("Set Force Power")
					Store(0x22, DMAD)
					Store(One, DFPE)
					While(LAnd(LEqual(INFR, Zero), LLess(Local0, ITFP)))
					{
						Sleep(One)
						Increment(Local0)
					}
				}
				Else
				{
					ADBG("Force Power has been set")
				}
				If(LNotEqual(Local0, ITFP))
				{
					Store(CMMB(Arg0), Local1)
					If(LAnd(LEqual(Arg0, Zero), LEqual(Local1, Zero)))
					{
						ADBG("Send Connect Topology command")
						ITMB(0x3E)
						Store(WTBS(ITCT), Local2)
						If(LNotEqual(Local2, Zero))
						{
							ADBG("Connect topology command done bit is set")
							Store(Zero, Local1)
						}
						Else
						{
							ADBG("Connect topology command timeout!")
							Store(0xFF, Local1)
						}
						Store(Zero, P2TB)
					}
				}
				Else
				{
					ADBG("Force Power Timeout occurred")
					Store(0xFF, Local1)
				}
				If(LNotEqual(DFPE, Zero))
				{
					ADBG("Unset Force Power")
					Store(Zero, DFPE)
				}
				ADBG(Concatenate("iTBT change CM mode status = ", Local1))
				Return(Local1)
			}
		}
		Device(TRP0)
		{
			Method(_ADR, 0, NotSerialized)
			{
				If(LNotEqual(TPA0, Zero))
				{
					ADBG(Concatenate("TRP0 _ADR", ToHexString(TPA0)))
					Return(TPA0)
				}
				Else
				{
					Return(0x00070000)
				}
			}
			Name(TUID, Zero)
			Name(LTEN, Zero)
			Name(LMSL, 0x88C8)
			Name(LNSL, 0x88C8)
			Name(DCPM, Zero)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP0 _STA", ToHexString(TRE0)))
				If(LEqual(TRE0, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(_INI, 0, NotSerialized)
			{
				Store(LTE0, LTEN)
				Store(PSL0, LMSL)
				Store(PNS0, LNSL)
			}
			Name(PRTP, 0x08)
			Name(BCFG, Ones)
			Method(BASE, 0, NotSerialized)
			{
				If(LNotEqual(BCFG, Ones))
				{
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
				Else
				{
					Store(And(_ADR(), 0x07), Local0)
					Store(And(ShiftRight(_ADR(), 0x10), 0x1F), Local1)
					ADBG(Concatenate("BASE of ITBT Port ", ToHexString(TUID)))
					Add(ShiftLeft(Local0, 0x0C), ShiftLeft(Local1, 0x0F), Local2)
					Add(\_SB.PC00.GPCB(), Local2, Local3)
					Store(Local3, BCFG)
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
			}
			Method(GOPB, 1, NotSerialized)
			{
				Add(BASE(), Arg0, Local0)
				ADBG(Concatenate("TCSS PCIE RP register offset MMIO Address ", ToHexString(Local0)))
				Return(Local0)
			}
			OperationRegion(PXCS, SystemMemory, BASE, 0x0C00)
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x50),	//Offset(80),
				L0SE, 1,
				, 3,
				LDIS, 1,
				, 3,
				, 8,
				Offset(0x53),	//Offset(83),
				, 5,
				LASX, 1,
				Offset(0x5A),	//Offset(90),
				ABPX, 1,
				, 2,
				PDCX, 1,
				, 2,
				PDSX, 1,
				, 1,
				DLSC, 1,
				Offset(0x60),	//Offset(96),
				Offset(0x62),	//Offset(98),
				PSPX, 1,
				Offset(0xA4),	//Offset(164),
				D3HT, 2,
				Offset(0x328),	//Offset(808),
				STS1, 32,
			}
			OperationRegion(TPCS, SystemMemory, GOPB, 0x0420)
			0x04
			Field(TPCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x3),	//Offset(3),
				, 6,
				DPGE, 1,
			}
			OperationRegion(ADCS, SystemMemory, GOPB, 0x05BC)
			0x04
			Field(ADCS, AnyAcc, NoLock, Preserve)
			{
				, 3,
				RPER, 1,
				RPFE, 1,
			}
			OperationRegion(CCCS, SystemMemory, GOPB, RPCC)
			0x20
			Field(CCCS, AnyAcc, NoLock, WriteAsZeros)
			{
				Offset(0xC),	//Offset(12),
				Offset(0xF),	//Offset(15),
				, 6,
				HPSX, 1,
				PMSX, 1,
			}
			Field(CCCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x8),	//Offset(8),
				Offset(0xB),	//Offset(11),
				, 6,
				HPEX, 1,
				PMEX, 1,
				Offset(0x12),	//Offset(18),
				, 2,
				L23E, 1,
				L23R, 1,
			}
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x68),	//Offset(104),
				Offset(0x69),	//Offset(105),
				, 2,
				LNRE, 1,
				Offset(0x404),	//Offset(1028),
				LSOE, 1,
				LNSE, 1,
			}
			Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
			Method(_DSM, 4, Serialized)
			{
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
				{
					While(One)
					{
						Store(ToInteger(Arg2), _T_0)
						If(LEqual(_T_0, Zero))
						{
							Name(OPTS, Buffer(0x02)
							{
								0x00, 0x00
							})
							CreateBitField(OPTS,Zero,FUN0)
							CreateBitField(OPTS,0x05,FUN5)
							CreateBitField(OPTS,0x06,FUN6)
							CreateBitField(OPTS,0x08,FUN8)
							CreateBitField(OPTS,0x09,FUN9)
							Store(One, FUN0)
							Store(IORB, FUN5)
							If(LEqual(LTEN, One))
							{
								Store(One, FUN6)
							}
							If(LGreaterEqual(Arg1, 0x02))
							{
								If(CondRefOf(ECR1))
								{
									If(LEqual(ECR1, One))
									{
										If(LGreaterEqual(Arg1, 0x03))
										{
											Store(One, FUN8)
											Store(One, FUN9)
										}
									}
								}
							}
							ADBG(Concatenate("TBT RP OPTS -", ToHexString(OPTS)))
							Return(OPTS)
						}
						Else
						{
							If(LEqual(_T_0, 0x05))
							{
								If(LGreaterEqual(Arg1, One))
								{
									Return(One)
								}
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
									{
										Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
										Store(And(LMSL, 0x03FF), Index(LTRV, One))
										Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
										Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
										Return(LTRV)
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x08))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(One)
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x09))
										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
									}
								}
							}
						}
						Break
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Device(PXSX)
			{
				Name(_ADR, Zero)
				Method(_PRW, 0, NotSerialized)
				{
					If(CondRefOf(GP1E))
					{
						If(LNotEqual(GP1E, Zero))
						{
							Return(GPRW(0xC7, 0x04))
						}
					}
					Return(GPRW(0x69, 0x04))
				}
			}
			Method(_DSW, 3, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP _DSW TUID -", ToHexString(TUID)))
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				Store(Arg1, \_SB.PC00.TDM0.SD3C)
				Store(Arg1, \_SB.PC00.TDM1.SD3C)
				ADBG(Concatenate("TDM0 SD3C -", ToHexString(\_SB.PC00.TDM0.SD3C)))
				ADBG(Concatenate("TDM1 SD3C -", ToHexString(\_SB.PC00.TDM1.SD3C)))
				C2PM(Arg0, Arg1, Arg2, DCPM)
			}
			Method(_PRW, 0, NotSerialized)
			{
				If(CondRefOf(GP1E))
				{
					If(LNotEqual(GP1E, Zero))
					{
						Return(GPRW(0xC7, 0x04))
					}
				}
				Return(GPRW(0x69, 0x04))
			}
			Method(LTRC, 0, Serialized)
			{
				ADBG(Concatenate("TCSS RP LTREN check TUID -", ToHexString(TUID)))
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					ADBG(Concatenate("Current DCTL2 LTREN -", ToHexString(LNRE)))
					Store(One, HPSX)
					If(LEqual(LASX, Zero))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG(Concatenate("Toggle LTREN to TUID -", ToHexString(TUID)))
					}
				}
			}
			Method(CRPM, 0, Serialized)
			{
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					Return(D3HT)
				}
				Return(0xFF)
			}
			Method(HPEV, 0, Serialized)
			{
				If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), HPSX))
				{
					ADBG(Concatenate("HotPlug Event Start for ITBT Port - ", ToHexString(TUID)))
					If(LAnd(LEqual(PDCX, One), LEqual(DLSC, One)))
					{
						Store(One, PDCX)
						Store(One, HPSX)
						Notify(^, Zero)
					}
					Else
					{
						Store(One, HPSX)
					}
					ADBG(Concatenate("HotPlug Event End for ITBT Port - ", ToHexString(TUID)))
				}
			}
			Name(STAT, One)
			Method(D3CX, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdExit Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				ADBG(Concatenate("VDID -", ToHexString(VDID)))
				If(LEqual(STAT, One))
				{
					Return(Zero)
				}
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(Zero, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(Zero, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				Store(One, L23R)
				Store(Zero, Local0)
				Store(L23R, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23R, Local1)
				}
				ADBG(Concatenate("L23R -", ToHexString(L23R)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(One, STAT)
				Store(Zero, Local0)
				Store(LASX, Local1)
				If(LGreater(PLAT, Zero))
				{
					While(LEqual(Local1, Zero))
					{
						If(LGreater(Local0, PLAT))
						{
							Break
						}
						Sleep(0x05)
						Add(Local0, 0x05, Local0)
						Store(LASX, Local1)
					}
				}
				ADBG(Concatenate("LASX -", ToHexString(LASX)))
				ADBG(Concatenate("PLAT -", ToHexString(PLAT)))
				ADBG("TBT RP D3ColdExit End")
			}
			Method(D3CE, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdEntry Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				If(LEqual(STAT, Zero))
				{
					Return(Zero)
				}
				If(LOr(LEqual(LNSE, One), LEqual(LSOE, One)))
				{
					If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG("Toggle LNRE -")
					}
				}
				Store(One, L23E)
				Store(Zero, Local0)
				Store(L23E, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23E, Local1)
				}
				ADBG(Concatenate("L23E -", ToHexString(L23E)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(Zero, STAT)
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(One, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(One, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				ADBG(Concatenate("TBT RP D3ColdEntry End TUID -", ToHexString(TUID)))
			}
			Method(_PS0, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS0 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				HPEV()
				HPME()
				If(LEqual(PMEX, One))
				{
					ADBG("Disable PME SCI")
					Store(Zero, PMEX)
				}
				Sleep(PLAT)
				If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
				{
					If(LEqual(\_SB.PC00.TDM0.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM0.WACT)
						\_SB.PC00.TDM0.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM0.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM0.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM0.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				Else
				{
					If(LEqual(\_SB.PC00.TDM1.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM1.WACT)
						\_SB.PC00.TDM1.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM1.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM1.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM1.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				ADBG(Concatenate("TBT _PS0 End RP ", ToHexString(TUID)))
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS3 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				CHKH()
				If(LEqual(HPEX, Zero))
				{
					ADBG("Enable Hot Plug SCI")
					Store(One, HPEX)
					HPEV()
				}
				If(LEqual(PMEX, Zero))
				{
					ADBG("Enable PME SCI")
					Store(One, PMEX)
					HPME()
				}
				ADBG(Concatenate("TBT _PS3 End RP ", ToHexString(TUID)))
			}
			Method(CHKH, 0, NotSerialized)
			{
				If(LEqual(PDCX, One))
				{
					ADBG("PDC get set before enable HotPlug SCI")
					If(LEqual(DLSC, Zero))
					{
						ADBG("Clear PDC since it is not a real hotplug")
						Store(One, PDCX)
					}
				}
			}
			Method(_DSD, 0, NotSerialized)
			{
				ADBG("TBT RP _DSD")
				ADBG(Concatenate("TUID = ", ToHexString(TUID)))
				If(CondRefOf(U4CM))
				{
					If(LEqual(And(U4CM, 0x07), Zero))
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}
						})
					}
				}
				If(LAnd(LOr(LEqual(TUID, Zero), LEqual(TUID, One)), LEqual(DME0, One)))
				{
					Return(Package(6)
					{
						Buffer(0x10)
						{
							0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
							0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
						}, 
						Package(1)
						{
							Package(2) {"HotPlugSupportInD3", One}
						}, 
						Buffer(0x10)
						{
							0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
							0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
						}, 
						Package(2)
						{
							Package(2) {"ExternalFacingPort", One}, 
							Package(2) {"UID", TUID}
						}, 
						Buffer(0x10)
						{
							0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
							0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
						}, 
						Package(2)
						{
							Package(2) {"usb4-host-interface", \_SB.PC00.TDM0}, 
							Package(2) {"usb4-port-number", TUID}
						}
					})
				}
				Else
				{
					If(LAnd(LOr(LEqual(TUID, 0x02), LEqual(TUID, 0x03)), LEqual(DME1, One)))
					{
						Return(Package(6)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}, 
							Buffer(0x10)
							{
								0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
								0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
							}, 
							Package(2)
							{
								Package(2) {"usb4-host-interface", \_SB.PC00.TDM1}, 
								Package(2) {"usb4-port-number", TUID}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}
						})
					}
				}
			}
			Method(_S0W, 0, NotSerialized)
			{
				If(ITRT)
				{
					Return(0x04)
				}
				Else
				{
					Return(0x03)
				}
			}
			If(ITRT)
			{
				Method(_PR0, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(LOr(LEqual(\_SB.PC00.TDM0.SCME, One), LEqual(\_SB.PC00.TDM1.SCME, One)))
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
				Method(_PR3, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(LOr(LEqual(\_SB.PC00.TDM0.SCME, One), LEqual(\_SB.PC00.TDM1.SCME, One)))
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
			}
			Method(HPME, 0, Serialized)
			{
				ADBG("TBT HPME")
				If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), LEqual(PMSX, One)))
				{
					ADBG("TBT RP exists")
					Notify(PXSX, 0x02)
					Store(One, PMSX)
					Store(One, PSPX)
					Return(One)
				}
				Return(Zero)
			}
			Name(AR01, Package(4)
			{
				Package(4) {0xFFFF, Zero, Zero, 0x10}, 
				Package(4) {0xFFFF, One, Zero, 0x11}, 
				Package(4) {0xFFFF, 0x02, Zero, 0x12}, 
				Package(4) {0xFFFF, 0x03, Zero, 0x13}
			})
			Method(_PRT, 0, NotSerialized)
			{
				Return(AR01)
			}
		}
		Device(TRP1)
		{
			Method(_ADR, 0, NotSerialized)
			{
				If(LNotEqual(TPA1, Zero))
				{
					ADBG(Concatenate("TRP1 _ADR", ToHexString(TPA1)))
					Return(TPA1)
				}
				Else
				{
					Return(0x00070001)
				}
			}
			Name(TUID, One)
			Name(LTEN, Zero)
			Name(LMSL, 0x88C8)
			Name(LNSL, 0x88C8)
			Name(DCPM, One)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP1 _STA", ToHexString(TRE1)))
				If(LEqual(TRE1, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(_INI, 0, NotSerialized)
			{
				Store(LTE1, LTEN)
				Store(PSL1, LMSL)
				Store(PNS1, LNSL)
			}
			Name(PRTP, 0x08)
			Name(BCFG, Ones)
			Method(BASE, 0, NotSerialized)
			{
				If(LNotEqual(BCFG, Ones))
				{
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
				Else
				{
					Store(And(_ADR(), 0x07), Local0)
					Store(And(ShiftRight(_ADR(), 0x10), 0x1F), Local1)
					ADBG(Concatenate("BASE of ITBT Port ", ToHexString(TUID)))
					Add(ShiftLeft(Local0, 0x0C), ShiftLeft(Local1, 0x0F), Local2)
					Add(\_SB.PC00.GPCB(), Local2, Local3)
					Store(Local3, BCFG)
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
			}
			Method(GOPB, 1, NotSerialized)
			{
				Add(BASE(), Arg0, Local0)
				ADBG(Concatenate("TCSS PCIE RP register offset MMIO Address ", ToHexString(Local0)))
				Return(Local0)
			}
			OperationRegion(PXCS, SystemMemory, BASE, 0x0C00)
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x50),	//Offset(80),
				L0SE, 1,
				, 3,
				LDIS, 1,
				, 3,
				, 8,
				Offset(0x53),	//Offset(83),
				, 5,
				LASX, 1,
				Offset(0x5A),	//Offset(90),
				ABPX, 1,
				, 2,
				PDCX, 1,
				, 2,
				PDSX, 1,
				, 1,
				DLSC, 1,
				Offset(0x60),	//Offset(96),
				Offset(0x62),	//Offset(98),
				PSPX, 1,
				Offset(0xA4),	//Offset(164),
				D3HT, 2,
				Offset(0x328),	//Offset(808),
				STS1, 32,
			}
			OperationRegion(TPCS, SystemMemory, GOPB, 0x0420)
			0x04
			Field(TPCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x3),	//Offset(3),
				, 6,
				DPGE, 1,
			}
			OperationRegion(ADCS, SystemMemory, GOPB, 0x05BC)
			0x04
			Field(ADCS, AnyAcc, NoLock, Preserve)
			{
				, 3,
				RPER, 1,
				RPFE, 1,
			}
			OperationRegion(CCCS, SystemMemory, GOPB, RPCC)
			0x20
			Field(CCCS, AnyAcc, NoLock, WriteAsZeros)
			{
				Offset(0xC),	//Offset(12),
				Offset(0xF),	//Offset(15),
				, 6,
				HPSX, 1,
				PMSX, 1,
			}
			Field(CCCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x8),	//Offset(8),
				Offset(0xB),	//Offset(11),
				, 6,
				HPEX, 1,
				PMEX, 1,
				Offset(0x12),	//Offset(18),
				, 2,
				L23E, 1,
				L23R, 1,
			}
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x68),	//Offset(104),
				Offset(0x69),	//Offset(105),
				, 2,
				LNRE, 1,
				Offset(0x404),	//Offset(1028),
				LSOE, 1,
				LNSE, 1,
			}
			Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
			Method(_DSM, 4, Serialized)
			{
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
				{
					While(One)
					{
						Store(ToInteger(Arg2), _T_0)
						If(LEqual(_T_0, Zero))
						{
							Name(OPTS, Buffer(0x02)
							{
								0x00, 0x00
							})
							CreateBitField(OPTS,Zero,FUN0)
							CreateBitField(OPTS,0x05,FUN5)
							CreateBitField(OPTS,0x06,FUN6)
							CreateBitField(OPTS,0x08,FUN8)
							CreateBitField(OPTS,0x09,FUN9)
							Store(One, FUN0)
							Store(IORB, FUN5)
							If(LEqual(LTEN, One))
							{
								Store(One, FUN6)
							}
							If(LGreaterEqual(Arg1, 0x02))
							{
								If(CondRefOf(ECR1))
								{
									If(LEqual(ECR1, One))
									{
										If(LGreaterEqual(Arg1, 0x03))
										{
											Store(One, FUN8)
											Store(One, FUN9)
										}
									}
								}
							}
							ADBG(Concatenate("TBT RP OPTS -", ToHexString(OPTS)))
							Return(OPTS)
						}
						Else
						{
							If(LEqual(_T_0, 0x05))
							{
								If(LGreaterEqual(Arg1, One))
								{
									Return(One)
								}
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
									{
										Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
										Store(And(LMSL, 0x03FF), Index(LTRV, One))
										Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
										Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
										Return(LTRV)
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x08))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(One)
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x09))
										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
									}
								}
							}
						}
						Break
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Device(PXSX)
			{
				Name(_ADR, Zero)
				Method(_PRW, 0, NotSerialized)
				{
					If(CondRefOf(GP1E))
					{
						If(LNotEqual(GP1E, Zero))
						{
							Return(GPRW(0xC7, 0x04))
						}
					}
					Return(GPRW(0x69, 0x04))
				}
			}
			Method(_DSW, 3, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP _DSW TUID -", ToHexString(TUID)))
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				Store(Arg1, \_SB.PC00.TDM0.SD3C)
				Store(Arg1, \_SB.PC00.TDM1.SD3C)
				ADBG(Concatenate("TDM0 SD3C -", ToHexString(\_SB.PC00.TDM0.SD3C)))
				ADBG(Concatenate("TDM1 SD3C -", ToHexString(\_SB.PC00.TDM1.SD3C)))
				C2PM(Arg0, Arg1, Arg2, DCPM)
			}
			Method(_PRW, 0, NotSerialized)
			{
				If(CondRefOf(GP1E))
				{
					If(LNotEqual(GP1E, Zero))
					{
						Return(GPRW(0xC7, 0x04))
					}
				}
				Return(GPRW(0x69, 0x04))
			}
			Method(LTRC, 0, Serialized)
			{
				ADBG(Concatenate("TCSS RP LTREN check TUID -", ToHexString(TUID)))
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					ADBG(Concatenate("Current DCTL2 LTREN -", ToHexString(LNRE)))
					Store(One, HPSX)
					If(LEqual(LASX, Zero))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG(Concatenate("Toggle LTREN to TUID -", ToHexString(TUID)))
					}
				}
			}
			Method(CRPM, 0, Serialized)
			{
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					Return(D3HT)
				}
				Return(0xFF)
			}
			Method(HPEV, 0, Serialized)
			{
				If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), HPSX))
				{
					ADBG(Concatenate("HotPlug Event Start for ITBT Port - ", ToHexString(TUID)))
					If(LAnd(LEqual(PDCX, One), LEqual(DLSC, One)))
					{
						Store(One, PDCX)
						Store(One, HPSX)
						Notify(^, Zero)
					}
					Else
					{
						Store(One, HPSX)
					}
					ADBG(Concatenate("HotPlug Event End for ITBT Port - ", ToHexString(TUID)))
				}
			}
			Name(STAT, One)
			Method(D3CX, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdExit Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				ADBG(Concatenate("VDID -", ToHexString(VDID)))
				If(LEqual(STAT, One))
				{
					Return(Zero)
				}
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(Zero, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(Zero, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				Store(One, L23R)
				Store(Zero, Local0)
				Store(L23R, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23R, Local1)
				}
				ADBG(Concatenate("L23R -", ToHexString(L23R)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(One, STAT)
				Store(Zero, Local0)
				Store(LASX, Local1)
				If(LGreater(PLAT, Zero))
				{
					While(LEqual(Local1, Zero))
					{
						If(LGreater(Local0, PLAT))
						{
							Break
						}
						Sleep(0x05)
						Add(Local0, 0x05, Local0)
						Store(LASX, Local1)
					}
				}
				ADBG(Concatenate("LASX -", ToHexString(LASX)))
				ADBG(Concatenate("PLAT -", ToHexString(PLAT)))
				ADBG("TBT RP D3ColdExit End")
			}
			Method(D3CE, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdEntry Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				If(LEqual(STAT, Zero))
				{
					Return(Zero)
				}
				If(LOr(LEqual(LNSE, One), LEqual(LSOE, One)))
				{
					If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG("Toggle LNRE -")
					}
				}
				Store(One, L23E)
				Store(Zero, Local0)
				Store(L23E, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23E, Local1)
				}
				ADBG(Concatenate("L23E -", ToHexString(L23E)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(Zero, STAT)
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(One, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(One, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				ADBG(Concatenate("TBT RP D3ColdEntry End TUID -", ToHexString(TUID)))
			}
			Method(_PS0, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS0 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				HPEV()
				HPME()
				If(LEqual(PMEX, One))
				{
					ADBG("Disable PME SCI")
					Store(Zero, PMEX)
				}
				Sleep(PLAT)
				If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
				{
					If(LEqual(\_SB.PC00.TDM0.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM0.WACT)
						\_SB.PC00.TDM0.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM0.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM0.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM0.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				Else
				{
					If(LEqual(\_SB.PC00.TDM1.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM1.WACT)
						\_SB.PC00.TDM1.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM1.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM1.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM1.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				ADBG(Concatenate("TBT _PS0 End RP ", ToHexString(TUID)))
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS3 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				CHKH()
				If(LEqual(HPEX, Zero))
				{
					ADBG("Enable Hot Plug SCI")
					Store(One, HPEX)
					HPEV()
				}
				If(LEqual(PMEX, Zero))
				{
					ADBG("Enable PME SCI")
					Store(One, PMEX)
					HPME()
				}
				ADBG(Concatenate("TBT _PS3 End RP ", ToHexString(TUID)))
			}
			Method(CHKH, 0, NotSerialized)
			{
				If(LEqual(PDCX, One))
				{
					ADBG("PDC get set before enable HotPlug SCI")
					If(LEqual(DLSC, Zero))
					{
						ADBG("Clear PDC since it is not a real hotplug")
						Store(One, PDCX)
					}
				}
			}
			Method(_DSD, 0, NotSerialized)
			{
				ADBG("TBT RP _DSD")
				ADBG(Concatenate("TUID = ", ToHexString(TUID)))
				If(CondRefOf(U4CM))
				{
					If(LEqual(And(U4CM, 0x07), Zero))
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}
						})
					}
				}
				If(LAnd(LOr(LEqual(TUID, Zero), LEqual(TUID, One)), LEqual(DME0, One)))
				{
					Return(Package(6)
					{
						Buffer(0x10)
						{
							0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
							0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
						}, 
						Package(1)
						{
							Package(2) {"HotPlugSupportInD3", One}
						}, 
						Buffer(0x10)
						{
							0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
							0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
						}, 
						Package(2)
						{
							Package(2) {"ExternalFacingPort", One}, 
							Package(2) {"UID", TUID}
						}, 
						Buffer(0x10)
						{
							0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
							0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
						}, 
						Package(2)
						{
							Package(2) {"usb4-host-interface", \_SB.PC00.TDM0}, 
							Package(2) {"usb4-port-number", TUID}
						}
					})
				}
				Else
				{
					If(LAnd(LOr(LEqual(TUID, 0x02), LEqual(TUID, 0x03)), LEqual(DME1, One)))
					{
						Return(Package(6)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}, 
							Buffer(0x10)
							{
								0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
								0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
							}, 
							Package(2)
							{
								Package(2) {"usb4-host-interface", \_SB.PC00.TDM1}, 
								Package(2) {"usb4-port-number", TUID}
							}
						})
					}
					Else
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}
						})
					}
				}
			}
			Method(_S0W, 0, NotSerialized)
			{
				If(ITRT)
				{
					Return(0x04)
				}
				Else
				{
					Return(0x03)
				}
			}
			If(ITRT)
			{
				Method(_PR0, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(LOr(LEqual(\_SB.PC00.TDM0.SCME, One), LEqual(\_SB.PC00.TDM1.SCME, One)))
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
				Method(_PR3, 0, NotSerialized)
				{
					If(TRTD)
					{
						If(LOr(LEqual(\_SB.PC00.TDM0.SCME, One), LEqual(\_SB.PC00.TDM1.SCME, One)))
						{
							Return(Package(1) {\_SB.PC00.D3C})
						}
						If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT0})
						}
						Else
						{
							Return(Package(2) {\_SB.PC00.D3C, \_SB.PC00.TBT1})
						}
					}
					If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
					{
						Return(Package(1) {\_SB.PC00.TBT0})
					}
					Return(Package(1) {\_SB.PC00.TBT1})
				}
			}
			Method(HPME, 0, Serialized)
			{
				ADBG("TBT HPME")
				If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), LEqual(PMSX, One)))
				{
					ADBG("TBT RP exists")
					Notify(PXSX, 0x02)
					Store(One, PMSX)
					Store(One, PSPX)
					Return(One)
				}
				Return(Zero)
			}
			Name(AR01, Package(4)
			{
				Package(4) {0xFFFF, Zero, Zero, 0x10}, 
				Package(4) {0xFFFF, One, Zero, 0x11}, 
				Package(4) {0xFFFF, 0x02, Zero, 0x12}, 
				Package(4) {0xFFFF, 0x03, Zero, 0x13}
			})
			Method(_PRT, 0, NotSerialized)
			{
				Return(AR01)
			}
		}
		Device(TRP2)
		{
			Method(_ADR, 0, NotSerialized)
			{
				If(LNotEqual(TPA2, Zero))
				{
					ADBG(Concatenate("TRP2 _ADR", ToHexString(TPA2)))
					Return(TPA2)
				}
				Else
				{
					Return(0x00070002)
				}
			}
			Name(TUID, 0x02)
			Name(LTEN, Zero)
			Name(LMSL, 0x88C8)
			Name(LNSL, 0x88C8)
			Name(DCPM, 0x02)
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP2 _STA", ToHexString(TRE2)))
				If(LEqual(TRE2, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(_INI, 0, NotSerialized)
			{
				Store(LTE2, LTEN)
				Store(PSL2, LMSL)
				Store(PNS2, LNSL)
			}
			Name(PRTP, 0x08)
			Name(BCFG, Ones)
			Method(BASE, 0, NotSerialized)
			{
				If(LNotEqual(BCFG, Ones))
				{
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
				Else
				{
					Store(And(_ADR(), 0x07), Local0)
					Store(And(ShiftRight(_ADR(), 0x10), 0x1F), Local1)
					ADBG(Concatenate("BASE of ITBT Port ", ToHexString(TUID)))
					Add(ShiftLeft(Local0, 0x0C), ShiftLeft(Local1, 0x0F), Local2)
					Add(\_SB.PC00.GPCB(), Local2, Local3)
					Store(Local3, BCFG)
					ADBG(Concatenate("PCIe MMIO Address ", ToHexString(BCFG)))
					Return(BCFG)
				}
			}
			Method(GOPB, 1, NotSerialized)
			{
				Add(BASE(), Arg0, Local0)
				ADBG(Concatenate("TCSS PCIE RP register offset MMIO Address ", ToHexString(Local0)))
				Return(Local0)
			}
			OperationRegion(PXCS, SystemMemory, BASE, 0x0C00)
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x50),	//Offset(80),
				L0SE, 1,
				, 3,
				LDIS, 1,
				, 3,
				, 8,
				Offset(0x53),	//Offset(83),
				, 5,
				LASX, 1,
				Offset(0x5A),	//Offset(90),
				ABPX, 1,
				, 2,
				PDCX, 1,
				, 2,
				PDSX, 1,
				, 1,
				DLSC, 1,
				Offset(0x60),	//Offset(96),
				Offset(0x62),	//Offset(98),
				PSPX, 1,
				Offset(0xA4),	//Offset(164),
				D3HT, 2,
				Offset(0x328),	//Offset(808),
				STS1, 32,
			}
			OperationRegion(TPCS, SystemMemory, GOPB, 0x0420)
			0x04
			Field(TPCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x3),	//Offset(3),
				, 6,
				DPGE, 1,
			}
			OperationRegion(ADCS, SystemMemory, GOPB, 0x05BC)
			0x04
			Field(ADCS, AnyAcc, NoLock, Preserve)
			{
				, 3,
				RPER, 1,
				RPFE, 1,
			}
			OperationRegion(CCCS, SystemMemory, GOPB, RPCC)
			0x20
			Field(CCCS, AnyAcc, NoLock, WriteAsZeros)
			{
				Offset(0xC),	//Offset(12),
				Offset(0xF),	//Offset(15),
				, 6,
				HPSX, 1,
				PMSX, 1,
			}
			Field(CCCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x8),	//Offset(8),
				Offset(0xB),	//Offset(11),
				, 6,
				HPEX, 1,
				PMEX, 1,
				Offset(0x12),	//Offset(18),
				, 2,
				L23E, 1,
				L23R, 1,
			}
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				Offset(0x68),	//Offset(104),
				Offset(0x69),	//Offset(105),
				, 2,
				LNRE, 1,
				Offset(0x404),	//Offset(1028),
				LSOE, 1,
				LNSE, 1,
			}
			Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
			Method(_DSM, 4, Serialized)
			{
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
				{
					While(One)
					{
						Store(ToInteger(Arg2), _T_0)
						If(LEqual(_T_0, Zero))
						{
							Name(OPTS, Buffer(0x02)
							{
								0x00, 0x00
							})
							CreateBitField(OPTS,Zero,FUN0)
							CreateBitField(OPTS,0x05,FUN5)
							CreateBitField(OPTS,0x06,FUN6)
							CreateBitField(OPTS,0x08,FUN8)
							CreateBitField(OPTS,0x09,FUN9)
							Store(One, FUN0)
							Store(IORB, FUN5)
							If(LEqual(LTEN, One))
							{
								Store(One, FUN6)
							}
							If(LGreaterEqual(Arg1, 0x02))
							{
								If(CondRefOf(ECR1))
								{
									If(LEqual(ECR1, One))
									{
										If(LGreaterEqual(Arg1, 0x03))
										{
											Store(One, FUN8)
											Store(One, FUN9)
										}
									}
								}
							}
							ADBG(Concatenate("TBT RP OPTS -", ToHexString(OPTS)))
							Return(OPTS)
						}
						Else
						{
							If(LEqual(_T_0, 0x05))
							{
								If(LGreaterEqual(Arg1, One))
								{
									Return(One)
								}
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
									{
										Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
										Store(And(LMSL, 0x03FF), Index(LTRV, One))
										Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
										Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
										Return(LTRV)
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x08))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(One)
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x09))
										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
									}
								}
							}
						}
						Break
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
			Device(PXSX)
			{
				Name(_ADR, Zero)
				Method(_PRW, 0, NotSerialized)
				{
					If(CondRefOf(GP1E))
					{
						If(LNotEqual(GP1E, Zero))
						{
							Return(GPRW(0xC7, 0x04))
						}
					}
					Return(GPRW(0x69, 0x04))
				}
			}
			Method(_DSW, 3, NotSerialized)
			{
				ADBG(Concatenate("TCSS RP _DSW TUID -", ToHexString(TUID)))
				ADBG(Concatenate("Arg0 -", ToHexString(Arg0)))
				ADBG(Concatenate("Arg1 -", ToHexString(Arg1)))
				Store(Arg1, \_SB.PC00.TDM0.SD3C)
				Store(Arg1, \_SB.PC00.TDM1.SD3C)
				ADBG(Concatenate("TDM0 SD3C -", ToHexString(\_SB.PC00.TDM0.SD3C)))
				ADBG(Concatenate("TDM1 SD3C -", ToHexString(\_SB.PC00.TDM1.SD3C)))
				C2PM(Arg0, Arg1, Arg2, DCPM)
			}
			Method(_PRW, 0, NotSerialized)
			{
				If(CondRefOf(GP1E))
				{
					If(LNotEqual(GP1E, Zero))
					{
						Return(GPRW(0xC7, 0x04))
					}
				}
				Return(GPRW(0x69, 0x04))
			}
			Method(LTRC, 0, Serialized)
			{
				ADBG(Concatenate("TCSS RP LTREN check TUID -", ToHexString(TUID)))
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					ADBG(Concatenate("Current DCTL2 LTREN -", ToHexString(LNRE)))
					Store(One, HPSX)
					If(LEqual(LASX, Zero))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG(Concatenate("Toggle LTREN to TUID -", ToHexString(TUID)))
					}
				}
			}
			Method(CRPM, 0, Serialized)
			{
				If(LNotEqual(VDID, 0xFFFFFFFF))
				{
					Return(D3HT)
				}
				Return(0xFF)
			}
			Method(HPEV, 0, Serialized)
			{
				If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), HPSX))
				{
					ADBG(Concatenate("HotPlug Event Start for ITBT Port - ", ToHexString(TUID)))
					If(LAnd(LEqual(PDCX, One), LEqual(DLSC, One)))
					{
						Store(One, PDCX)
						Store(One, HPSX)
						Notify(^, Zero)
					}
					Else
					{
						Store(One, HPSX)
					}
					ADBG(Concatenate("HotPlug Event End for ITBT Port - ", ToHexString(TUID)))
				}
			}
			Name(STAT, One)
			Method(D3CX, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdExit Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				ADBG(Concatenate("VDID -", ToHexString(VDID)))
				If(LEqual(STAT, One))
				{
					Return(Zero)
				}
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(Zero, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(Zero, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				Store(One, L23R)
				Store(Zero, Local0)
				Store(L23R, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23R, Local1)
				}
				ADBG(Concatenate("L23R -", ToHexString(L23R)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(One, STAT)
				Store(Zero, Local0)
				Store(LASX, Local1)
				If(LGreater(PLAT, Zero))
				{
					While(LEqual(Local1, Zero))
					{
						If(LGreater(Local0, PLAT))
						{
							Break
						}
						Sleep(0x05)
						Add(Local0, 0x05, Local0)
						Store(LASX, Local1)
					}
				}
				ADBG(Concatenate("LASX -", ToHexString(LASX)))
				ADBG(Concatenate("PLAT -", ToHexString(PLAT)))
				ADBG("TBT RP D3ColdExit End")
			}
			Method(D3CE, 0, Serialized)
			{
				ADBG(Concatenate("TBT RP D3ColdEntry Start TUID -", ToHexString(TUID)))
				ADBG(Concatenate("RP STAT -", ToHexString(STAT)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				If(LEqual(STAT, Zero))
				{
					Return(Zero)
				}
				If(LOr(LEqual(LNSE, One), LEqual(LSOE, One)))
				{
					If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
					{
						Store(One, LNRE)
						Sleep(One)
						Store(Zero, LNRE)
						ADBG("Toggle LNRE -")
					}
				}
				Store(One, L23E)
				Store(Zero, Local0)
				Store(L23E, Local1)
				While(Local1)
				{
					If(LGreater(Local0, 0x64))
					{
						Break
					}
					Store(Zero, Local2)
					While(LLess(Local2, 0x0A))
					{
						Stall(0x64)
						Increment(Local2)
					}
					Increment(Local0)
					Store(L23E, Local1)
				}
				ADBG(Concatenate("L23E -", ToHexString(L23E)))
				ADBG(Concatenate("Loop -", ToHexString(Local0)))
				Store(Zero, STAT)
				ADBG(Concatenate("Original RPFE -", ToHexString(RPFE)))
				Store(One, RPFE)
				ADBG(Concatenate("RPFE -", ToHexString(RPFE)))
				ADBG(Concatenate("Original RPER -", ToHexString(RPER)))
				Store(One, RPER)
				ADBG(Concatenate("RPER -", ToHexString(RPER)))
				ADBG(Concatenate("TBT RP D3ColdEntry End TUID -", ToHexString(TUID)))
			}
			Method(_PS0, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS0 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				HPEV()
				HPME()
				If(LEqual(PMEX, One))
				{
					ADBG("Disable PME SCI")
					Store(Zero, PMEX)
				}
				Sleep(PLAT)
				If(LOr(LEqual(TUID, Zero), LEqual(TUID, One)))
				{
					If(LEqual(\_SB.PC00.TDM0.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM0.WACT)
						\_SB.PC00.TDM0.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM0.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM0.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM0.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				Else
				{
					If(LEqual(\_SB.PC00.TDM1.WACT, One))
					{
						Store(0x02, \_SB.PC00.TDM1.WACT)
						\_SB.PC00.TDM1.WFCC(ITCT)
						Store(Zero, \_SB.PC00.TDM1.WACT)
					}
					Else
					{
						If(LEqual(\_SB.PC00.TDM1.WACT, 0x02))
						{
							ADBG("Wait until other _PS0 get response")
							While(LNotEqual(\_SB.PC00.TDM1.WACT, Zero))
							{
								Sleep(0x05)
							}
							ADBG("Other _PS0 got response")
						}
					}
				}
				ADBG(Concatenate("TBT _PS0 End RP ", ToHexString(TUID)))
			}
			Method(_PS3, 0, Serialized)
			{
				ADBG(Concatenate("TBT _PS3 Start RP ", ToHexString(TUID)))
				ADBG(Concatenate("TBT RP VDID -", ToHexString(VDID)))
				CHKH()
				If(LEqual(HPEX, Zero))
				{
					ADBG("Enable Hot Plug SCI")
					Store(One, HPEX)
					HPEV()
				}
				If(LEqual(PMEX, Zero))
				{
					ADBG("Enable PME SCI")
					Store(One, PMEX)
					HPME()
				}
				ADBG(Concatenate("TBT _PS3 End RP ", ToHexString(TUID)))
			}
			Method(CHKH, 0, NotSerialized)
			{
				If(LEqual(PDCX, One))
				{
					ADBG("PDC get set before enable HotPlug SCI")
					If(LEqual(DLSC, Zero))
					{
						ADBG("Clear PDC since it is not a real hotplug")
						Store(One, PDCX)
					}
				}
			}
			Method(_DSD, 0, NotSerialized)
			{
				ADBG("TBT RP _DSD")
				ADBG(Concatenate("TUID = ", ToHexString(TUID)))
				If(CondRefOf(U4CM))
				{
					If(LEqual(And(U4CM, 0x07), Zero))
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}
						})
					}
				}
				If(LAnd(LOr(LEqual(TUID, Zero), LEqual(TUID, One)), LEqual(DME0, One)))
				{
					Return(Package(6)
					{
						Buffer(0x10)
						{
							0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
							0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
						}, 
						Package(1)
						{
							Package(2) {"HotPlugSupportInD3", One}
						}, 
						Buffer(0x10)
						{
							0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
							0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
						}, 
						Package(2)
						{
							Package(2) {"ExternalFacingPort", One}, 
							Package(2) {"UID", TUID}
						}, 
						Buffer(0x10)
						{
							0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
							0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
						}, 
						Package(2)
						{
							Package(2) {"usb4-host-interface", \_SB.PC00.TDM0}, 
							Package(2) {"usb4-port-number", TUID}
						}
					})
				}
				Else
				{
					If(LAnd(LOr(LEqual(TUID, 0x02), LEqual(TUID, 0x03)), LEqual(DME1, One)))
					{
						Return(Package(6)
						{
							Buffer(0x10)
							{
								0xC0, 0xE2, 0x11, 0x62, 0xA3, 0x58, 0xF3, 0x4A, 
								0x90, 0xE1, 0x92, 0x7A, 0x4E, 0x0C, 0x55, 0xA4
							}, 
							Package(1)
							{
								Package(2) {"HotPlugSupportInD3", One}
							}, 
							Buffer(0x10)
							{
								0xCC, 0x06, 0xCC, 0xEF, 0xAC, 0x73, 0xC3, 0x4B, 
								0xBF, 0xF0, 0x76, 0x14, 0x38, 0x07, 0xC3, 0x89
							}, 
							Package(2)
							{
								Package(2) {"ExternalFacingPort", One}, 
								Package(2) {"UID", TUID}
							}, 
							Buffer(0x10)
							{
								0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
								0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
							}, 
							Package(2)
							{
								Package(2) {"usb4-host-interface", \_SB.PC00.TDM1}, 
								Package(2) {"usb4-port-number", TUID}
							}
						})
