			If(LOr(LEqual(PC02.UM03, 0x02), LEqual(PC02.UM03, 0x03)))
			{
				Device(PUA3)
				{
					Name(_DDN, "MtlPchSerialIoUart3")
					Name(_UID, "MtlPchSerialIoUart3")
					Method(_HID, 0, NotSerialized)
					{
						Return(UHID)
						^^PC02.UM03
					}
					Method(UHID, 1, Serialized)
					{
						If(LEqual(Arg0, 0x03))
						{
							Return(EISAID("PNP0501"))
						}
						Return(EISAID("PNP0C02"))
					}
					Method(_CRS, 0, NotSerialized)
					{
						Return(UARH)
						^^PC02.UC03
						^^PC02.UI03
					}
					Method(UARH, 2, Serialized)
					{
						OperationRegion(UACF, SystemMemory, Arg0, 0x18)
						Field(UACF, AnyAcc, NoLock, Preserve)
						{
							Offset(0x10),	//Offset(16),
							BAR0, 64,
						}
						Name(BUF0, ResourceTemplate()
						{
							Memory32Fixed(ReadWrite, 0x00000000, 0x00000008)
						})
						Name(IBUF, ResourceTemplate()
						{
							Interrupt(ResourceConsumer, Level, ActiveLow, Shared,,,)
							{
								0x00000014
							}
						})
						CreateDWordField(BUF0, 0x04, ADR0)
						CreateDWordField(IBUF, 0x05, IRQN)
						Store(And(BAR0, 0x00FFFFFFFFFFFFF0), Local0)
						Store(Local0, ADR0)
						Store(Arg1, IRQN)
						ConcatenateResTemplate(BUF0, IBUF, Local1)
						Return(Local1)
					}
					Method(_STA, 0, NotSerialized)
					{
						If(LEqual(^^PC02.UM03, 0x03))
						{
							Return(0x0F)
						}
						Return(0x08)
					}
					Method(UPS3, 2, Serialized)
					{
						Name(REGS, Package(8) {Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero})
						If(LEqual(Arg0, One))
						{
							OperationRegion(UACF, SystemMemory, Arg1, 0x88)
							Field(UACF, AnyAcc, NoLock, Preserve)
							{
								Offset(0x10),	//Offset(16),
								BAR0, 64,
							}
							Field(UACF, ByteAcc, NoLock, Preserve)
							{
								Offset(0x84),	//Offset(132),
								PMEC, 8,
							}
							OperationRegion(UAB0, SystemMemory, And(BAR0, 0x00FFFFFFFFFFFFF0), 0x85)
							Field(UAB0, ByteAcc, Lock, Preserve)
							{
								DLL, 8,
								DLH, 8,
								FCR, 8,
								LCR, 8,
								MCR, 8,
								Offset(0x81),	//Offset(129),
								PPRR, 8,
							}
							Field(UAB0, DWordAcc, NoLock, Preserve)
							{
								Offset(0x80),	//Offset(128),
								PCLK, 32,
							}
							Store(LCR, Local1)
							Or(LCR, 0x80, LCR)
							Store(DLL, Index(REGS, Zero))
							Store(DLH, Index(REGS, One))
							Store(Local1, LCR)
							Store(FCR, Index(REGS, 0x02))
							Store(Local1, Index(REGS, 0x03))
							Store(MCR, Index(REGS, 0x04))
							Store(PCLK, Index(REGS, 0x05))
							If(LAnd(LNotEqual(DerefOf(Index(REGS, 0x05)), Zero), LNotEqual(DerefOf(Index(REGS, 0x05)), 0xFFFFFFFF)))
							{
								URSA
								And(BAR0, 0x00FFFFFFFFFFFFF0)
								REGS
							}
							Store(Zero, PPRR)
							Or(PPRR, Zero, PPRR)
							Store(0x03, PMEC)
							Or(PMEC, Zero, PMEC)
						}
					}
					Method(UPS0, 2, Serialized)
					{
						If(LEqual(Arg0, One))
						{
							OperationRegion(UACF, SystemMemory, Arg1, 0x88)
							Field(UACF, AnyAcc, NoLock, Preserve)
							{
								Offset(0x10),	//Offset(16),
								BAR0, 64,
							}
							Field(UACF, ByteAcc, NoLock, Preserve)
							{
								Offset(0x84),	//Offset(132),
								PMEC, 8,
							}
							OperationRegion(UAB0, SystemMemory, And(BAR0, 0x00FFFFFFFFFFFFF0), 0x85)
							Field(UAB0, ByteAcc, Lock, Preserve)
							{
								DLL, 8,
								DLH, 8,
								FCR, 8,
								LCR, 8,
								MCR, 8,
								Offset(0x81),	//Offset(129),
								PPRR, 8,
							}
							Field(UAB0, DWordAcc, NoLock, Preserve)
							{
								Offset(0x80),	//Offset(128),
								PCLK, 32,
							}
							Store(Zero, PMEC)
							Or(PMEC, Zero, PMEC)
							Store(0x07, PPRR)
							Store(URRS, NameObject)
							And(BAR0, 0x00FFFFFFFFFFFFF0)
							Local0
							If(LAnd(LNotEqual(DerefOf(Index(Local0, 0x05)), Zero), LNotEqual(DerefOf(Index(Local0, 0x05)), 0xFFFFFFFF)))
							{
								Or(LCR, 0x80, LCR)
								Store(DerefOf(Index(Local0, Zero)), DLL)
								Store(DerefOf(Index(Local0, One)), DLH)
								Store(DerefOf(Index(Local0, 0x03)), LCR)
								Store(DerefOf(Index(Local0, 0x02)), FCR)
								Store(DerefOf(Index(Local0, 0x04)), MCR)
								Or(DerefOf(Index(Local0, 0x05)), 0x80000001, Local2)
								Store(Local2, PCLK)
								Or(DerefOf(Index(Local0, 0x05)), One, Local2)
								Store(Local2, PCLK)
							}
						}
					}
					Method(UPSC, 1, Serialized)
					{
						OperationRegion(UACF, SystemMemory, Add(Arg0, 0x84), 0x04)
						Field(UACF, ByteAcc, NoLock, Preserve)
						{
							PMEC, 8,
						}
						Return(And(PMEC, 0x03))
					}
					If(LEqual(^PC02.UM03, 0x03))
					{
						Method(_PSC, 0, NotSerialized)
						{
							Return(UPSC)
							^^PC02.UC03
						}
						Method(_PS3, 0, NotSerialized)
						{
							UPS3
							^^PC02.UP03
							^^PC02.UC03
						}
						Method(_PS0, 0, NotSerialized)
						{
							UPS0
							^^PC02.UP03
							^^PC02.UC03
						}
					}
				}
			}
		}
		Scope(_SB.PC02)
		{
			If(LEqual(CRFP, One))
			{
				If(LEqual(CWFC, One))
				{
					Device(CNVW)
					{
						Name(_ADR, 0x00140003)
						Name(PU2C, Zero)
						Store(^PU2C, PU2C)
						Method(BASE, 0, NotSerialized)
						{
							Store(^^^PC00.PC2M(_ADR, PBSB), Local0)
							Return(Local0)
						}
						Method(_PS0, 0, Serialized)
						{
							ADBG("CNVW Ctrlr D0")
						}
						Method(_PS3, 0, Serialized)
						{
							ADBG("CNVW Ctrlr D3")
						}
						Method(_PRW, 0, NotSerialized)
						{
							Return(GPRW(0x6B, 0x04))
						}
						Name(ADEL, Zero)
						If(LEqual(ARLM, One))
						{
							Store(0x32, ADEL)
						}
						Else
						{
							Store(0x0A, ADEL)
						}
						Name(RSTT, Zero)
						Name(PRRS, Zero)
						OperationRegion(CWAR, SystemMemory, BASE, 0x0100)
						Field(CWAR, WordAcc, NoLock, Preserve)
						{
							VDID, 32,
							Offset(0x44),	//Offset(68),
							Offset(0x47),	//Offset(71),
							, 4,
							WFLR, 1,
							, 3,
							Offset(0x49),	//Offset(73),
							, 7,
							WIFR, 1,
						}
						Method(_S0W, 0, NotSerialized)
						{
							Return(0x03)
						}
						Method(_DSW, 3, NotSerialized)
						{
						}
						PowerResource(WRST, 5, 0)
						{
							Method(_STA, 0, NotSerialized)
							{
								Return(One)
							}
							Method(_ON, 0, NotSerialized)
							{
							}
							Method(_OFF, 0, NotSerialized)
							{
							}
							Method(_RST, 0, NotSerialized)
							{
								Store(Acquire(CNMT, 0x03E8), Local0)
								If(LEqual(Local0, Zero))
								{
									CFLR
									Store(One, PRRS)
									If(LAnd(CondRefOf(RSTT), LEqual(RSTT, One)))
									{
										ADBG("WiFi Product Reset")
										ADBG(Concatenate("PID of CNVi = ", ToHexString(PCNV)))
										Store(^^^SBPC.PCRR, PCNV)
										0x44
										Local5
										ADBG(Concatenate("Register PLDB Value = ", ToHexString(Local5)))
										If(LEqual(And(^^^SBPC.PCRR, PCNV, NameObject), 0x44))
										{
											0x02
											Zero
											Zero
											ADBG("ABORT_REQUEST = 0, previous PLDR completed")
											If(LEqual(GBTR(), One))
											{
												BTRK(Zero)
												Sleep(0xA0)
												Store(One, Local2)
											}
											^^^SBPC.PCRO
											PCNV
											0x44
											0x03
											ADBG(Concatenate("WiFi PLDR Timeout wait(ms) = ", ToHexString(ADEL)))
											Sleep(ADEL)
											Store(^^^SBPC.PCRR, PCNV)
											0x44
											Local1
											ADBG(Concatenate("CNVI_PLDR_ABORT = ", ToHexString(Local1)))
											If(LAnd(LEqual(And(Local1, 0x02), Zero), And(Local1, 0x04)))
											{
												ADBG("WiFi Product Reset Completed")
												Store(0x02, PRRS)
												If(LEqual(Local2, One))
												{
													BTRK(One)
													Sleep(0xA0)
												}
											}
											Else
											{
												Store(0x04, PRRS)
												BTRK(One)
											}
										}
										Else
										{
											Store(0x03, PRRS)
										}
									}
									ADBG(Concatenate("WiFi PRRS = ", PRRS))
									Release(CNMT)
								}
							}
						}
						Name(_PRR, Package(1) {WRST})
						Method(CFLR, 0, NotSerialized)
						{
							ADBG(Concatenate("WiFi Core Reset, WFLR = ", WFLR))
							If(LEqual(WFLR, One))
							{
								Store(One, WIFR)
							}
						}
					}
				}
			}
		}
		Scope(_SB.PC02)
		{
			Method(TINT, 1, Serialized)
			{
				Name(TINR, ResourceTemplate()
				{
					GpioInt(Level, ActiveLow, ExclusiveAndWake, PullUp, 0x0000, "\\_SB.PGPI", 0x00, ResourceConsumer,,)
					{
						0x0000
					}
				})
				CreateWordField(TINR, 0x17, INT1)
				Store(^^PGPI.GNUM, Arg0)
				INT1
				Return(TINR)
			}
