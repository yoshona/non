					OperationRegion(PDW1, SystemMemory, Local2, 0x04)
					Field(PDW1, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					Store(Arg1, TEMP)
				}
				Method(SRXO, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x3),	//Offset(3),
						, 4,
						TEMP, 1,
						, 3,
					}
					Store(Arg1, TEMP)
				}
				Method(GGIV, 1, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						, 1,
						TEMP, 1,
						Offset(0x4),	//Offset(4),
					}
					Return(TEMP)
				}
				Method(GGOV, 1, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						TEMP, 1,
						Offset(0x4),	//Offset(4),
					}
					Return(TEMP)
				}
				Method(SGOV, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						TEMP, 1,
						Offset(0x4),	//Offset(4),
					}
					Store(Arg1, TEMP)
				}
				Method(GGII, 1, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x2),	//Offset(2),
						, 7,
						TEMP, 1,
						, 8,
					}
					Return(TEMP)
				}
				Method(SGII, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x2),	//Offset(2),
						, 7,
						TEMP, 1,
						, 8,
					}
					Store(Arg1, TEMP)
				}
				Method(GPMV, 1, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x1),	//Offset(1),
						, 2,
						TEMP, 3,
						Offset(0x4),	//Offset(4),
					}
					Return(TEMP)
				}
				Method(SPMV, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x1),	//Offset(1),
						, 2,
						TEMP, 3,
						Offset(0x4),	//Offset(4),
					}
					Store(Arg1, TEMP)
				}
				Method(GHPO, 1, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					Add(GADR(Arg0, 0x02), Multiply(ShiftRight(Local1, 0x05), 0x04), Local3)
					And(Local1, 0x1F, Local4)
					OperationRegion(PREG, SystemMemory, Local3, 0x04)
					Field(PREG, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					Return(And(ShiftRight(TEMP, Local4), One))
				}
				Method(SHPO, 2, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					ADBG("Pad number")
					ADBG(ToHexString(Local1))
					Add(GADR(Arg0, 0x02), Multiply(ShiftRight(Local1, 0x05), 0x04), Local3)
					ADBG("HOST owner offset")
					ADBG(ToHexString(Local3))
					And(Local1, 0x1F, Local4)
					ADBG("Pad position")
					ADBG(ToHexString(Local4))
					OperationRegion(PREG, SystemMemory, Local3, 0x04)
					Field(PREG, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					ADBG("HOST own before")
					ADBG(ToHexString(TEMP))
					If(Arg1)
					{
						Or(TEMP, ShiftLeft(One, Local4), TEMP)
					}
					Else
					{
						And(TEMP, Not(ShiftLeft(One, Local4)), TEMP)
					}
					ADBG("HOST own after")
					ADBG(ToHexString(TEMP))
				}
				Method(GGPO, 1, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					Store(Add(GADR(Arg0, 0x03), Multiply(ShiftRight(Local1, 0x03), 0x04)), Local2)
					OperationRegion(PREG, SystemMemory, Local2, 0x04)
					Field(PREG, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					Return(And(ShiftRight(TEMP, Multiply(And(Local1, 0x07), 0x04)), 0x03))
				}
				Method(SGRA, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x2),	//Offset(2),
						, 4,
						TEMP, 1,
						Offset(0x4),	//Offset(4),
					}
					Store(Arg1, TEMP)
				}
				Method(SGWP, 2, Serialized)
				{
					Store(Add(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), 0x04), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x1),	//Offset(1),
						, 2,
						TEMP, 4,
						Offset(0x4),	//Offset(4),
					}
					Store(Arg1, TEMP)
				}
				Method(CGPI, 1, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					ADBG("Pad number")
					ADBG(ToHexString(Local1))
					Store(ShiftRight(Local1, 0x05), Local4)
					ADBG("Group DW")
					ADBG(ToHexString(Local4))
					Store(GADR(Arg0, 0x04), Local3)
					ADBG("Reg offset")
					ADBG(ToHexString(Local3))
					If(LNotEqual(And(Local3, 0xFFFF), 0xFFFF))
					{
						ADBG("Clearing GPI")
						OperationRegion(GPPX, SystemMemory, Add(Local3, Multiply(Local4, 0x04)), 0x04)
						Field(GPPX, AnyAcc, NoLock, Preserve)
						{
							STSX, 32,
						}
						ShiftLeft(One, Mod(Local1, 0x20), Local2)
						ADBG("STSX before")
						ADBG(ToHexString(STSX))
						Store(Local2, STSX)
						ADBG("STSX after")
						ADBG(ToHexString(STSX))
					}
				}
				Method(CAGS, 1, Serialized)
				{
					Store(GGGP(Arg0), Local0)
					Store(GNMB(Arg0), Local1)
					Store(ShiftRight(Local1, 0x05), Local4)
					If(LNot(Or(Or(LAnd(LEqual(GEI0, Local0), LEqual(GED0, Local4)), LAnd(LEqual(GEI1, Local0), LEqual(GED1, Local4))), LAnd(LEqual(GEI2, Local0), LEqual(GED2, Local4)))))
					{
						Store(GADR(Arg0, 0x04), Local3)
						If(LNotEqual(And(Local3, 0xFFFF), 0xFFFF))
						{
							OperationRegion(GPPX, SystemMemory, Add(Local3, Multiply(Local4, 0x04)), 0x04)
							Field(GPPX, AnyAcc, NoLock, Preserve)
							{
								STSX, 32,
							}
							ShiftLeft(One, Mod(Local1, 0x20), Local2)
							Store(Local2, STSX)
						}
					}
				}
				Method(IGPI, 1, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					Store(ShiftRight(Local1, 0x05), Local4)
					If(LEqual(And(GADR(Arg0, 0x04), 0xFFFF), 0xFFFF))
					{
						Return(Zero)
					}
					Add(GADR(Arg0, 0x04), Multiply(Local4, 0x04), Local2)
					And(Local1, 0x1F, Local3)
					OperationRegion(GPPX, SystemMemory, Local2, 0x24)
					Field(GPPX, AnyAcc, NoLock, Preserve)
					{
						STSX, 32,
						Offset(0x20),	//Offset(32),
						GENX, 32,
					}
					Return(And(ShiftRight(And(STSX, GENX), Local3), One))
				}
				Method(ISME, 1, Serialized)
				{
					Store(GGGP(Arg0), Local0)
					Store(GNMB(Arg0), Local1)
					Store(ShiftRight(Local1, 0x05), Local4)
					If(LNot(LNot(Or(Or(LAnd(LEqual(GEI0, Local0), LEqual(GED0, Local4)), LAnd(LEqual(GEI1, Local0), LEqual(GED1, Local4))), LAnd(LEqual(GEI2, Local0), LEqual(GED2, Local4))))))
					{
						Return(Zero)
					}
					If(LEqual(And(GADR(Arg0, 0x04), 0xFFFF), 0xFFFF))
					{
						Return(Zero)
					}
					Add(GADR(Arg0, 0x04), Multiply(Local4, 0x04), Local2)
					And(Local1, 0x1F, Local3)
					OperationRegion(GPPX, SystemMemory, Local2, 0x24)
					Field(GPPX, AnyAcc, NoLock, Preserve)
					{
						STSX, 32,
						Offset(0x20),	//Offset(32),
						GENX, 32,
					}
					Return(And(ShiftRight(And(STSX, GENX), Local3), One))
				}
				Method(GRXE, 2, Serialized)
				{
					Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
					OperationRegion(PDW0, SystemMemory, Local2, 0x04)
					Field(PDW0, AnyAcc, NoLock, Preserve)
					{
						Offset(0x3),	//Offset(3),
						, 1,
						RCFG, 2,
						, 5,
					}
					Store(Arg1, RCFG)
				}
				Method(GLOC, 2, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					Store(GADR(Arg0, 0x05), Local2)
					OperationRegion(PREG, SystemMemory, Local2, 0x04)
					Field(PREG, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					Return(And(ShiftRight(TEMP, Local1), One))
				}
				Method(GLOT, 2, Serialized)
				{
					Store(GNMB(Arg0), Local1)
					Store(GADR(Arg0, 0x06), Local2)
					OperationRegion(PREG, SystemMemory, Local2, 0x04)
					Field(PREG, AnyAcc, NoLock, Preserve)
					{
						TEMP, 32,
					}
					Return(And(ShiftRight(TEMP, Local1), One))
				}
			}
		}
		Scope(_SB)
		{
			Device(PCLK)
			{
				Name(_HID, EISAID("PNP0C02"))
				Name(_UID, "PCHCLK")
				Name(PID, 0xAD)
				Method(CLKD, 1, NotSerialized)
				{
					If(LGreater(Arg0, 0x06))
					{
						Add(Arg0, One, Local1)
						Subtract(Local1, 0x07, Local1)
						^^PC02.SBPC.PCRA
						PID
						0x8084
						Not(ShiftLeft(One, Local1))
					}
					Else
					{
						Add(Arg0, 0x02, Local1)
						^^PC02.SBPC.PCRA
						PID
						0x8080
						Not(ShiftLeft(One, Local1))
					}
				}
				Method(CLKE, 1, NotSerialized)
				{
					If(LGreater(Arg0, 0x06))
					{
						Add(Arg0, One, Local1)
						Subtract(Local1, 0x07, Local1)
						^^PC02.SBPC.PCRO
						PID
						0x8084
						ShiftLeft(One, Local1)
					}
					Else
					{
						Add(Arg0, 0x02, Local1)
						^^PC02.SBPC.PCRO
						PID
						0x8080
						ShiftLeft(One, Local1)
					}
				}
				Method(SPCO, 2, NotSerialized)
				{
					ADBG("Calling SPCO method to configure PCH PCIe ClkReq Override")
					If(LEqual(Arg1, One))
					{
						CLKE
						Arg0
					}
					Else
					{
						CLKD
						Arg0
					}
				}
			}
		}
	}
	Scope(_SB.PC00)
	{
		Scope(RP01)
		{
			Name(PBNU, Zero)
			Name(SLOT, One)
			Name(PRTP, 0x04)
			Name(LTEN, Zero)
			Name(LMSL, Zero)
			Name(LNSL, Zero)
			Method(_INI, 0, NotSerialized)
			{
				Store(LTR1, LTEN)
				Store(PML1, LMSL)
				Store(PNL1, LNSL)
				If(LAnd(CondRefOf(VMSP), CondRefOf(VMDE)))
				{
					If(LAnd(LEqual(VMDE, One), LNotEqual(And(VMSP, One), Zero)))
					{
						ADBG("RP01 (0/6/0) is mapped under VMD")
						Store(One, PRMV)
					}
				}
				If(PRES())
				{
					If(CondRefOf(PINI))
					{
						PINI
					}
				}
				If(CondRefOf(\_SB.PC00.RP01))
				{
					If(LNotEqual(VDID, 0xFFFFFFFF))
					{
						If(CondRefOf(\STD3))
						{
							If(CondRefOf(\_SB.PC00.RP01.PRMV))
							{
								If(LEqual(PRMV, One))
								{
									ADBG(Concatenate("VMD Storage Runtime D3 status:", ToHexString(RD3C)))
									Store(STD3, RD3C)
								}
							}
							If(LOr(^PXSX.PNVM(), ^PXSX.PAHC()))
							{
								ADBG(Concatenate("Storage Runtime D3 status:", ToHexString(RD3C)))
								Store(STD3, RD3C)
							}
						}
					}
				}
			}
			OperationRegion(PXCS, SystemMemory, PC2M(_ADR, PBNU), 0x0480)
			Field(PXCS, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x50),	//Offset(80),
				L0SE, 1,
				, 3,
				LDIS, 1,
				, 3,
				, 8,
				Offset(0x53),	//Offset(83),
				, 5,
				LASX, 1,
				Offset(0x5A),	//Offset(90),
				ABPX, 1,
				, 2,
				PDCX, 1,
				, 2,
				PDSX, 1,
				, 1,
				Offset(0x60),	//Offset(96),
				Offset(0x62),	//Offset(98),
				PSPX, 1,
				Offset(0x68),	//Offset(104),
				Offset(0x69),	//Offset(105),
				, 2,
				LNRE, 1,
				Offset(0xA4),	//Offset(164),
				D3HT, 2,
				Offset(0xD8),	//Offset(216),
				Offset(0xDB),	//Offset(219),
				, 6,
				HPEX, 1,
				PMEX, 1,
				Offset(0xE0),	//Offset(224),
				SCB0, 1,
				, 6,
				NCB7, 1,
				, 8,
				, 2,
				L23E, 1,
				L23R, 1,
				Offset(0x328),	//Offset(808),
				Offset(0x32B),	//Offset(811),
				LTSM, 8,
				Offset(0x404),	//Offset(1028),
				LSOE, 1,
				LNSE, 1,
			}
			Field(PXCS, AnyAcc, NoLock, WriteAsZeros)
			{
				Offset(0xDC),	//Offset(220),
				Offset(0xDF),	//Offset(223),
				, 6,
				HPSX, 1,
				PMSX, 1,
			}
			Method(L23D, 0, Serialized)
			{
				ADBG(Concatenate("PCIe RP LTSSM at L23D Start  -", ToHexString(LTSM)))
				If(LNotEqual(SCB0, One))
				{
					ADBG(Concatenate("PON SCB ", ToHexString(SLOT)))
					Return(Zero)
				}
				Store(One, L23R)
				Store(Zero, Local0)
				While(L23R)
				{
					If(LGreater(Local0, 0x04))
					{
						ADBG(Concatenate("PCIE L23R TO ", ToHexString(SLOT)))
						Break
					}
					Sleep(0x10)
					Increment(Local0)
				}
				Store(Zero, SCB0)
				Store(Zero, Local0)
				While(LEqual(LASX, Zero))
				{
					If(LGreater(Local0, 0x08))
					{
						ADBG(Concatenate("PCIE LASX TO ", ToHexString(SLOT)))
						Break
					}
					Sleep(0x10)
					Increment(Local0)
				}
				ADBG(Concatenate("PCIe RP LTSSM at L23D End -", ToHexString(LTSM)))
			}
			Method(DL23, 0, Serialized)
			{
				ADBG(Concatenate("PCIe RP LTSSM at DL23 Start -", ToHexString(LTSM)))
				If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
				{
					If(LOr(LEqual(LSOE, One), LEqual(LNSE, One)))
					{
						Store(One, LNRE)
						Store(Zero, Local0)
						Store(0xA0, Local1)
						While(LLess(Local0, Local1))
						{
							Add(Local0, One, Local0)
							Stall(0x64)
						}
						Store(Zero, LNRE)
						ADBG("Toggle LNRE")
					}
				}
				Store(One, L23E)
				Sleep(0x10)
				Store(Zero, Local0)
				While(L23E)
				{
					If(LGreater(Local0, 0x04))
					{
						ADBG(Concatenate("POF L23E TO", ToHexString(SLOT)))
						Break
					}
					Store(Zero, Local0)
					Store(0xA0, Local1)
					While(LLess(Local0, Local1))
					{
						Add(Local0, One, Local0)
						Stall(0x64)
					}
					Increment(Local0)
				}
				ADBG(Concatenate("POF RP ", ToHexString(SLOT)))
				Store(One, SCB0)
				ADBG(Concatenate("PCIe RP LTSSM at DL23 End -", ToHexString(LTSM)))
			}
			Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
			Name(PRMV, Zero)
			Name(RD3C, 0x02)
			Method(PRES, 0, NotSerialized)
			{
				If(LEqual(VDID, 0xFFFFFFFF))
				{
					Return(Zero)
				}
				Else
				{
					Return(One)
				}
			}
			Method(_DSM, 4, Serialized)
			{
				Name(_T_0, Zero)
				If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
				{
					While(One)
					{
						Store(ToInteger(Arg2), _T_0)
						If(LEqual(_T_0, Zero))
						{
							Name(OPTS, Buffer(0x02)
							{
								0x00, 0x00
							})
							CreateBitField(OPTS,Zero,FUN0)
							CreateBitField(OPTS,0x06,FUN6)
							CreateBitField(OPTS,0x08,FUN8)
							CreateBitField(OPTS,0x09,FUN9)
							CreateBitField(OPTS,0x0A,FUNA)
							CreateBitField(OPTS,0x0B,FUNB)
							If(LGreaterEqual(Arg1, 0x02))
							{
								Store(One, FUN0)
								If(LNotEqual(LTEN, Zero))
								{
									Store(One, FUN6)
								}
								If(CondRefOf(ECR1))
								{
									If(LEqual(ECR1, One))
									{
										If(LGreaterEqual(Arg1, 0x03))
										{
											Store(One, FUN8)
											Store(One, FUN9)
										}
									}
								}
							}
							If(LGreaterEqual(Arg1, 0x04))
							{
								If(CondRefOf(PPBA))
								{
									Store(One, FUNA)
								}
								If(CondRefOf(UPRD))
								{
									Store(One, FUNB)
								}
							}
							ADBG(Concatenate("_DSM PCIe RP OPTS -", ToHexString(OPTS)))
							Return(OPTS)
						}
						Else
						{
							If(LEqual(_T_0, 0x06))
							{
								If(LGreaterEqual(Arg1, 0x02))
								{
									Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
									Store(And(LMSL, 0x03FF), Index(LTRV, One))
									Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
									Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
									Return(LTRV)
								}
							}
							Else
							{
								If(LEqual(_T_0, 0x08))
								{
									If(CondRefOf(ECR1))
									{
										If(LEqual(ECR1, One))
										{
											If(LGreaterEqual(Arg1, 0x03))
											{
												Return(One)
											}
										}
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x09))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x0A))
										{
											If(CondRefOf(PPBA))
											{
												Return(PPBA)
												Arg3
											}
										}
										Else
										{
											If(LEqual(_T_0, 0x0B))
											{
												If(CondRefOf(UPRD))
												{
