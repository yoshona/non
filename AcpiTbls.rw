		{
			Name(_T_1, "")
			Name(_T_0, "")
			While(One)
			{
				Store(ShiftLeft(Arg0, Ones), _T_0)
				If(LEqual(_T_0, "IETM"))
				{
					Notify(\_SB.IETM, Arg1)
				}
				Else
				{
					If(LEqual(_T_0, "TCPU"))
					{
						Notify(\_SB.PC00.TCPU, Arg1)
					}
				}
				Break
			}
			If(\ECON)
			{
				While(One)
				{
					Store(ShiftLeft(Arg0, Ones), _T_1)
					If(LEqual(_T_1, "CHRG"))
					{
						Notify(\_SB.IETM.CHRG, Arg1)
					}
					Else
					{
						If(LEqual(_T_1, "SEN2"))
						{
							Notify(\_SB.IETM.SEN2, Arg1)
						}
						Else
						{
							If(LEqual(_T_1, "SEN3"))
