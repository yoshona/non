		Mutex(ECM9, 0)
		Device(AC0)
		{
			Name(_HID, "ACPI0003")
			Name(_PCL, Package(1) {_SB})
			Method(_PSR, 0, NotSerialized)
			{
				If(LEqual(Acquire(ECM5, 0x01F4), Zero))
				{
					Store(0xB2, ^^PC00.LPCB.IO80)
					If(ECON)
					{
						Store(^^PC00.LPCB.EC0.XCIN, Local0)
					}
					Else
					{
						Store(One, Local0)
					}
					If(^^PC00.LPCB.EC0.HPEN)
					{
						Store(One, Local0)
					}
					Release(ECM5)
				}
				Return(Local0)
			}
		}
		Device(BAT0)
		{
			Name(_HID, EISAID("PNP0C0A"))
			Name(_UID, Zero)
			Name(_PCL, Package(1) {_SB})
			Method(_BIF, 0, NotSerialized)
			{
				Name(PAK0, Package(13)
				{
					One, 0x0C56, 0x0C56, Zero, 0x2A30, Zero, Zero, 0x10, 0x08, "standard",
					"00001", "LiON", "OEM"
				})
				If(ECON)
				{
					Acquire(MUEX, 0xFFFF)
					Store("ECBE", Debug)
					Store(^^PC00.LPCB.EC0.XIF1, Index(PAK0, One))
					If(LEqual(^^PC00.LPCB.EC0.ISDB, One))
					{
						If(LGreaterEqual(^^PC00.LPCB.EC0.CYCN, 0x32))
						{
							Store(^^PC00.LPCB.EC0.XIF2, Index(PAK0, 0x02))
						}
						Else
						{
							Store(^^PC00.LPCB.EC0.XIF1, Index(PAK0, 0x02))
						}
					}
					Else
					{
						Store(^^PC00.LPCB.EC0.XIF2, Index(PAK0, 0x02))
					}
					Store(^^PC00.LPCB.EC0.XIF3, Index(PAK0, 0x03))
					Store(^^PC00.LPCB.EC0.XIF4, Index(PAK0, 0x04))
					Store(^^PC00.LPCB.EC0.XIF7, Index(PAK0, 0x07))
					Release(MUEX)
				}
				Else
				{
					Store(0xFFFFFFFF, Index(PAK0, One))
					Store(0xFFFFFFFF, Index(PAK0, 0x02))
					Store(0xFFFFFFFF, Index(PAK0, 0x04))
					Store("Error", Index(PAK0, 0x09))
					Store("00000", Index(PAK0, 0x0A))
					Store("Error", Index(PAK0, 0x0B))
					Store("Error", Index(PAK0, 0x0C))
				}
				Return(PAK0)
			}
			Name(BFB0, Package(4) {Zero, Zero, Zero, Zero})
			Method(_BST, 0, NotSerialized)
			{
				If(LEqual(Acquire(ECM1, 0x01F4), Zero))
				{
					Store("BST1 Start", Debug)
					If(LEqual(^^PC00.LPCB.EC0.BSOK, One))
					{
						If(LAnd(LLessEqual(^^PC00.LPCB.EC0.CGLM, 0x63), LGreaterEqual(^^PC00.LPCB.EC0.CGLM, One)))
						{
							Store(^^PC00.LPCB.EC0.XST0, Local0)
							Or(Local0, 0x08, Local0)
							Store(Local0, Index(BFB0, Zero))
						}
						Else
						{
							Store(^^PC00.LPCB.EC0.XST0, Index(BFB0, Zero))
						}
						Store(^^PC00.LPCB.EC0.XST1, Index(BFB0, One))
						If(LEqual(^^PC00.LPCB.EC0.ISDB, One))
						{
							If(LGreaterEqual(^^PC00.LPCB.EC0.CYCN, 0x32))
							{
								Store(^^PC00.LPCB.EC0.XST2, Index(BFB0, 0x02))
							}
							Else
							{
								Store(Multiply(^^PC00.LPCB.EC0.XST2, ^^PC00.LPCB.EC0.XIF1), Local0)
								Store(^^PC00.LPCB.EC0.XIF2, Local1)
								Store(Divide(Local0, Local1, , ), Index(BFB0, 0x02))
							}
						}
						Else
						{
							Store(^^PC00.LPCB.EC0.XST2, Index(BFB0, 0x02))
						}
						Store(^^PC00.LPCB.EC0.XST3, Index(BFB0, 0x03))
					}
					Store("BST1 End", Debug)
				}
				Release(ECM1)
				Return(BFB0)
			}
			Method(_STA, 0, NotSerialized)
			{
				Store("BAT0_STA Start", Debug)
				If(LOr(LEqual(BAEX, Zero), LEqual(DA18, One)))
				{
					Return(Zero)
				}
				Else
				{
					If(ECON)
					{
						If(LEqual(Acquire(ECM6, 0x01F4), Zero))
						{
							Store(^^PC00.LPCB.EC0.BPST, Local0)
							Release(ECM6)
						}
						If(LEqual(Local0, One))
						{
							Return(0x1F)
						}
						Else
						{
							Return(0x0F)
						}
					}
					Else
					{
						Return(0x0F)
					}
				}
				Store("BAT0_STA END", Debug)
			}
			Method(_BTP, 1, NotSerialized)
			{
				Store(Arg0, Local0)
				If(LEqual(^^PC00.LPCB.EC0.BSOK, One))
				{
					If(LEqual(^^PC00.LPCB.EC0.ISDB, One))
					{
						If(LGreaterEqual(^^PC00.LPCB.EC0.CYCN, 0x32))
						{
							Store(Local0, ^^PC00.LPCB.EC0.BTP0)
						}
						Else
						{
							Store(Multiply(Local0, ^^PC00.LPCB.EC0.XIF2), Local1)
							Store(^^PC00.LPCB.EC0.XIF1, Local2)
							Store(Divide(Local1, Local2, , ), ^^PC00.LPCB.EC0.BTP0)
						}
					}
					Else
					{
						Store(Local0, ^^PC00.LPCB.EC0.BTP0)
					}
				}
			}
		}
		ThermalZone(ECTZ)
		{
			Method(_CRT, 0, Serialized)
			{
				Return(0x0F20)
			}
			Method(_TMP, 0, Serialized)
			{
				If(LEqual(ECON, Zero))
				{
					Return(0x0BC2)
				}
				If(LEqual(Acquire(ECM7, 0x01F4), Zero))
				{
					If(LNotEqual(^^PC00.LPCB.EC0.THOT, Zero))
					{
						Store(Zero, ^^PC00.LPCB.EC0.THOT)
						Release(ECM7)
						Return(0x0FA0)
					}
					Else
					{
						Release(ECM7)
						Return(Add(0x0AAC, Multiply(^^PC00.LPCB.EC0.XHPP, 0x0A)))
					}
				}
			}
		}
	}
}

