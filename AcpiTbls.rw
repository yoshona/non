											Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), And(Arg1, 0x03)), CLK5)
										}
									}
								}
							}
						}
					}
					Break
				}
			}
			Method(_STA, 0, NotSerialized)
			{
				Return(0x03)
			}
			Name(PID, 0x64)
			Method(CLKD, 1, NotSerialized)
			{
				^^PC00.SBSC.PCRA(PID, 0x8080, Not(ShiftLeft(One, Arg0)))
			}
			Method(CLKE, 1, NotSerialized)
			{
				^^PC00.SBSC.PCRO(PID, 0x8080, ShiftLeft(One, Arg0))
			}
		}
