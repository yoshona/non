		Method(SWUB, 4, Serialized)
		{
			If(CondRefOf(\_SB.PC00.LPCB.H_EC.DUMY))
			{
				If(LOr(LEqual(Arg0, 0x03), LEqual(Arg0, 0x04)))
				{
					If(And(Arg1, 0x40))
					{
						If(And(Arg2, 0x08))
						{
							^H_EC.DUMY.UPBT
							0x06
							One
						}
						Else
						{
							^H_EC.DUMY.UPBT
							0x06
							Zero
						}
					}
					If(And(Arg1, 0x80))
					{
						If(And(Arg2, 0x10))
						{
							^H_EC.DUMY.UPBT
							0x07
							One
						}
						Else
						{
							^H_EC.DUMY.UPBT
							0x07
							Zero
						}
					}
					Store(One, ^H_EC.DUMY.ONTM)
					Store(^H_EC.DUMY.ERLD, LIDS)
					If(Arg3)
					{
						If(LEqual(LIDS, Zero))
						{
							Store(0x80000000, ^^GFX0.CLID)
						}
						If(LEqual(LIDS, One))
						{
							Store(0x80000003, ^^GFX0.CLID)
						}
					}
					Notify(^H_EC.DUMY.LID0, 0x80)
					Store(^H_EC.DUMY.ERB1, Local0)
					Store(ShiftRight(And(Local0, 0x08), 0x03), ^H_EC.DUMY.BNUM)
					ADBG(Concatenate("BNUM resume from Sx: ", ToHexString(^H_EC.DUMY.BNUM)))
