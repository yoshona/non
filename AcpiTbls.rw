						Store(I5BS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x03))
					{
						Store(UHBS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x06))
					{
						Store(AXMU, Local0)
						ShiftLeft(Local0, One, Local0)
						Or(Local0, AXSU, Local0)
						Store(AXMR, Local1)
						ShiftLeft(Local1, One, Local1)
						Or(Local1, AXSR, Local1)
						ShiftLeft(Local1, 0x02, Local1)
						Or(Local0, Local1, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x04))
