			Method(CLKC, 2, Serialized)
			{
				Name(_T_0, Zero)
				While(One)
				{
					Store(ToInteger(Arg0), _T_0)
					If(LEqual(_T_0, Zero))
					{
						Store(CLK0, Local0)
						Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK0)
					}
					Else
					{
						If(LEqual(_T_0, One))
						{
							Store(CLK1, Local0)
							Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK1)
						}
						Else
						{
							If(LEqual(_T_0, 0x02))
							{
								Store(CLK2, Local0)
								Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK2)
							}
							Else
							{
								If(LEqual(_T_0, 0x03))
								{
									Store(CLK3, Local0)
									Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK3)
								}
								Else
								{
									If(LEqual(_T_0, 0x04))
									{
										Store(CLK4, Local0)
										Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK4)
									}
									Else
									{
										If(LEqual(_T_0, 0x05))
										{
											Store(CLK5, Local0)
											Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), ShiftLeft(Arg1, 0x02)), CLK5)
										}
