					Store(SD78, Index(DerefOf(Index(WGDY, One)), 0x3F))
					Store(SD79, Index(DerefOf(Index(WGDY, One)), 0x40))
					Store(SD81, Index(DerefOf(Index(WGDY, One)), 0x41))
					Store(SD82, Index(DerefOf(Index(WGDY, One)), 0x42))
					Store(SD83, Index(DerefOf(Index(WGDY, One)), 0x43))
					Store(SD84, Index(DerefOf(Index(WGDY, One)), 0x44))
					Store(SD85, Index(DerefOf(Index(WGDY, One)), 0x45))
					Store(SD86, Index(DerefOf(Index(WGDY, One)), 0x46))
					Store(SD87, Index(DerefOf(Index(WGDY, One)), 0x47))
					Store(SD88, Index(DerefOf(Index(WGDY, One)), 0x48))
					Store(SD89, Index(DerefOf(Index(WGDY, One)), 0x49))
					Return(WGDY)
				}
				Name(ECKY, Package(2)
				{
					Zero, 
					Package(2) {0x07, Zero}
				})
				Method(ECKV, 0, Serialized)
				{
					Store(CECV, Index(DerefOf(Index(ECKY, One)), One))
					Return(ECKY)
				}
				Name(PPAY, Package(2)
				{
					0x02, 
					Package(24)
					{
						0x07, Zero, 0x18, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28,
						0x28, 0x28, 0x18, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28, 0x28,
						0x28, 0x28
					}
				})
				Method(PPAG, 0, Serialized)
				{
					Store(WAGM, Index(DerefOf(Index(PPAY, One)), One))
					Store(AGA1, Index(DerefOf(Index(PPAY, One)), 0x02))
					Store(AGA2, Index(DerefOf(Index(PPAY, One)), 0x03))
					Store(AGA3, Index(DerefOf(Index(PPAY, One)), 0x04))
					Store(AGA4, Index(DerefOf(Index(PPAY, One)), 0x05))
					Store(AGA5, Index(DerefOf(Index(PPAY, One)), 0x06))
					Store(AGA6, Index(DerefOf(Index(PPAY, One)), 0x07))
					Store(AGA7, Index(DerefOf(Index(PPAY, One)), 0x08))
					Store(AGA8, Index(DerefOf(Index(PPAY, One)), 0x09))
					Store(AGA9, Index(DerefOf(Index(PPAY, One)), 0x0A))
					Store(AGAA, Index(DerefOf(Index(PPAY, One)), 0x0B))
					Store(AGAB, Index(DerefOf(Index(PPAY, One)), 0x0C))
					Store(AGB1, Index(DerefOf(Index(PPAY, One)), 0x0D))
					Store(AGB2, Index(DerefOf(Index(PPAY, One)), 0x0E))
					Store(AGB3, Index(DerefOf(Index(PPAY, One)), 0x0F))
					Store(AGB4, Index(DerefOf(Index(PPAY, One)), 0x10))
					Store(AGB5, Index(DerefOf(Index(PPAY, One)), 0x11))
					Store(AGB6, Index(DerefOf(Index(PPAY, One)), 0x12))
					Store(AGB7, Index(DerefOf(Index(PPAY, One)), 0x13))
					Store(AGB8, Index(DerefOf(Index(PPAY, One)), 0x14))
					Store(AGB9, Index(DerefOf(Index(PPAY, One)), 0x15))
					Store(AGBA, Index(DerefOf(Index(PPAY, One)), 0x16))
					Store(AGBB, Index(DerefOf(Index(PPAY, One)), 0x17))
					Return(PPAY)
				}
				Name(WPFY, Package(2)
				{
					Zero, 
					Package(5) {0x07, Zero, Zero, Zero, Zero}
				})
				Method(WPFC, 0, Serialized)
				{
					Store(WPFA, Index(DerefOf(Index(WPFY, One)), One))
					Store(WPFB, Index(DerefOf(Index(WPFY, One)), 0x02))
					Store(\WPFC, Index(DerefOf(Index(WPFY, One)), 0x03))
					Store(WPFD, Index(DerefOf(Index(WPFY, One)), 0x04))
					Return(WPFY)
				}
				Name(WTSY, Package(2)
				{
					One, 
					Package(19)
					{
						0x07, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero,
						Zero, Zero, Zero, Zero, Zero, Zero, Zero, Zero
					}
				})
				Method(WTAS, 0, Serialized)
				{
					Store(WTSE, Index(DerefOf(Index(WTSY, One)), One))
					Store(WTLE, Index(DerefOf(Index(WTSY, One)), 0x02))
					Store(BL01, Index(DerefOf(Index(WTSY, One)), 0x03))
					Store(BL02, Index(DerefOf(Index(WTSY, One)), 0x04))
					Store(BL03, Index(DerefOf(Index(WTSY, One)), 0x05))
					Store(BL04, Index(DerefOf(Index(WTSY, One)), 0x06))
					Store(BL05, Index(DerefOf(Index(WTSY, One)), 0x07))
					Store(BL06, Index(DerefOf(Index(WTSY, One)), 0x08))
					Store(BL07, Index(DerefOf(Index(WTSY, One)), 0x09))
					Store(BL08, Index(DerefOf(Index(WTSY, One)), 0x0A))
					Store(BL09, Index(DerefOf(Index(WTSY, One)), 0x0B))
					Store(BL10, Index(DerefOf(Index(WTSY, One)), 0x0C))
					Store(BL11, Index(DerefOf(Index(WTSY, One)), 0x0D))
					Store(BL12, Index(DerefOf(Index(WTSY, One)), 0x0E))
					Store(BL13, Index(DerefOf(Index(WTSY, One)), 0x0F))
					Store(BL14, Index(DerefOf(Index(WTSY, One)), 0x10))
					Store(BL15, Index(DerefOf(Index(WTSY, One)), 0x11))
					Store(BL16, Index(DerefOf(Index(WTSY, One)), 0x12))
					Return(WTSY)
				}
				Name(WAIY, Package(2)
				{
					Zero, 
					Package(4) {0x07, Zero, Zero, Zero}
				})
				Method(WAIS, 0, Serialized)
				{
					Store(WLBI, Index(DerefOf(Index(WAIY, One)), One))
					Store(WHBI, Index(DerefOf(Index(WAIY, One)), 0x02))
					Return(WAIY)
				}
				Name(SADX, Package(3)
				{
					Zero, 
					Package(2) {0x07, 0x80000000}, 
					Package(2) {0x12, 0x80000000}
				})
				Method(SADS, 0, Serialized)
				{
					Store(ATDV, Index(DerefOf(Index(SADX, One)), One))
					Store(ATDV, Index(DerefOf(Index(SADX, 0x02)), One))
					Return(SADX)
				}
				Name(GPCX, Package(3)
				{
					Zero, 
					Package(2)
					{
						0x07, 
						Package(3) {Zero, Zero, Zero}
					}, 
					Package(2)
					{
						0x12, 
						Package(3) {Zero, Zero, Zero}
					}
				})
				Method(GPC, 0, Serialized)
				{
					Return(GPCX)
				}
				Name(GLAX, Package(3)
				{
					Zero, 
					Package(2) {0x07, Zero}, 
					Package(2) {0x12, Zero}
				})
				Method(GLAI, 0, Serialized)
				{
					ADBG(Concatenate("AR: GLAI method. CGLS = ", ToHexString(CGLS)))
					Store(CGLS, Index(DerefOf(Index(GLAX, One)), One))
					Store(CGLS, Index(DerefOf(Index(GLAX, 0x02)), One))
					Return(GLAX)
				}
			}
			If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
			{
				Method(FHRF, 1, NotSerialized)
				{
					If(LNotEqual(^^^^PGPI.GGOV, PRST))
					{
						WPRP
						DL23
						ADBG("WWAN DL23() Done")
						^^^^PGPI.SGOV
						PRST
						WPRP
						ADBG("WWAN PERST:0 Done")
					}
					Else
					{
						ADBG("Assume WWAN DL23() is already done")
					}
					Sleep(TR2B)
					^^^^PGPI.SGOV
					WBRS
					PBRS
					ADBG("WWAN RST:0 Done")
					If(LEqual(Arg0, Zero))
					{
						Sleep(TBTG)
						ADBG(Concatenate("SLP TBTG ", ToDecimalString(TBTG)))
					}
					Else
					{
						If(LEqual(Arg0, One))
						{
							SPCO(WCLK, Zero)
							ADBG("WWAN SCLK:0 Done")
							Sleep(TB2F)
							ADBG(Concatenate("SLP TB2F ", ToDecimalString(TB2F)))
							^^^^PGPI.SGOV
							WFCP
							And(Not(PFCP), One)
							ADBG("WWAN PWR:0 Done")
							Sleep(TFDI)
							ADBG(Concatenate("SLP TFDI ", ToDecimalString(TFDI)))
						}
						Else
						{
							ADBG("Unsupported Arg0 is detected.")
						}
					}
				}
				Method(SHRF, 0, NotSerialized)
				{
					PSD0(SLOT)
					ADBG("WWAN MPHYPG:0 Done")
					SPCO(WCLK, One)
					ADBG("WWAN SCLK:1 Done")
					^^^^PGPI.SGOV
					WFCP
					PFCP
					ADBG("WWAN PWR:1 Done")
					Sleep(TN2B)
					ADBG(Concatenate("SLP TN2B ", ToDecimalString(TN2B)))
					^^^^PGPI.SGOV
					WBRS
					And(Not(PBRS), One)
					ADBG("WWAN RST:1 Done")
					Sleep(TB2R)
					ADBG(Concatenate("SLP TB2R ", ToDecimalString(TB2R)))
					^^^^PGPI.SGOV
					PRST
					And(Not(WPRP), One)
					ADBG("WWAN PERST:0 Done")
					L23D
					ADBG("WWAN L23D() Done")
				}
				Method(DOSV, 0, NotSerialized)
				{
					Store(Zero, Local0)
					While(LAnd(LNotEqual(SVID, WSID), LLess(Local0, WSTO)))
					{
						Increment(Local0)
						Sleep(One)
					}
					ADBG(Concatenate("DET Time ", ToDecimalString(Local0)))
				}
				Method(_RST, 0, Serialized)
				{
					ADBG("_RST WWAN")
					If(LEqual(WWEN, 0x02))
					{
						Store(Acquire(WWMT, 0x03E8), Local0)
						ADBG("WWAN FLDR Mutex: Acquired Try Done")
						If(LEqual(Local0, Zero))
						{
							ADBG("Start WWAN FLDR")
							FHRF
							Zero
							SHRF
							ADBG("End WWAN FLDR")
							Release(WWMT)
							ADBG("WWAN FLDR Mutex:Release Done")
							DOSV
						}
					}
					Else
					{
						^^^^PGPI.SGOV
						WBRS
						PBRS
						Sleep(0xC8)
						Notify(PXSX, One)
						^^^^PGPI.SGOV
						PRST
						And(Not(WPRP), One)
						^^^^PGPI.SGOV
						WBRS
						And(Not(PBRS), One)
						Sleep(0xC8)
						Store(Zero, Local0)
						While(LEqual(LASX, Zero))
						{
							If(LGreater(Local0, 0x14))
							{
								ADBG("FLDR TO")
								Break
							}
							Sleep(0x10)
							Increment(Local0)
						}
						Sleep(0x0A)
						ADBG(Concatenate("RVP Delay Time ", ToDecimalString(Local0)))
						Notify(PXSX, One)
					}
				}
				PowerResource(MRST, 5, 0)
				{
					Method(_STA, 0, Serialized)
					{
						ADBG("WWAN PR _STA")
						Return(One)
					}
					Method(_ON, 0, Serialized)
					{
						ADBG("WWAN PR _ON")
					}
					Method(_OFF, 0, Serialized)
					{
						ADBG("WWAN PR _OFF")
					}
					Method(_RST, 0, Serialized)
					{
						Store(Acquire(WWMT, 0x03E8), Local0)
						ADBG("WWAN PLDR Mutex: Acquired Try Done")
						If(LEqual(Local0, Zero))
						{
							ADBG("Start WWAN PLDR")
							FHRF
							One
							SHRF
							ADBG("End WWAN PR _RST")
							Release(WWMT)
							ADBG("WWAN PLDR Mutex: Release Done")
							DOSV
						}
					}
				}
			}
			If(LOr(WIST, LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT))))
			{
				Method(_PRR, 0, NotSerialized)
				{
					If(WIST)
					{
						If(CondRefOf(WRST))
						{
							Return(Package(1) {WRST})
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(CondRefOf(MRST))
						{
							Return(Package(1) {MRST})
						}
					}
					Return(Package(1) {WRST})
				}
				Name(FDEL, Zero)
				Name(PDEL, Zero)
				Name(VDEL, Zero)
				Method(IFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(One)
							{
								0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						ADBG(Concatenate("vPro: ", CVPR))
						ShiftLeft(CVPR, Zero, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x02))
					{
						CreateWordField(Arg3, Zero, CMDT)
						CreateWordField(Arg3, 0x02, CMDP)
						ADBG(Concatenate("CmdType = ", ToHexString(CMDT)))
						ADBG(Concatenate("CmdPayload = ", ToHexString(CMDP)))
						If(LEqual(CMDT, One))
						{
							If(WIST)
							{
								Return(RSTY)
							}
							Else
							{
								If(CondRefOf(\_SB.PC02.CNVW.RSTT))
								{
									ADBG(Concatenate("Get _PRR Mode = ", ^^^CNVW.RSTT))
									Return(^^^CNVW.RSTT)
								}
								Else
								{
									Return(Zero)
								}
							}
						}
						If(LEqual(CMDT, 0x02))
						{
							If(WIST)
							{
								And(CMDP, One, Local0)
								Store(Local0, RSTY)
								And(CMDP, 0x02, Local1)
								ShiftRight(Local1, One, Local1)
								Store(Local1, FLRC)
								And(CMDP, 0x04, Local2)
								ShiftRight(Local2, 0x02, Local2)
								Store(Local2, BOFC)
							}
							Else
							{
								If(CondRefOf(\_SB.PC02.CNVW.RSTT))
								{
									ADBG(Concatenate("Set _PRR Mode = ", ToHexString(CMDP)))
									Store(CMDP, ^^^CNVW.RSTT)
								}
							}
							Return(Zero)
						}
						If(LEqual(CMDT, 0x03))
						{
							If(CondRefOf(\_SB.PC02.CNVW.PRRS))
							{
								ADBG(Concatenate("Get Last_PRR status PRRS = ", ToHexString(^^^CNVW.PRRS)))
								Return(^^^CNVW.PRRS)
							}
							Else
							{
								If(WIST)
								{
									ADBG(Concatenate("Get Last_PRR status DPRS = ", ToHexString(DPRS)))
									Return(DPRS)
								}
							}
						}
						Return(Zero)
					}
					If(LEqual(Arg2, 0x04))
					{
						CreateWordField(Arg3, Zero, PRTT)
						CreateWordField(Arg3, 0x02, PRTD)
						ADBG(Concatenate("TimerType = ", ToHexString(PRTT)))
						ADBG(Concatenate("TimerDuration (ms) = ", ToDecimalString(PRTD)))
						If(LEqual(PRTT, One))
						{
							Store(PRTD, FDEL)
						}
						Else
						{
							If(LEqual(PRTT, 0x02))
							{
								Store(PRTD, PDEL)
							}
							Else
							{
								If(LEqual(PRTT, 0x03))
								{
									Store(PRTD, VDEL)
								}
								Else
								{
									ADBG("TimerDuration not set")
								}
							}
						}
					}
					Return(Zero)
				}
				Method(IDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0x2C, 0x17, 0x66, 0x72, 0x0B, 0x22, 0x29, 0x4B, 
						0x81, 0x4F, 0x75, 0xE4, 0xDD, 0x26, 0xB5, 0xFD
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
				Method(EFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(0x02)
							{
								0xFF, 0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						Store(ACSD, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x02))
					{
						Store(I5BS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x03))
					{
						Store(UHBS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x06))
					{
						Store(AXMU, Local0)
						ShiftLeft(Local0, One, Local0)
						Or(Local0, AXSU, Local0)
						Store(AXMR, Local1)
						ShiftLeft(Local1, One, Local1)
						Or(Local1, AXSR, Local1)
						ShiftLeft(Local1, 0x02, Local1)
						Or(Local0, Local1, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x04))
					{
						Return(WFRC)
					}
					If(LEqual(Arg2, 0x05))
					{
						Return(WFUC)
					}
					If(LEqual(Arg2, 0x07))
					{
						Return(UNI4)
					}
					If(LEqual(Arg2, 0x08))
					{
						Return(WFIC)
					}
					If(LEqual(Arg2, 0x09))
					{
						Return(WFBS)
					}
					If(LEqual(Arg2, 0x0A))
					{
						Return(WEDT)
					}
					If(LEqual(Arg2, 0x0B))
					{
						If(CondRefOf(DRIE))
						{
							If(CondRefOf(CRFI))
							{
								If(LAnd(LEqual(DRIE, One), LEqual(CRFI, One)))
								{
									Return(Zero)
								}
								Else
								{
									If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, One)))
									{
										Return(One)
									}
									Else
									{
										If(LAnd(LEqual(DRIE, One), LEqual(CRFI, Zero)))
										{
											Return(0x02)
										}
										Else
										{
											If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, Zero)))
											{
												Return(0x03)
											}
										}
									}
								}
							}
						}
						Return(Zero)
					}
					If(LEqual(Arg2, 0x0C))
					{
						Return(WF7C)
					}
					Return(Zero)
				}
				Method(EDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0xBF, 0x02, 0x12, 0xF2, 0x78, 0x8F, 0xC6, 0x4D, 
						0xA5, 0xB3, 0x1F, 0x73, 0x8E, 0x28, 0x5A, 0xDE
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
			}
			Method(_DSM, 4, Serialized)
			{
				If(LOr(WIST, LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT))))
				{
					If(WIST)
					{
						If(EDSM)
						{
							Arg0
							Return(EFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
						If(IDSM)
						{
							Arg0
							Return(IFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(LEqual(Arg0, ToUUID("BAD01B75-22A84F48-8792BDDE9467747D")}))
						{
							If(LEqual(Arg2, Zero))
							{
								Return(Buffer(One)
								{
									0x09
								})
							}
							If(LEqual(Arg2, One)) {}
							If(LEqual(Arg2, 0x02)) {}
							If(LEqual(Arg2, 0x03))
							{
								If(LEqual(WRTO, One))
								{
									ADBG("WWAN Power _DSM D0/L1.2")
								}
								Else
								{
									If(LEqual(WRTO, 0x02))
									{
										ADBG("WWAN Power _DSM D3/L1.2")
									}
									Else
									{
										If(LEqual(WRTO, 0x03))
										{
											ADBG("WWAN Power _DSM D3/L2")
										}
										Else
										{
											ADBG("WWAN Power _DSM Disabled")
										}
									}
								}
								Return(WRTO)
							}
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
		}
	}
	If(CondRefOf(\_SB.PC02.RP03.PXSX))
	{
		Scope(_SB.PC02.RP03.PXSX)
		{
			OperationRegion(RPXX, SystemMemory, GMIO(PBNU, ^_ADR, _ADR), 0x30)
			Field(RPXX, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x2C),	//Offset(44),
				SVID, 16,
			}
			OperationRegion(FLDR, SystemMemory, Add(GMIO(PBNU, ^_ADR, _ADR), WDCO), 0x06)
			Field(FLDR, ByteAcc, NoLock, Preserve)
			{
				DCAP, 32,
				DCTR, 16,
			}
