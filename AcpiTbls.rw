					{
						Or(One, Local0, Local0)
						Xor(One, WTTR, WTTR)
					}
				}
				Else
				{
					If(LAnd(LEqual(^^PPMC.DCWA, 0xFFFFFFFF), And(0x02, WTTR)))
					{
						Or(One, Local0, Local0)
						Xor(0x02, WTTR, WTTR)
					}
				}
