					}
					Method(_PRW, 0, NotSerialized)
					{
						ADBG(Concatenate("_PRW PCIe RP", ToHexString(SLOT)))
						If(CondRefOf(GP1E))
						{
							If(LNotEqual(GP1E, Zero))
							{
								Return(GPRW(0x6B, 0x04))
							}
						}
						Return(GPRW(0x69, Zero))
					}
				}
				Method(_PS0, 0, Serialized)
				{
					ADBG(Concatenate("_PS0 PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(PPS0))
					{
						ADBG("Calling Platform PCIE RP PS0 Hook")
						PPS0
						ADBG("Returned from Platform PCIE RP PS0 Hook")
					}
				}
				Method(_PS3, 0, Serialized)
				{
					ADBG(Concatenate("_PS3 PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(PPS3))
					{
						ADBG("Calling Platform PCIE RP PS3 Hook")
						PPS3
						ADBG("Returned from Platform PCIE RP PS3 Hook")
					}
				}
				Method(_DSD, 0, NotSerialized)
				{
					ADBG(Concatenate("_DSD PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(ADSD))
					{
						ADBG(Concatenate("Alternate _DSD PCIe RP", ToHexString(SLOT)))
						Return(ADSD)
					}
					If(CondRefOf(PINI))
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xAD, 0x6F, 0xF0, 0xFD, 0x44, 0xF7, 0x51, 0x44, 
								0xBB, 0x64, 0xEC, 0xD7, 0x92, 0x21, 0x5B, 0x10
							}, 
							Package(1)
							{
								Package(2) {"FundamentalDeviceResetTriggeredOnD3ToD0", One}
							}, 
							Buffer(0x10)
							{
								0x20, 0xD4, 0x4A, 0x6B, 0xD3, 0x8F, 0x64, 0x43, 
								0xAC, 0xF8, 0xEB, 0x94, 0x87, 0x6F, 0xD9, 0xEB
							}, 
							Package(0){}
						})
					}
					Else
					{
						Return(Package(2)
						{
							Buffer(0x10)
							{
								0xAD, 0x6F, 0xF0, 0xFD, 0x44, 0xF7, 0x51, 0x44, 
								0xBB, 0x64, 0xEC, 0xD7, 0x92, 0x21, 0x5B, 0x10
							}, 
							Package(1)
							{
								Package(2) {"FundamentalDeviceResetTriggeredOnD3ToD0", One}
							}
						})
					}
				}
				Method(HPME, 0, Serialized)
				{
					If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), LEqual(PMSX, One)))
					{
						Notify(PXSX, 0x02)
						Store(One, PMSX)
						Store(One, PSPX)
					}
				}
			}
			Scope(RP12)
			{
				Name(PBNU, Zero)
				Store(PBSB, PBNU)
				Name(SLOT, 0x0C)
				Name(PRTP, 0x02)
				Name(LTEN, Zero)
				Name(LMSL, Zero)
				Name(LNSL, Zero)
				Method(_INI, 0, NotSerialized)
				{
					Store(LTRC, LTEN)
					Store(PMLC, LMSL)
					Store(PNLC, LNSL)
					If(LAnd(CondRefOf(VMPP), CondRefOf(VMDE)))
					{
						If(LAnd(LEqual(VMDE, One), LNotEqual(And(VMPP, 0x0800), Zero)))
						{
							ADBG("PCH RP12 (129/29/3) is mapped under VMD")
							Store(One, PRMV)
						}
					}
					If(PRES)
					{
						If(CondRefOf(PINI))
						{
							PINI
						}
					}
					If(CondRefOf(\_SB.PC02.RP12))
					{
						If(LNotEqual(VDID, 0xFFFFFFFF))
						{
							If(CondRefOf(\STD3))
							{
								If(CondRefOf(\_SB.PC02.RP12.PRMV))
								{
									If(LEqual(PRMV, One))
									{
										ADBG(Concatenate("VMD Storage Runtime D3 status:", ToHexString(RD3C)))
										Store(STD3, RD3C)
									}
								}
								If(LOr(^PXSX.PNVM, ^PXSX.PAHC))
								{
									ADBG(Concatenate("Storage Runtime D3 status:", ToHexString(RD3C)))
									Store(STD3, RD3C)
								}
							}
						}
					}
				}
				OperationRegion(PXCS, SystemMemory, ^^PC00.PC2M(_ADR, PBNU), 0x0480)
				Field(PXCS, AnyAcc, NoLock, Preserve)
				{
					VDID, 32,
					Offset(0x50),	//Offset(80),
					L0SE, 1,
					, 3,
					LDIS, 1,
					, 3,
					, 8,
					Offset(0x53),	//Offset(83),
					, 5,
					LASX, 1,
					Offset(0x5A),	//Offset(90),
					ABPX, 1,
					, 2,
					PDCX, 1,
					, 2,
					PDSX, 1,
					, 1,
					Offset(0x60),	//Offset(96),
					Offset(0x62),	//Offset(98),
					PSPX, 1,
					Offset(0x68),	//Offset(104),
					Offset(0x69),	//Offset(105),
					, 2,
					LNRE, 1,
					Offset(0xA4),	//Offset(164),
					D3HT, 2,
					Offset(0xD8),	//Offset(216),
					Offset(0xDB),	//Offset(219),
					, 6,
					HPEX, 1,
					PMEX, 1,
					Offset(0xE0),	//Offset(224),
					SCB0, 1,
					, 6,
					NCB7, 1,
					, 8,
					, 2,
					L23E, 1,
					L23R, 1,
					Offset(0x328),	//Offset(808),
					Offset(0x32B),	//Offset(811),
					LTSM, 8,
					Offset(0x404),	//Offset(1028),
					LSOE, 1,
					LNSE, 1,
				}
				Field(PXCS, AnyAcc, NoLock, WriteAsZeros)
				{
					Offset(0xDC),	//Offset(220),
					Offset(0xDF),	//Offset(223),
					, 6,
					HPSX, 1,
					PMSX, 1,
				}
				Method(L23D, 0, Serialized)
				{
					ADBG(Concatenate("PCIe RP LTSSM at L23D Start  -", ToHexString(LTSM)))
					If(LNotEqual(SCB0, One))
					{
						ADBG(Concatenate("PON SCB ", ToHexString(SLOT)))
						Return(Zero)
					}
					Store(One, L23R)
					Store(Zero, Local0)
					While(L23R)
					{
						If(LGreater(Local0, 0x04))
						{
							ADBG(Concatenate("PCIE L23R TO ", ToHexString(SLOT)))
							Break
						}
						Sleep(0x10)
						Increment(Local0)
					}
					Store(Zero, SCB0)
					Store(Zero, Local0)
					While(LEqual(LASX, Zero))
					{
						If(LGreater(Local0, 0x08))
						{
							ADBG(Concatenate("PCIE LASX TO ", ToHexString(SLOT)))
							Break
						}
						Sleep(0x10)
						Increment(Local0)
					}
					ADBG(Concatenate("PCIe RP LTSSM at L23D End -", ToHexString(LTSM)))
				}
				Method(DL23, 0, Serialized)
				{
					ADBG(Concatenate("PCIe RP LTSSM at DL23 Start -", ToHexString(LTSM)))
					If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
					{
						If(LOr(LEqual(LSOE, One), LEqual(LNSE, One)))
						{
							Store(One, LNRE)
							Store(Zero, Local0)
							Store(0xA0, Local1)
							While(LLess(Local0, Local1))
							{
								Add(Local0, One, Local0)
								Stall(0x64)
							}
							Store(Zero, LNRE)
							ADBG("Toggle LNRE")
						}
					}
					Store(One, L23E)
					Sleep(0x10)
					Store(Zero, Local0)
					While(L23E)
					{
						If(LGreater(Local0, 0x04))
						{
							ADBG(Concatenate("POF L23E TO", ToHexString(SLOT)))
							Break
						}
						Store(Zero, Local0)
						Store(0xA0, Local1)
						While(LLess(Local0, Local1))
						{
							Add(Local0, One, Local0)
							Stall(0x64)
						}
						Increment(Local0)
					}
					ADBG(Concatenate("POF RP ", ToHexString(SLOT)))
					Store(One, SCB0)
					ADBG(Concatenate("PCIe RP LTSSM at DL23 End -", ToHexString(LTSM)))
				}
				Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
				Name(PRMV, Zero)
				Name(RD3C, 0x02)
				Method(PRES, 0, NotSerialized)
				{
					If(LEqual(VDID, 0xFFFFFFFF))
					{
						Return(Zero)
					}
					Else
					{
						Return(One)
					}
				}
				Method(_DSM, 4, Serialized)
				{
					Name(_T_0, Zero)
					If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
					{
						While(One)
						{
							Store(ToInteger(Arg2), _T_0)
							If(LEqual(_T_0, Zero))
							{
								Name(OPTS, Buffer(0x02)
								{
									0x00, 0x00
								})
								CreateBitField(OPTS,Zero,FUN0)
								CreateBitField(OPTS,0x06,FUN6)
								CreateBitField(OPTS,0x08,FUN8)
								CreateBitField(OPTS,0x09,FUN9)
								CreateBitField(OPTS,0x0A,FUNA)
								CreateBitField(OPTS,0x0B,FUNB)
								If(LGreaterEqual(Arg1, 0x02))
								{
									Store(One, FUN0)
									If(LNotEqual(LTEN, Zero))
									{
										Store(One, FUN6)
									}
									If(CondRefOf(ECR1))
									{
										If(LEqual(ECR1, One))
										{
											If(LGreaterEqual(Arg1, 0x03))
											{
												Store(One, FUN8)
												Store(One, FUN9)
											}
										}
									}
								}
								If(LGreaterEqual(Arg1, 0x04))
								{
									If(CondRefOf(PPBA))
									{
										Store(One, FUNA)
									}
									If(CondRefOf(UPRD))
									{
										Store(One, FUNB)
									}
								}
								ADBG(Concatenate("_DSM PCIe RP OPTS -", ToHexString(OPTS)))
								Return(OPTS)
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
									{
										Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
										Store(And(LMSL, 0x03FF), Index(LTRV, One))
										Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
										Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
										Return(LTRV)
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x08))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(One)
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x09))
										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
										Else
										{
											If(LEqual(_T_0, 0x0A))
											{
												If(CondRefOf(PPBA))
												{
													Return(PPBA)
													Arg3
												}
											}
											Else
											{
												If(LEqual(_T_0, 0x0B))
												{
													If(CondRefOf(UPRD))
													{
														Return(UPRD)
														Arg3
													}
												}
											}
										}
									}
								}
							}
							Break
						}
					}
					Return(Buffer(One)
					{
						0x00
					})
				}
				Device(PXSX)
				{
					Name(_ADR, Zero)
					OperationRegion(PCCX, PCI_Config, Zero, 0x10)
					Field(PCCX, ByteAcc, NoLock, Preserve)
					{
						DVID, 32,
						Offset(0x9),	//Offset(9),
						PIXX, 8,
						SCCX, 8,
						BCCX, 8,
					}
					Method(PAHC, 0, Serialized)
					{
						If(LEqual(BCCX, One))
						{
							If(LEqual(SCCX, 0x06))
							{
								If(LEqual(PIXX, One))
								{
									ADBG("PSSD AHCI")
									Return(One)
								}
							}
						}
						Return(Zero)
					}
					Method(PNVM, 0, Serialized)
					{
						If(LEqual(BCCX, One))
						{
							If(LEqual(SCCX, 0x08))
							{
								If(LEqual(PIXX, 0x02))
								{
									ADBG("PSSD NVMe")
									Return(One)
								}
							}
						}
						Return(Zero)
					}
					Method(PRES, 0, Serialized)
					{
						If(LEqual(DVID, 0xFFFFFFFF))
						{
							Return(Zero)
						}
						Else
						{
							Return(One)
						}
					}
					Method(ISGX, 0, Serialized)
					{
						If(LEqual(BCCX, 0x03))
						{
							Return(One)
						}
						Return(Zero)
					}
					If(CondRefOf(\STD3))
					{
						If(LNotEqual(STD3, Zero))
						{
							Method(_DSD, 0, NotSerialized)
							{
								If(LOr(PAHC, PNVM))
								{
									ADBG("NVMe D3 Support Enable for Child Device")
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x0F, 0x03, 0x25, 0x50, 0x2F, 0x84, 0xB4, 0x4A, 
											0xA5, 0x61, 0x99, 0xA5, 0x18, 0x97, 0x62, 0xD0
										}, 
										Package(1)
										{
											Package(2) {"StorageD3Enable", One}
										}
									})
								}
								Else
								{
									Return(Package(2)
									{
										Buffer(0x10)
										{
											0x0F, 0x03, 0x25, 0x50, 0x2F, 0x84, 0xB4, 0x4A, 
											0xA5, 0x61, 0x99, 0xA5, 0x18, 0x97, 0x62, 0xD0
										}, 
										Package(1)
										{
											Package(2) {"StorageD3Enable", Zero}
										}
									})
								}
							}
						}
					}
					Method(_PRW, 0, NotSerialized)
					{
						ADBG(Concatenate("_PRW PCIe RP", ToHexString(SLOT)))
						If(CondRefOf(GP1E))
						{
							If(LNotEqual(GP1E, Zero))
							{
								Return(GPRW(0x6B, 0x04))
							}
						}
						Return(GPRW(0x69, Zero))
					}
				}
				Method(_PS0, 0, Serialized)
				{
					ADBG(Concatenate("_PS0 PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(PPS0))
					{
						ADBG("Calling Platform PCIE RP PS0 Hook")
						PPS0
						ADBG("Returned from Platform PCIE RP PS0 Hook")
					}
				}
				Method(_PS3, 0, Serialized)
				{
					ADBG(Concatenate("_PS3 PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(PPS3))
					{
						ADBG("Calling Platform PCIE RP PS3 Hook")
						PPS3
						ADBG("Returned from Platform PCIE RP PS3 Hook")
					}
				}
				Method(_DSD, 0, NotSerialized)
				{
					ADBG(Concatenate("_DSD PCIe RP", ToHexString(SLOT)))
					If(CondRefOf(ADSD))
					{
						ADBG(Concatenate("Alternate _DSD PCIe RP", ToHexString(SLOT)))
						Return(ADSD)
					}
					If(CondRefOf(PINI))
					{
						Return(Package(4)
						{
							Buffer(0x10)
							{
								0xAD, 0x6F, 0xF0, 0xFD, 0x44, 0xF7, 0x51, 0x44, 
								0xBB, 0x64, 0xEC, 0xD7, 0x92, 0x21, 0x5B, 0x10
							}, 
							Package(1)
							{
								Package(2) {"FundamentalDeviceResetTriggeredOnD3ToD0", One}
							}, 
							Buffer(0x10)
							{
								0x20, 0xD4, 0x4A, 0x6B, 0xD3, 0x8F, 0x64, 0x43, 
								0xAC, 0xF8, 0xEB, 0x94, 0x87, 0x6F, 0xD9, 0xEB
							}, 
							Package(0){}
						})
					}
					Else
					{
						Return(Package(2)
						{
							Buffer(0x10)
							{
								0xAD, 0x6F, 0xF0, 0xFD, 0x44, 0xF7, 0x51, 0x44, 
								0xBB, 0x64, 0xEC, 0xD7, 0x92, 0x21, 0x5B, 0x10
							}, 
							Package(1)
							{
								Package(2) {"FundamentalDeviceResetTriggeredOnD3ToD0", One}
							}
						})
					}
				}
				Method(HPME, 0, Serialized)
				{
					If(LAnd(LNotEqual(VDID, 0xFFFFFFFF), LEqual(PMSX, One)))
					{
						Notify(PXSX, 0x02)
						Store(One, PMSX)
						Store(One, PSPX)
					}
				}
			}
			Scope(RP13)
			{
				Name(PBNU, Zero)
				Store(PBSB, PBNU)
				Name(SLOT, 0x0D)
				Name(PRTP, 0x02)
				Name(LTEN, Zero)
				Name(LMSL, Zero)
				Name(LNSL, Zero)
				Method(_INI, 0, NotSerialized)
				{
					Store(LTRD, LTEN)
					Store(PMLD, LMSL)
					Store(PNLD, LNSL)
					If(LAnd(CondRefOf(VMPP), CondRefOf(VMDE)))
					{
						If(LAnd(LEqual(VMDE, One), LNotEqual(And(VMPP, 0x1000), Zero)))
						{
							ADBG("PCH RP13 (129/29/4) is mapped under VMD")
							Store(One, PRMV)
						}
					}
					If(PRES)
					{
						If(CondRefOf(PINI))
						{
							PINI
						}
					}
					If(CondRefOf(\_SB.PC02.RP13))
					{
						If(LNotEqual(VDID, 0xFFFFFFFF))
						{
							If(CondRefOf(\STD3))
							{
								If(CondRefOf(\_SB.PC02.RP13.PRMV))
								{
									If(LEqual(PRMV, One))
									{
										ADBG(Concatenate("VMD Storage Runtime D3 status:", ToHexString(RD3C)))
										Store(STD3, RD3C)
									}
								}
								If(LOr(^PXSX.PNVM, ^PXSX.PAHC))
								{
									ADBG(Concatenate("Storage Runtime D3 status:", ToHexString(RD3C)))
									Store(STD3, RD3C)
								}
							}
						}
					}
				}
				OperationRegion(PXCS, SystemMemory, ^^PC00.PC2M(_ADR, PBNU), 0x0480)
				Field(PXCS, AnyAcc, NoLock, Preserve)
				{
					VDID, 32,
					Offset(0x50),	//Offset(80),
					L0SE, 1,
					, 3,
					LDIS, 1,
					, 3,
					, 8,
					Offset(0x53),	//Offset(83),
					, 5,
					LASX, 1,
					Offset(0x5A),	//Offset(90),
					ABPX, 1,
					, 2,
					PDCX, 1,
					, 2,
					PDSX, 1,
					, 1,
					Offset(0x60),	//Offset(96),
					Offset(0x62),	//Offset(98),
					PSPX, 1,
					Offset(0x68),	//Offset(104),
					Offset(0x69),	//Offset(105),
					, 2,
					LNRE, 1,
					Offset(0xA4),	//Offset(164),
					D3HT, 2,
					Offset(0xD8),	//Offset(216),
					Offset(0xDB),	//Offset(219),
					, 6,
					HPEX, 1,
					PMEX, 1,
					Offset(0xE0),	//Offset(224),
					SCB0, 1,
					, 6,
					NCB7, 1,
					, 8,
					, 2,
					L23E, 1,
					L23R, 1,
					Offset(0x328),	//Offset(808),
					Offset(0x32B),	//Offset(811),
					LTSM, 8,
					Offset(0x404),	//Offset(1028),
					LSOE, 1,
					LNSE, 1,
				}
				Field(PXCS, AnyAcc, NoLock, WriteAsZeros)
				{
					Offset(0xDC),	//Offset(220),
					Offset(0xDF),	//Offset(223),
					, 6,
					HPSX, 1,
					PMSX, 1,
				}
				Method(L23D, 0, Serialized)
				{
					ADBG(Concatenate("PCIe RP LTSSM at L23D Start  -", ToHexString(LTSM)))
					If(LNotEqual(SCB0, One))
					{
						ADBG(Concatenate("PON SCB ", ToHexString(SLOT)))
						Return(Zero)
					}
					Store(One, L23R)
					Store(Zero, Local0)
					While(L23R)
					{
						If(LGreater(Local0, 0x04))
						{
							ADBG(Concatenate("PCIE L23R TO ", ToHexString(SLOT)))
							Break
						}
						Sleep(0x10)
						Increment(Local0)
					}
					Store(Zero, SCB0)
					Store(Zero, Local0)
					While(LEqual(LASX, Zero))
					{
						If(LGreater(Local0, 0x08))
						{
							ADBG(Concatenate("PCIE LASX TO ", ToHexString(SLOT)))
							Break
						}
						Sleep(0x10)
						Increment(Local0)
					}
					ADBG(Concatenate("PCIe RP LTSSM at L23D End -", ToHexString(LTSM)))
				}
				Method(DL23, 0, Serialized)
				{
					ADBG(Concatenate("PCIe RP LTSSM at DL23 Start -", ToHexString(LTSM)))
					If(LAnd(LEqual(LASX, One), LEqual(LNRE, Zero)))
					{
						If(LOr(LEqual(LSOE, One), LEqual(LNSE, One)))
						{
							Store(One, LNRE)
							Store(Zero, Local0)
							Store(0xA0, Local1)
							While(LLess(Local0, Local1))
							{
								Add(Local0, One, Local0)
								Stall(0x64)
							}
							Store(Zero, LNRE)
							ADBG("Toggle LNRE")
						}
					}
					Store(One, L23E)
					Sleep(0x10)
					Store(Zero, Local0)
					While(L23E)
					{
						If(LGreater(Local0, 0x04))
						{
							ADBG(Concatenate("POF L23E TO", ToHexString(SLOT)))
							Break
						}
						Store(Zero, Local0)
						Store(0xA0, Local1)
						While(LLess(Local0, Local1))
						{
							Add(Local0, One, Local0)
							Stall(0x64)
						}
						Increment(Local0)
					}
					ADBG(Concatenate("POF RP ", ToHexString(SLOT)))
					Store(One, SCB0)
					ADBG(Concatenate("PCIe RP LTSSM at DL23 End -", ToHexString(LTSM)))
				}
				Name(LTRV, Package(4) {Zero, Zero, Zero, Zero})
				Name(PRMV, Zero)
				Name(RD3C, 0x02)
				Method(PRES, 0, NotSerialized)
				{
					If(LEqual(VDID, 0xFFFFFFFF))
					{
						Return(Zero)
					}
					Else
					{
						Return(One)
					}
				}
				Method(_DSM, 4, Serialized)
				{
					Name(_T_0, Zero)
					If(LEqual(Arg0, ToUUID("E5C937D0-35534D7A-9117EA4D19C3434D")}))
					{
						While(One)
						{
							Store(ToInteger(Arg2), _T_0)
							If(LEqual(_T_0, Zero))
							{
								Name(OPTS, Buffer(0x02)
								{
									0x00, 0x00
								})
								CreateBitField(OPTS,Zero,FUN0)
								CreateBitField(OPTS,0x06,FUN6)
								CreateBitField(OPTS,0x08,FUN8)
								CreateBitField(OPTS,0x09,FUN9)
								CreateBitField(OPTS,0x0A,FUNA)
								CreateBitField(OPTS,0x0B,FUNB)
								If(LGreaterEqual(Arg1, 0x02))
								{
									Store(One, FUN0)
									If(LNotEqual(LTEN, Zero))
									{
										Store(One, FUN6)
									}
									If(CondRefOf(ECR1))
									{
										If(LEqual(ECR1, One))
										{
											If(LGreaterEqual(Arg1, 0x03))
											{
												Store(One, FUN8)
												Store(One, FUN9)
											}
										}
									}
								}
								If(LGreaterEqual(Arg1, 0x04))
								{
									If(CondRefOf(PPBA))
									{
										Store(One, FUNA)
									}
									If(CondRefOf(UPRD))
									{
										Store(One, FUNB)
									}
								}
								ADBG(Concatenate("_DSM PCIe RP OPTS -", ToHexString(OPTS)))
								Return(OPTS)
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
									{
										Store(And(ShiftRight(LMSL, 0x0A), 0x07), Index(LTRV, Zero))
										Store(And(LMSL, 0x03FF), Index(LTRV, One))
										Store(And(ShiftRight(LNSL, 0x0A), 0x07), Index(LTRV, 0x02))
										Store(And(LNSL, 0x03FF), Index(LTRV, 0x03))
										Return(LTRV)
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x08))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
													Return(One)
												}
											}
										}
									}
									Else
									{
										If(LEqual(_T_0, 0x09))
										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
										Else
										{
											If(LEqual(_T_0, 0x0A))
											{
												If(CondRefOf(PPBA))
												{
													Return(PPBA)
													Arg3
												}
											}
											Else
											{
												If(LEqual(_T_0, 0x0B))
												{
													If(CondRefOf(UPRD))
													{
														Return(UPRD(Arg3))
													}
												}
											}
										}
									}
								}
							}
							Break
						}
					}
					Return(Buffer(One)
					{
						0x00
					})
				}
				Device(PXSX)
				{
					Name(_ADR, Zero)
					OperationRegion(PCCX, PCI_Config, Zero, 0x10)
					Field(PCCX, ByteAcc, NoLock, Preserve)
					{
						DVID, 32,
						Offset(0x9),	//Offset(9),
						PIXX, 8,
						SCCX, 8,
						BCCX, 8,
					}
