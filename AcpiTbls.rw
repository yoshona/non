						If(IDSM)
						{
							Arg0
							Return(IFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
