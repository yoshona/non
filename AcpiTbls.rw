			Store(Arg1, Local0)
			ADBG(Concatenate("IMMC Delay ", ToHexString(Local0)))
			While(LAnd(LNotEqual(And(IMCD, 0x80000000), Zero), LNotEqual(Local0, Zero)))
			{
