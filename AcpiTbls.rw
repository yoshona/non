									{
										If(LEqual(ECR1, One))
										{
											If(LGreaterEqual(Arg1, 0x03))
											{
												Return(One)
											}
										}
									}
								}
								Else
								{
									If(LEqual(_T_0, 0x09))
									{
										If(CondRefOf(ECR1))
										{
											If(LEqual(ECR1, One))
											{
												If(LGreaterEqual(Arg1, 0x03))
												{
