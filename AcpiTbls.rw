		PowerResource(PXP, 0, 0)
		{
			Method(_STA, 0, NotSerialized)
			{
				ADBG(Concatenate("PXP _STA Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
				If(LEqual(VDID, 0xFFFFFFFF))
				{
					ADBG("_STA return 0 as VDID = 0xFFFFFFFF")
					Return(Zero)
				}
				If(LEqual(GPRS(0x02), Zero))
				{
					Return(Zero)
				}
				Return(PSTA())
			}
			Method(_ON, 0, NotSerialized)
			{
				ADBG(Concatenate("PXP _ON Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
				If(LEqual(VDID, 0xFFFFFFFF))
				{
					ADBG("_ON return as VDID = 0xFFFFFFFF")
				}
				Else
				{
					If(LEqual(GPRS(One), Zero)) {}
					Else
					{
						If(LOr(LEqual(\_SB.PC00.LPCB.EC0.IGPU, One), LEqual(\_SB.PC00.LPCB.EC0.IGPU, 0x02))) {}
						Else
						{
							PON()
							Store(Zero, Local0)
							Store(0x1388, Local1)
							While(LLess(Local0, Local1))
							{
								Add(Local0, One, Local0)
								Stall(0x64)
							}
							L23D
						}
					}
				}
			}
			Method(_OFF, 0, NotSerialized)
			{
				ADBG(Concatenate("PXP _OFF Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
				If(LEqual(VDID, 0xFFFFFFFF))
				{
					ADBG("_OFF return as VDID = 0xFFFFFFFF")
				}
				Else
				{
					If(LEqual(GPRS(Zero), Zero)) {}
					Else
					{
						DL23
						POFF()
					}
				}
			}
		}
		Method(GPPR, 0, NotSerialized)
		{
			ADBG(Concatenate("GPPR Entry For ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
			If(CondRefOf(WAKP))
			{
				If(LAnd(LNotEqual(WAKP, Zero), LEqual(WKEN, Zero)))
				{
					ADBG(Concatenate("WAKE enable and keep CIO power on for ", Concatenate("PCIE RP", Concatenate(Concatenate(" Type (2: PCH, 4: CPU) : ", ToHexString(PRTP)), Concatenate(" And Index : ", ToHexString(SLOT))))))
					Return(Zero)
