		}
	}
	If(LEqual(VMDE, One))
	{
		Name(VDSD, One)
		If(LEqual(STD3, Zero))
		{
			Store(Zero, VDSD)
		}
		ADBG
		Concatenate("VMD _DSD Method option:", ToHexString(VDSD))
		Scope(_SB.PC00)
		{
			Device(VMD0)
			{
				Name(_ADR, 0x000E0000)
				If(CondRefOf(\VDSD))
				{
					If(LEqual(VDSD, One))
					{
						Name(_DSD, Package(2)
						{
							Buffer(0x10)
							{
								0x0F, 0x03, 0x25, 0x50, 0x2F, 0x84, 0xB4, 0x4A, 
								0xA5, 0x61, 0x99, 0xA5, 0x18, 0x97, 0x62, 0xD0
							}, 
							Package(1)
							{
								Package(2) {"StorageD3Enable", One}
							}
						})
					}
				}
				Method(_PS0, 0, Serialized)
				{
					ADBG("VMD _PS0")
					If(CondRefOf(VMS0))
					{
						If(LNotEqual(VMS0, Zero))
						{
							ADBG("VMD SATA0 Ctrlr D0 - Clear LTR ignore bit for SATA")
							Store(Zero, ^^^PC02.PPMC.ISAT)
							ADBG(Concatenate("SATA PS0 LTR ignore bit status = ", ToHexString(^^^PC02.PPMC.ISAT)))
						}
					}
				}
				Method(_PS3, 0, Serialized)
				{
					ADBG("VMD _PS3")
					If(CondRefOf(VMS0))
					{
						If(LNotEqual(VMS0, Zero))
						{
							ADBG("VMD SATA0 Ctrlr D3 - Set LTR ignore bit for SATA")
							Store(One, ^^^PC02.PPMC.ISAT)
							ADBG(Concatenate("SATA PS3 LTR ignore bit status = ", ToHexString(^^^PC02.PPMC.ISAT)))
						}
					}
				}
				Method(CBAR, 3, Serialized)
				{
					Name(VCFB, Zero)
					Store(XBAS, VCFB)
					Or(VCFB, Zero, VCFB)
					Or(VCFB, 0x00070000, VCFB)
					Or(VCFB, Zero, VCFB)
					OperationRegion(VCFG, SystemMemory, VCFB, 0x0100)
					Field(VCFG, DWordAcc, NoLock, Preserve)
					{
						Offset(0x10),	//Offset(16),
						BAR0, 64,
					}
					Name(DCFB, Zero)
					Store(BAR0, DCFB)
					And(DCFB, 0x44FFFFFFFFFFFFFF, DCFB)
					Or(DCFB, ShiftLeft(Arg0, 0x14), DCFB)
					Or(DCFB, ShiftLeft(Arg1, 0x0F), DCFB)
					Or(DCFB, ShiftLeft(Arg2, 0x0C), DCFB)
					If(LNotEqual(Arg0, Zero))
					{
						Store(Add(DCFB, 0x00100000), DCFB)
					}
					Return(DCFB)
				}
				Method(VADR, 5, Serialized)
				{
					Name(AADR, Zero)
					Or(AADR, ShiftLeft(Arg0, 0x1F), AADR)
					Or(AADR, ShiftLeft(And(Arg1, 0x7F), 0x18), AADR)
					Or(AADR, ShiftLeft(Arg2, 0x13), AADR)
					Or(AADR, ShiftLeft(Arg3, 0x10), AADR)
					If(LEqual(ShiftRight(And(Arg1, 0x80), 0x07), Zero))
					{
						Or(AADR, 0x8000, AADR)
					}
					If(LEqual(Arg0, One))
					{
						Or(AADR, 0x7FFF, AADR)
					}
					Else
					{
						Store(0x07FF, Local0)
						Or(ShiftLeft(Local0, 0x04), Arg4, Local0)
						Or(AADR, Local0, AADR)
					}
					Return(AADR)
				}
				Device(PP01)
				{
					Name(RPB, Zero)
					Store(PBUS, RPB)
					Name(RPD, 0x1C)
					Name(RPF, Zero)
					Name(RSPT, One)
					Name(RSPI, Zero)
					Method(_ADR, 0, NotSerialized)
					{
						Return(VADR)
						RSPT
						RPB
						RPD
						RPF
						RSPI
					}
					Name(ID3C, Zero)
					Method(VR3D, 0, NotSerialized)
					{
						ADBG(Concatenate("VR3D: ", ToHexString(_ADR)))
						Return(VD3C)
						_ADR
					}
					Method(VPON, 0, Serialized)
					{
						Name(DCFB, Zero)
						Store(CBAR, RPB)
						RPD
						RPF
						DCFB
						OperationRegion(DCFG, SystemMemory, DCFB, 0x0C80)
						Field(DCFG, DWordAcc, NoLock, Preserve)
						{
							VDID, 32,
						}
						If(CondRefOf(VDID))
						{
							If(LEqual(VDID, 0xFFFFFFFF))
							{
								ADBG(Concatenate("VPON return as VDID=", ToHexString(VDID)))
								ADBG("WAK Notify 0 to VMD controller")
								Notify(^, Zero)
								Store(0xC8, Local1)
								While(LGreater(Local1, Zero))
								{
									Store(Subtract(Local1, One), Local1)
									If(LNotEqual(VDID, 0xFFFFFFFF))
									{
										ADBG(Concatenate("VPON VDID=", ToHexString(VDID)))
										Break
									}
									ADBG("Wait 10 ms for VMD controller to exit D3hot")
									Sleep(0x0A)
								}
							}
						}
						ADBG(Concatenate("VPON VDID=", ToHexString(VDID)))
						ADBG(Concatenate("VPON _ADR: ", ToHexString(_ADR)))
						If(LEqual(ID3C, Zero))
						{
							ADBG("VPON: Device is not in D3Cold")
							Return(Zero)
						}
