			Method(NPCF, 4, Serialized)
			{
				Name(_T_3, Zero)
				Name(_T_2, Zero)
				Name(_T_1, Zero)
				Name(_T_0, Zero)
				Store("------- NVPCF DSM --------", Debug)
				If(LNotEqual(ToInteger(Arg1), 0x0200))
				{
					Return(0x80000001)
				}
				While(One)
				{
					Store(ToInteger(Arg2), _T_0)
					If(LEqual(_T_0, Zero))
					{
						Store("   NVPCF sub-func#0", Debug)
						Name(BUFF, Buffer(0x04)
						{
							0xBF, 0x06, 0x00, 0x00
						})
						Store(DerefOf(Index(BUFF, One)), Local1)
						Store(Or(Local1, One), Index(BUFF, One))
						Return(BUFF)
					}
					Else
					{
						If(LEqual(_T_0, One))
						{
							Store("   NVPCF sub-func#1", Debug)
							Return(Buffer(0x0E)
							{
								0x20, 0x03, 0x01, 0x00, 0x25, 0x04, 0x05, 0x01, 
								0x01, 0x03, 0x00, 0x00, 0x00, 0xA9
							})
						}
						Else
						{
							If(LEqual(_T_0, 0x02))
							{
								Store("   NVPCF sub-func#2", Debug)
								Name(PBD2, Buffer(0x31)
								{
									0x00
								})
								CreateByteField(PBD2,Zero,PTV2)
								CreateByteField(PBD2,One,PHB2)
								CreateByteField(PBD2,0x02,GSB2)
								CreateByteField(PBD2,0x03,CTB2)
								CreateByteField(PBD2,0x04,NCE2)
								Store(0x25, PTV2)
								Store(0x05, PHB2)
								Store(0x10, GSB2)
								Store(0x1C, CTB2)
								Store(One, NCE2)
								CreateWordField(PBD2, 0x05, TGPA)
								CreateWordField(PBD2, 0x07, TGPD)
								CreateByteField(PBD2,0x15,PC01)
								CreateByteField(PBD2,0x16,PC02)
								CreateWordField(PBD2, 0x19, TPPA)
								CreateWordField(PBD2, 0x1B, TPPD)
								CreateWordField(PBD2, 0x1D, MAGA)
								CreateWordField(PBD2, 0x1F, MAGD)
								CreateWordField(PBD2, 0x21, MIGA)
								CreateWordField(PBD2, 0x23, MIGD)
								CreateDWordField(PBD2, 0x25, DROP)
								CreateDWordField(PBD2, 0x29, LTBC)
								CreateDWordField(PBD2, 0x2D, STBC)
								CreateField(Arg3,0x28,0x02,NIGS)
								CreateByteField(Arg3,0x15,IORC)
								CreateField(Arg3,0xB0,One,PWCS)
								CreateField(Arg3,0xB1,One,PWTS)
								CreateField(Arg3,0xB2,One,CGPS)
								If(LEqual(ToInteger(NIGS), Zero))
								{
									If(LEqual(CTGP, One))
									{
										Store(ACBT, TGPA)
									}
									Else
									{
										Store(Zero, TGPA)
									}
									Store(DCBT, TGPD)
									Store(Zero, PC01)
									If(LEqual(\_SB.PC00.LPCB.EC0.BPST, One))
									{
										Store(Multiply(\_SB.PC00.LPCB.EC0.XIF4, \_SB.PC00.LPCB.EC0.XIF1), Local0)
										Divide(Local0, 0x000F4240, Local2, Local1)
										If(LAnd(LGreaterEqual(Local1, 0x28), LLessEqual(Local1, 0x3C)))
										{
											Store(One, DBDC)
										}
									}
									Or(DBAC, ShiftLeft(DBDC, One), PC02)
									Store(ATPP, TPPA)
									Store(DTPP, TPPD)
									Store(AMAT, MAGA)
									Store(AMIT, MIGA)
									Store(DROS, DROP)
								}
								If(LEqual(ToInteger(NIGS), One))
								{
									If(LEqual(ToInteger(PWCS), One))
									{
										Store(One, \_SB.PC00.LPCB.EC0.DBST)
									}
									Else
									{
										Store(Zero, \_SB.PC00.LPCB.EC0.DBST)
									}
									If(LEqual(ToInteger(PWTS), One)) {}
									Else {}
									If(LEqual(ToInteger(CGPS), One)) {}
									Else {}
									Store(Zero, TGPA)
									Store(Zero, TGPD)
									Store(Zero, PC01)
									Store(Zero, PC02)
									Store(Zero, TPPA)
									Store(Zero, TPPD)
									Store(Zero, MAGA)
									Store(Zero, MIGA)
									Store(Zero, MAGD)
