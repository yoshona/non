					Store(Add(DerefOf(Index(Local1, 0x02)), 0x0AAC), Index(Arg1, 0x07))
					Store(Add(DerefOf(Index(Local1, 0x03)), 0x0AAC), Index(Arg1, 0x08))
					Store(Add(DerefOf(Index(Local1, 0x04)), 0x0AAC), Index(Arg1, 0x09))
