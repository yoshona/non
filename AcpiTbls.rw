										Store(One, FUNA)
									}
									If(CondRefOf(UPRD))
									{
										Store(One, FUNB)
									}
								}
								ADBG(Concatenate("_DSM PCIe RP OPTS -", ToHexString(OPTS)))
								Return(OPTS)
