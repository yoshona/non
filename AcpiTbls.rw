	Scope(\_SB.PC00.TCPU)
	{
		Name(PFLG, Zero)
		Method(_STA, 0, NotSerialized)
		{
			If(LEqual(\_SB.SADE, One))
			{
				Return(0x0F)
			}
			Else
			{
				Return(Zero)
			}
		}
		OperationRegion(CPWR, SystemMemory, Add(ShiftLeft(\_SB.PC00.MC.MHBR, 0x0F), 0x5000), 0x1000)
		Field(CPWR, ByteAcc, NoLock, Preserve)
		{
			Offset(0x930),	//Offset(2352),
			PTDP, 15,
			, 1,
			PMIN, 15,
			, 1,
			PMAX, 15,
			, 1,
			TMAX, 7,
			Offset(0x938),	//Offset(2360),
			PWRU, 4,
			, 4,
			EGYU, 5,
			, 3,
			TIMU, 4,
			Offset(0x958),	//Offset(2392),
			Offset(0x95C),	//Offset(2396),
			LPMS, 1,
			CTNL, 2,
			Offset(0x978),	//Offset(2424),
			PCTP, 8,
			Offset(0x998),	//Offset(2456),
			RP0C, 8,
			RP1C, 8,
			RPNC, 8,
			Offset(0xF3C),	//Offset(3900),
			TRAT, 8,
			Offset(0xF40),	//Offset(3904),
			PTD1, 15,
			, 1,
			TRA1, 8,
			, 8,
			PMX1, 15,
			, 1,
			PMN1, 15,
			, 1,
			PTD2, 15,
			, 1,
			TRA2, 8,
			, 8,
			PMX2, 15,
			, 1,
			PMN2, 15,
			, 1,
			CTCL, 2,
			, 6,
			Offset(0xF53),	//Offset(3923),
			, 7,
			CLCK, 1,
			MNTR, 8,
		}
		Name(XPCC, Zero)
		Method(PPCC, 0, Serialized)
		{
			Name(_T_0, Zero)
			If(LAnd(LEqual(XPCC, Zero), CondRefOf(\_SB.CBMI)))
			{
				While(One)
				{
					Store(ToInteger(\_SB.CBMI), _T_0)
					If(LEqual(_T_0, Zero))
					{
						If(LAnd(LGreaterEqual(\_SB.CLVL, One), LLessEqual(\_SB.CLVL, 0x03)))
						{
							CPL0()
							Store(One, XPCC)
						}
					}
					Else
					{
						If(LEqual(_T_0, One))
						{
							If(LOr(LEqual(\_SB.CLVL, 0x02), LEqual(\_SB.CLVL, 0x03)))
							{
								CPL1()
								Store(One, XPCC)
							}
						}
						Else
						{
							If(LEqual(_T_0, 0x02))
							{
								If(LEqual(\_SB.CLVL, 0x03))
								{
									CPL2()
									Store(One, XPCC)
								}
							}
						}
					}
					Break
				}
			}
			Return(NPCC)
		}
		Name(NPCC, Package(3)
		{
			0x02, 
			Package(6) {Zero, 0x88B8, 0xAFC8, 0x6D60, 0x7D00, 0x03E8}, 
			Package(6) {One, 0xDBBA, 0xDBBA, Zero, Zero, 0x03E8}
		})
		Method(CPNU, 2, Serialized)
		{
			Name(CNVT, Zero)
			Name(PPUU, Zero)
			Name(RMDR, Zero)
			If(LEqual(PWRU, Zero))
			{
				Store(One, PPUU)
			}
			Else
			{
				ShiftLeft(Decrement(PWRU), 0x02, PPUU)
			}
			Divide(Arg0, PPUU, RMDR, CNVT)
			If(LEqual(Arg1, Zero))
			{
				Return(CNVT)
			}
			Else
			{
				Multiply(CNVT, 0x03E8, CNVT)
				Multiply(RMDR, 0x03E8, RMDR)
				Divide(RMDR, PPUU, , RMDR)
				Add(CNVT, RMDR, CNVT)
				Return(CNVT)
			}
		}
		Method(CPL0, 0, NotSerialized)
		{
			Store(0x02, Index(\_SB.PC00.TCPU.NPCC, Zero))
			Store(Zero, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), Zero))
			Store(0x7D, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), One))
			Store(CPNU(\_SB.PL10, One), Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x02))
			Multiply(\_SB.PLW0, 0x03E8, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x03))
			Add(Multiply(\_SB.PLW0, 0x03E8), 0x0FA0, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x04))
			Store(PPSZ, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x05))
			Store(One, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), Zero))
			Store(CPNU(\_SB.PL20, One), Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), One))
			Store(CPNU(\_SB.PL20, One), Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), 0x02))
			Store(Zero, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), 0x03))
			Store(Zero, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), 0x04))
			Store(PPSZ, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, 0x02)), 0x05))
		}
		Method(CPL1, 0, NotSerialized)
		{
			Store(0x02, Index(\_SB.PC00.TCPU.NPCC, Zero))
			Store(Zero, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), Zero))
			Store(0x7D, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), One))
			Store(CPNU(\_SB.PL11, One), Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x02))
			Multiply(\_SB.PLW1, 0x03E8, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x03))
			Add(Multiply(\_SB.PLW1, 0x03E8), 0x0FA0, Index(DerefOf(Index(\_SB.PC00.TCPU.NPCC, One)), 0x04))
