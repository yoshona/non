			Store(Local0, CMDR)
			Store(Zero, Local0)
			While(One)
			{
				If(LOr(LNot(IBSY), LEqual(IERR, One)))
				{
					Break
				}
				If(LGreater(Local0, 0x0A))
				{
					ADBG("IPC Busy TO")
					Store(0x03, Index(RPKG, Zero))
					Return(RPKG)
				}
				Sleep(One)
				Increment(Local0)
			}
			If(LEqual(IERR, One))
			{
				ADBG("IPC Error:")
				ADBG(IERC)
				ADBG(Arg0)
				ADBG(Arg1)
				ADBG(Arg2)
				ADBG(Arg3)
				ADBG(Arg4)
				ADBG(Arg5)
				ADBG(Arg6)
				Store(0x02, Index(RPKG, Zero))
				Return(RPKG)
			}
			Store(IRB0, Index(RPKG, One))
			Store(IRB1, Index(RPKG, 0x02))
			Store(IRB2, Index(RPKG, 0x03))
			Store(IRB3, Index(RPKG, 0x04))
			Return(RPKG)
		}
