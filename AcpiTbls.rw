					Store(Local0, Arg2)
					Store(Zero, Local1)
					While(LLess(Local1, Local0))
					{
						Store(DerefOf(Index(Arg0, Add(Local1, One))), Index(Arg1, Local1))
						ADBG(Concatenate("Adding to volume: ", ToHexString(DerefOf(Index(Arg1, Local1)))))
						Increment(Local1)
					}
				}
				Method(_DSM, 4, Serialized)
