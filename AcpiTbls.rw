					}
					If(LAnd(CondRefOf(\_SB.PC00.RP17.TUID), CondRefOf(\DTRT)))
					{
						Device(TBDH)
						{
							Name(_ADR, Zero)
							If(LLessEqual(\_SB.PC00.RP17.TUID, One))
							{
								If(LEqual(\_SB.PC00.RP17.TUID, Zero))
								{
									Device(NHI4)
									{
										Name(_ADR, Zero)
