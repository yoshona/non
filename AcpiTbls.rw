									0x09
								})
							}
							If(LEqual(Arg2, One)) {}
							If(LEqual(Arg2, 0x02)) {}
							If(LEqual(Arg2, 0x03))
							{
								If(LEqual(WRTO, One))
								{
									ADBG("WWAN Power _DSM D0/L1.2")
								}
								Else
								{
									If(LEqual(WRTO, 0x02))
									{
										ADBG("WWAN Power _DSM D3/L1.2")
									}
									Else
									{
										If(LEqual(WRTO, 0x03))
										{
											ADBG("WWAN Power _DSM D3/L2")
										}
										Else
