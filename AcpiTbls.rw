									If(CondRefOf(PPBA))
									{
										Store(One, FUNA)
									}
									If(CondRefOf(UPRD))
									{
										Store(One, FUNB)
									}
								}
								ADBG(Concatenate("_DSM PCIe RP OPTS -", ToHexString(OPTS)))
								Return(OPTS)
							}
							Else
							{
								If(LEqual(_T_0, 0x06))
								{
									If(LGreaterEqual(Arg1, 0x02))
