			Return(GNOT(0x04, Zero))
		}
		Method(IUEH, 1, Serialized)
		{
			And(IUER, 0xC0, IUER)
			Xor(IUER, ShiftLeft(One, Arg0), IUER)
			If(LLessEqual(Arg0, 0x04))
			{
				Return(AINT(0x05, Zero))
			}
			Else
			{
				Return(AINT(Arg0, Zero))
			}
		}
		Method(AINT, 2, NotSerialized)
		{
			If(LAnd(LGreaterEqual(Arg0, 0x05), LLessEqual(Arg0, 0x07)))
			{
				Store(Zero, Local2)
				While(LLess(Local2, 0xFA))
				{
					Sleep(0x04)
					Increment(Local2)
				}
				Return(Zero)
			}
			If(LEqual(Arg0, One))
			{
				Store(Divide(Multiply(Arg1, 0xFF), 0x64, , ), BCL1)
				Or(BCL1, 0x80000000, BCL1)
			}
			Return(Zero)
		}
		Method(_DSM, 4, Serialized)
		{
			Name(_T_1, Zero)
			Name(_T_0, Zero)
			If(LEqual(Arg0, ToUUID("3E5B41C6-EB1D4260-9D15C71FBADAE414")}))
			{
				While(One)
				{
					Store(ToInteger(Arg2), _T_0)
					If(LEqual(_T_0, Zero))
					{
						If(LEqual(Arg1, One))
						{
							Store("iGfx Supported Functions Bitmap ", Debug)
							ADBG("iGFX Empty Dongle SKU supported")
							Store(One, Local0)
							If(LNotEqual(EDMX, Zero))
							{
								ADBG("Display Mux Supported")
								Or(Local0, 0x00200000, Local0)
							}
							Or(Local0, 0x00400000, Local0)
							ADBG(Concatenate("IGFX DSM Function Support = ", ToHexString(Local0)))
							Return(Local0)
						}
					}
					Else
					{
						If(LEqual(_T_0, 0x15))
						{
							Name(DGDB, Buffer(0x05)
							{
								0x00, 0x00, 0x00, 0x00, 0x00
							})
							CreateDWordField(DGDB, Zero, DGDF)
							CreateByteField(DGDB,0x04,DGSF)
							Store(One, Local0)
							ADBG("IGD eDP _DSM (21)")
							If(LEqual(And(DerefOf(Index(Arg3, Zero)), One), Zero))
							{
								ADBG("Get Current Disp Mux Status")
								\_SB.GGOV(EDMX)
								Store(Zero, Local0)
							}
							Else
							{
								ADBG("Set Disp Mux Status")
								If(LEqual(And(DerefOf(Index(Arg3, Zero)), 0x02), Zero))
								{
									ADBG("Set Disp Mux to iGfx")
									\_SB.SGOV(EDMX, Zero)
									Store(Zero, Local0)
								}
								Else
								{
									ADBG("Set Disp Mux to dGfx")
									\_SB.SGOV(EDMX, One)
									Store(Zero, Local0)
								}
							}
							Store(ShiftLeft(\_SB.GGOV(EDMX), One), DGDF)
							Store(Local0, DGSF)
							ADBG(Concatenate("ExitResult :: ", ToHexString(DGSF)))
							ADBG(Concatenate("Current Mux :: ", ToHexString(DGDF)))
							Return(DGDB)
						}
						Else
						{
							If(LEqual(_T_0, 0x16))
							{
								While(One)
								{
									Store(ToInteger(Arg3), _T_1)
									If(LEqual(_T_1, Zero))
									{
										If(CondRefOf(\_SB.PC00.LPCB.H_EC.LSTE))
										{
											\_SB.PC00.LPCB.H_EC.ECWT(Zero, RefOf(\_SB.PC00.LPCB.H_EC.LSTE))
											Store(Zero, LIDS)
											Store(Zero, \_SB.PC00.GFX0.CLID)
											ADBG("Notify LID0")
											Notify(\_SB.PC00.LPCB.H_EC.LID0, 0x80)
											ADBG("OS Notified")
											Return(Zero)
										}
										Else
										{
											ADBG("Lid close failed")
										}
									}
									Else
									{
										If(LEqual(_T_1, One))
										{
											If(CondRefOf(\_SB.PC00.LPCB.H_EC.LSTE))
											{
												\_SB.PC00.LPCB.H_EC.ECWT(One, RefOf(\_SB.PC00.LPCB.H_EC.LSTE))
												Store(One, LIDS)
												Store(0x03, \_SB.PC00.GFX0.CLID)
												ADBG("Notify LID0")
												Notify(\_SB.PC00.LPCB.H_EC.LID0, 0x80)
												ADBG("OS Notified")
												Return(Zero)
											}
											Else
											{
												ADBG("Lid open failed")
											}
										}
										Else
										{
											Return(One)
										}
									}
									Break
								}
							}
						}
					}
					Break
				}
			}
			Return(Buffer(One)
			{
				0x00
			})
		}
