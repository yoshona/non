					{
						If(LEqual(BCCX, One))
						{
							If(LEqual(SCCX, 0x06))
							{
								If(LEqual(PIXX, One))
								{
									ADBG("PSSD AHCI")
									Return(One)
								}
							}
						}
						Return(Zero)
					}
					Method(PNVM, 0, Serialized)
					{
						If(LEqual(BCCX, One))
						{
							If(LEqual(SCCX, 0x08))
							{
								If(LEqual(PIXX, 0x02))
