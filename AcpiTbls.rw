					Store(Zero, DADR)
					Store(Zero, DSPD)
					Store(Zero, DADM)
					Store(Zero, SMHX)
					Store(Zero, SMLX)
					Store(Zero, SMTD)
					Store(Zero, SMRD)
					Store(Zero, FMHX)
					Store(Zero, FMLX)
					Store(Zero, FMTD)
					Store(Zero, FMRD)
					Store(Zero, FMSL)
					Store(Zero, FPHX)
					Store(Zero, FPLX)
					Store(Zero, FPTD)
					Store(Zero, FPRD)
					Store(Zero, HMHX)
					Store(Zero, HMLX)
					Store(Zero, HMTD)
					Store(Zero, HMRD)
					Store(Zero, HMSL)
					Method(_DSM, 4, Serialized)
					{
						Name(_T_5, Zero)
						Name(_T_4, Zero)
						Name(_T_3, Zero)
						Name(_T_2, Zero)
						Name(_T_1, Zero)
						Name(_T_0, Zero)
						If(PCIC)
						{
							Arg0
							Return(PCID)
							Arg0
							Arg1
							Arg2
							Arg3
						}
						If(LEqual(TMD0, One))
						{
							If(LEqual(Arg0, ToUUID("6E2AC436-0FCF41AF-A265B32A220DCFAB")}))
							{
								While(One)
								{
									Store(ToInteger(Arg2), _T_0)
									If(LEqual(_T_0, Zero))
									{
										While(One)
										{
											Store(ToInteger(Arg1), _T_1)
											If(LEqual(_T_1, 0x02))
											{
												Return(Buffer(One)
												{
													0x7F
												})
											}
											Else
											{
												Return(Buffer(One)
												{
													0x00
												})
											}
											Break
										}
									}
									Else
									{
										If(LEqual(_T_0, One))
										{
											ADBG("THC THC_INPUT_REPORT_HEADER_ADDRESS")
											Return(ToInteger(T040))
										}
										Else
										{
											If(LEqual(_T_0, 0x02))
											{
												ADBG("THC THC_INPUT_REPORT_BODY_ADDRESS")
												Return(ToInteger(T050))
											}
											Else
											{
												If(LEqual(_T_0, 0x03))
												{
													ADBG("THC THC_OUTPUT_REPORT_ADDRESS")
													Return(ToInteger(T060))
												}
												Else
												{
													If(LEqual(_T_0, 0x04))
													{
														ADBG("THC THC_READ_OPCODE")
														Name(BUF4, Buffer(One){})
														Store(ToBuffer(T070), Local0)
														Store(DerefOf(Index(Local0, Zero)), Index(BUF4, Zero))
														Return(BUF4)
													}
													Else
													{
														If(LEqual(_T_0, 0x05))
														{
															ADBG("THC THC_WRITE_OPCODE")
															Name(BUF5, Buffer(One){})
															Store(ToBuffer(T080), Local1)
															Store(DerefOf(Index(Local1, Zero)), Index(BUF5, Zero))
															Return(BUF5)
														}
														Else
														{
															If(LEqual(_T_0, 0x06))
															{
																ADBG("THC THC_FLAGS")
																Return(ToInteger(T090))
															}
															Else
