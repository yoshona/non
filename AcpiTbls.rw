							Store(Zero, RSTL)
						}
						Name(_DSD, Package(4)
						{
							Buffer(0x10)
							{
								0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
								0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
							}, 
							ICRS, 
							Buffer(0x10)
							{
								0xE6, 0xE3, 0xB8, 0xDB, 0x86, 0x58, 0xA6, 0x4B, 
								0x87, 0x95, 0x13, 0x19, 0xF5, 0x2A, 0x96, 0x6B
							}, 
							ISUB
						})
					}
				}
			}
			Device(THC1)
			{
				Name(_ADR, 0x00100001)
