					}
					Return(Zero)
				}
			}
			Return(Zero)
		}
		Method(STRT, 3, Serialized)
		{
			Name(_T_0, Zero)
			OperationRegion(TPMR, SystemMemory, FTPM, 0x1000)
			Field(TPMR, AnyAcc, NoLock, Preserve)
			{
				Offset(0x4),	//Offset(4),
				FERR, 32,
				Offset(0xC),	//Offset(12),
				BEGN, 32,
			}
			Name(TIMR, Zero)
			If(LNotEqual(ToInteger(Arg0), Zero)) {}
			While(One)
			{
				Store(ToInteger(Arg1), _T_0)
				If(LEqual(_T_0, Zero))
				{
					Return(Buffer(One)
					{
						0x03
					})
				}
				Else
				{
					If(LEqual(_T_0, One))
					{
						Store(Zero, TIMR)
						If(LEqual(AMDT, One))
						{
							While(LAnd(LEqual(BEGN, One), LLess(TIMR, 0x0200)))
							{
								If(LEqual(BEGN, One))
								{
									Sleep(One)
									Increment(TIMR)
								}
							}
						}
						Else
						{
							If(LEqual(Or(And(HSTS, 0x02), And(HSTS, One)), 0x03))
							{
								Store(One, HCMD)
							}
							Else
							{
								Store(One, FERR)
								Store(Zero, BEGN)
							}
						}
						Return(Zero)
					}
				}
				Break
			}
			Return(One)
		}
		Method(CRYF, 3, Serialized)
		{
			Name(_T_0, Zero)
			If(LNotEqual(ToInteger(Arg0), One)) {}
			While(One)
			{
				Store(ToInteger(Arg1), _T_0)
				If(LEqual(_T_0, Zero))
