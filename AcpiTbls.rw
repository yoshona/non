	Scope(\)
	{
		Method(SPCO, 2, Serialized)
		{
			ADBG("Calling SPCO method to configure PCIe ClkReq Override")
			If(LEqual(PCHS, 0x04))
			{
				If(LEqual(Arg1, One))
				{
					If(LGreater(Arg0, 0x03))
					{
						\_SB.ECLK.CLKE(Subtract(Arg0, 0x04))
					}
					Else
					{
						\_SB.ICLK.CLKE(Arg0)
					}
				}
				Else
				{
					If(LGreater(Arg0, 0x03))
					{
						\_SB.ECLK.CLKD(Subtract(Arg0, 0x04))
					}
					Else
					{
						\_SB.ICLK.CLKD(Arg0)
					}
				}
			}
			Else
			{
				If(LEqual(Arg1, One))
				{
					If(LGreater(Arg0, 0x05))
					{
						\_SB.ECLK.CLKE(Subtract(Arg0, 0x06))
					}
					Else
					{
						\_SB.ICLK.CLKE(Arg0)
					}
				}
				Else
				{
					If(LGreater(Arg0, 0x05))
					{
						\_SB.ECLK.CLKD(Subtract(Arg0, 0x06))
					}
					Else
					{
						\_SB.ICLK.CLKD(Arg0)
					}
				}
			}
		}
		Method(HBCM, 2, Serialized)
		{
		}
	}
	Scope(_SB)
	{
