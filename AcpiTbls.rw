	Scope(_SB.PC02.HDAS)
	{
		Method(PPMS, 1, Serialized)
		{
			ADBG("PPMS called")
			ADBG(Arg0)
			If(LEqual(Arg0, Buffer(0x10)
			{
				0x06, 0x81, 0x70, 0x7C, 0xFF, 0x3A, 0xFE, 0x40, 
				0x88, 0xBE, 0x8C, 0x99, 0x9B, 0x3F, 0x74, 0x45
			}))
			{
				Return(And(ADPM, 0x04))
			}
			If(LEqual(Arg0, Buffer(0x10)
			{
				0xA9, 0x4F, 0x77, 0xEC, 0xD3, 0x28, 0x4A, 0x42, 
				0x90, 0xE4, 0x69, 0xF9, 0x84, 0xF1, 0xEE, 0xB7
			}))
			{
				Return(And(ADPM, 0x0100))
			}
			If(LEqual(Arg0, Buffer(0x10)
			{
				0xFD, 0x5F, 0xC7, 0x4B, 0xA1, 0x83, 0x4B, 0x43, 
				0x83, 0xF4, 0xF9, 0xF7, 0x3B, 0xB8, 0xD4, 0x8E
			}))
			{
				Return(And(ADPM, 0x08000000))
			}
			If(LEqual(Arg0, Buffer(0x10)
			{
				0x04, 0x3D, 0x98, 0x52, 0x14, 0x24, 0xB4, 0x88, 
				0xA2, 0xA2, 0xC1, 0x39, 0x7E, 0x13, 0xB0, 0x22
			}))
			{
				Return(And(ADPM, 0x10000000))
			}
			If(LEqual(Arg0, Buffer(0x10)
			{
				0xCC, 0xC8, 0xAC, 0xFA, 0x65, 0xB3, 0x64, 0x49, 
				0xB4, 0xB8, 0xBD, 0x4D, 0xEB, 0x18, 0xD9, 0x22
			}))
			{
				Return(And(ADPM, 0x10000000))
			}
			If(LEqual(Arg0, ACCG(AG1L, AG1H)))
			{
				ADBG("Alpha passed")
				Return(And(ADPM, 0x20000000))
			}
			If(LEqual(Arg0, ACCG(AG2L, AG2H)))
			{
				ADBG("Beta passed")
				Return(And(ADPM, 0x40000000))
			}
			If(LEqual(Arg0, ACCG(AG3L, AG3H)))
			{
				ADBG("Gamma passed")
				Return(And(ADPM, 0x80000000))
			}
			Return(Zero)
		}
