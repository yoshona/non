				Store(Zero, SAC2)
				Return(AC00)
			}
			Method(RKBC, 2, Serialized)
			{
				Store(0xDA, IO80)
				If(LNot(^^PC00.LPCB.EC0.BFLG))
				{
					Store(One, ^^PC00.LPCB.EC0.BFLG)
					If(ECOK)
					{
						Store(Zero, ECOK)
						If(ECON)
						{
							Acquire(ECMX, 0xFFFF)
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
							Store(Arg0, ^^PC00.LPCB.EC0.LDAT)
							Store(Arg1, ^^PC00.LPCB.EC0.HDAT)
							Store(One, ^^PC00.LPCB.EC0.RFLG)
							Store(0x14, FFNT)
							Store(Zero, DTRD)
							While(LNot(DTRD))
							{
								Subtract(FFNT, One, FFNT)
								If(LEqual(FFNT, Zero))
								{
									Store(0x41FEFEFEFEFEFEFE, AC00)
									Break
								}
								Sleep(0x32)
								Store(^^PC00.LPCB.EC0.DRDY, DTRD)
							}
							If(Not(LEqual(FFNT, Zero)))
							{
								Store(^^PC00.LPCB.EC0.CMDL, SA00)
								Store(^^PC00.LPCB.EC0.CMDH, SA01)
							}
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
							Release(ECMX)
						}
						Else
						{
							Store(0x41FEFEFEFEFEFEFE, AC00)
						}
						Store(One, ECOK)
					}
					Else
					{
						Store(0x41FEFEFEFEFEFEFE, AC00)
					}
				}
				Else
				{
					Store(0x41FEFEFEFEFEFEFE, AC00)
				}
				If(ECOK)
				{
					Store(Zero, ^^PC00.LPCB.EC0.BFLG)
				}
				Return(AC00)
			}
			Method(WKBC, 4, Serialized)
			{
				If(LNot(^^PC00.LPCB.EC0.BFLG))
				{
					Store(One, ^^PC00.LPCB.EC0.BFLG)
					If(ECOK)
					{
						Store(Zero, ECOK)
						If(ECON)
						{
							Acquire(ECMX, 0xFFFF)
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
							Store(Arg0, ^^PC00.LPCB.EC0.LDAT)
							Store(Arg1, ^^PC00.LPCB.EC0.HDAT)
							Store(Arg2, ^^PC00.LPCB.EC0.CMDL)
							Store(Arg3, ^^PC00.LPCB.EC0.CMDH)
							Store(One, ^^PC00.LPCB.EC0.WFLG)
							Sleep(0x0A)
							Store(0x14, FFNT)
							Store(Zero, DTRD)
							While(LNot(DTRD))
							{
								Sleep(0x32)
								Decrement(FFNT)
								If(LEqual(FFNT, Zero))
								{
									Store(0x41FEFEFEFEFEFEFE, AC00)
									Break
								}
								Store(^^PC00.LPCB.EC0.DRDY, DTRD)
							}
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
						}
						Else
						{
							Store(0x41FEFEFEFEFEFEFE, AC00)
						}
						Release(ECMX)
					}
					Else
					{
						Store(0x41FEFEFEFEFEFEFE, AC00)
					}
					Store(One, ECOK)
				}
				Else
				{
					Store(0x41FEFEFEFEFEFEFE, AC00)
				}
				If(ECOK)
				{
					Store(Zero, ^^PC00.LPCB.EC0.BFLG)
				}
				Return(AC00)
			}
			Method(SCMD, 1, Serialized)
			{
				If(LNot(^^PC00.LPCB.EC0.BFLG))
				{
					Store(One, ^^PC00.LPCB.EC0.BFLG)
					If(ECOK)
					{
						Store(Zero, ECOK)
						If(ECON)
						{
							Acquire(ECMX, 0xFFFF)
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
							Store(One, ^^PC00.LPCB.EC0.BFLG)
							Store(Arg0, ^^PC00.LPCB.EC0.CMDL)
							Store(One, ^^PC00.LPCB.EC0.CFLG)
							Store(0x14, FFNT)
							Store(Zero, DTRD)
							While(LNot(DTRD))
							{
								Sleep(0x0A)
								Decrement(FFNT)
								If(LEqual(FFNT, Zero))
								{
									Store(0x41FEFEFEFEFEFEFE, AC00)
									Store(0xCC, IO80)
									Break
								}
								Store(^^PC00.LPCB.EC0.DRDY, DTRD)
							}
							Store(Zero, ^^PC00.LPCB.EC0.DRDY)
							Sleep(0x32)
						}
						Else
						{
							Store(0x41FEFEFEFEFEFEFE, AC00)
						}
						Release(ECMX)
					}
					Else
					{
						Store(0x41FEFEFEFEFEFEFE, AC00)
					}
					Store(One, ECOK)
				}
				Else
				{
					Store(0x41FEFEFEFEFEFEFE, AC00)
				}
				If(ECOK)
				{
					Store(Zero, ^^PC00.LPCB.EC0.BFLG)
				}
			}
			Method(OEMF, 1, NotSerialized)
			{
				If(LEqual(SAC1, Zero))
				{
					WKBC(SA00, SA01, SA02, SA03)
					Return(SAC0)
				}
				If(LEqual(SAC1, One))
				{
					WKBC(SA00, SA01, SA02, SA03)
					Return(SAC0)
				}
				If(LEqual(SAC1, 0x0100))
				{
					RKBC(SA00, SA01)
					Return(SAC0)
				}
				If(LEqual(SAC1, 0x0200))
				{
					SCMD(SA00)
					Return(SAC0)
				}
				Store(0xFFFFFFFF, SAC0)
				Return(SAC0)
			}
