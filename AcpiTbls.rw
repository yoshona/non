				{
					Store(ToInteger(Arg0), _T_0)
					If(LEqual(_T_0, Zero))
					{
						Store(CLK0, Local0)
						Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), And(Arg1, 0x03)), CLK0)
					}
					Else
					{
						If(LEqual(_T_0, One))
						{
							Store(CLK1, Local0)
							Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), And(Arg1, 0x03)), CLK1)
						}
						Else
						{
							If(LEqual(_T_0, 0x02))
							{
								Store(CLK2, Local0)
								Store(Or(And(Local0, 0x00FFFFFFFFFFFFFF), And(Arg1, 0x03)), CLK2)
