					Store(BL11, Index(DerefOf(Index(WTSY, One)), 0x0D))
					Store(BL12, Index(DerefOf(Index(WTSY, One)), 0x0E))
					Store(BL13, Index(DerefOf(Index(WTSY, One)), 0x0F))
					Store(BL14, Index(DerefOf(Index(WTSY, One)), 0x10))
					Store(BL15, Index(DerefOf(Index(WTSY, One)), 0x11))
					Store(BL16, Index(DerefOf(Index(WTSY, One)), 0x12))
					Return(WTSY)
				}
				Name(WAIY, Package(2)
				{
					Zero, 
					Package(4) {0x07, Zero, Zero, Zero}
				})
				Method(WAIS, 0, Serialized)
				{
					Store(WLBI, Index(DerefOf(Index(WAIY, One)), One))
					Store(WHBI, Index(DerefOf(Index(WAIY, One)), 0x02))
					Return(WAIY)
				}
				Name(SADX, Package(3)
				{
					Zero, 
					Package(2) {0x07, 0x80000000}, 
					Package(2) {0x12, 0x80000000}
				})
				Method(SADS, 0, Serialized)
				{
					Store(ATDV, Index(DerefOf(Index(SADX, One)), One))
					Store(ATDV, Index(DerefOf(Index(SADX, 0x02)), One))
					Return(SADX)
				}
				Name(GPCX, Package(3)
				{
					Zero, 
					Package(2)
					{
						0x07, 
						Package(3) {Zero, Zero, Zero}
					}, 
					Package(2)
					{
						0x12, 
						Package(3) {Zero, Zero, Zero}
					}
				})
				Method(GPC, 0, Serialized)
				{
					Return(GPCX)
				}
				Name(GLAX, Package(3)
				{
					Zero, 
					Package(2) {0x07, Zero}, 
					Package(2) {0x12, Zero}
				})
				Method(GLAI, 0, Serialized)
				{
					ADBG(Concatenate("AR: GLAI method. CGLS = ", ToHexString(CGLS)))
					Store(CGLS, Index(DerefOf(Index(GLAX, One)), One))
					Store(CGLS, Index(DerefOf(Index(GLAX, 0x02)), One))
					Return(GLAX)
				}
			}
			If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
			{
				Method(FHRF, 1, NotSerialized)
				{
					If(LNotEqual(^^^^PGPI.GGOV, PRST))
					{
						WPRP
						DL23
						ADBG("WWAN DL23() Done")
						^^^^PGPI.SGOV
						PRST
						WPRP
						ADBG("WWAN PERST:0 Done")
					}
					Else
					{
						ADBG("Assume WWAN DL23() is already done")
					}
					Sleep(TR2B)
					^^^^PGPI.SGOV
					WBRS
					PBRS
					ADBG("WWAN RST:0 Done")
					If(LEqual(Arg0, Zero))
					{
						Sleep(TBTG)
						ADBG(Concatenate("SLP TBTG ", ToDecimalString(TBTG)))
					}
					Else
					{
						If(LEqual(Arg0, One))
						{
							SPCO(WCLK, Zero)
							ADBG("WWAN SCLK:0 Done")
							Sleep(TB2F)
							ADBG(Concatenate("SLP TB2F ", ToDecimalString(TB2F)))
							^^^^PGPI.SGOV
							WFCP
							And(Not(PFCP), One)
							ADBG("WWAN PWR:0 Done")
							Sleep(TFDI)
							ADBG(Concatenate("SLP TFDI ", ToDecimalString(TFDI)))
						}
						Else
						{
							ADBG("Unsupported Arg0 is detected.")
						}
					}
				}
				Method(SHRF, 0, NotSerialized)
				{
					PSD0(SLOT)
					ADBG("WWAN MPHYPG:0 Done")
					SPCO(WCLK, One)
					ADBG("WWAN SCLK:1 Done")
					^^^^PGPI.SGOV
					WFCP
					PFCP
					ADBG("WWAN PWR:1 Done")
					Sleep(TN2B)
					ADBG(Concatenate("SLP TN2B ", ToDecimalString(TN2B)))
					^^^^PGPI.SGOV
					WBRS
					And(Not(PBRS), One)
					ADBG("WWAN RST:1 Done")
					Sleep(TB2R)
					ADBG(Concatenate("SLP TB2R ", ToDecimalString(TB2R)))
					^^^^PGPI.SGOV
					PRST
					And(Not(WPRP), One)
					ADBG("WWAN PERST:0 Done")
					L23D
					ADBG("WWAN L23D() Done")
				}
				Method(DOSV, 0, NotSerialized)
				{
					Store(Zero, Local0)
					While(LAnd(LNotEqual(SVID, WSID), LLess(Local0, WSTO)))
					{
						Increment(Local0)
						Sleep(One)
					}
					ADBG(Concatenate("DET Time ", ToDecimalString(Local0)))
				}
				Method(_RST, 0, Serialized)
				{
					ADBG("_RST WWAN")
					If(LEqual(WWEN, 0x02))
					{
						Store(Acquire(WWMT, 0x03E8), Local0)
						ADBG("WWAN FLDR Mutex: Acquired Try Done")
						If(LEqual(Local0, Zero))
						{
							ADBG("Start WWAN FLDR")
							FHRF
							Zero
							SHRF
							ADBG("End WWAN FLDR")
							Release(WWMT)
							ADBG("WWAN FLDR Mutex:Release Done")
							DOSV
						}
					}
					Else
					{
						^^^^PGPI.SGOV
						WBRS
						PBRS
						Sleep(0xC8)
						Notify(PXSX, One)
						^^^^PGPI.SGOV
						PRST
						And(Not(WPRP), One)
						^^^^PGPI.SGOV
						WBRS
						And(Not(PBRS), One)
						Sleep(0xC8)
						Store(Zero, Local0)
						While(LEqual(LASX, Zero))
						{
							If(LGreater(Local0, 0x14))
							{
								ADBG("FLDR TO")
								Break
							}
							Sleep(0x10)
							Increment(Local0)
						}
						Sleep(0x0A)
						ADBG(Concatenate("RVP Delay Time ", ToDecimalString(Local0)))
						Notify(PXSX, One)
					}
				}
				PowerResource(MRST, 5, 0)
				{
					Method(_STA, 0, Serialized)
					{
						ADBG("WWAN PR _STA")
						Return(One)
					}
					Method(_ON, 0, Serialized)
					{
						ADBG("WWAN PR _ON")
					}
					Method(_OFF, 0, Serialized)
					{
						ADBG("WWAN PR _OFF")
					}
					Method(_RST, 0, Serialized)
					{
						Store(Acquire(WWMT, 0x03E8), Local0)
						ADBG("WWAN PLDR Mutex: Acquired Try Done")
						If(LEqual(Local0, Zero))
						{
							ADBG("Start WWAN PLDR")
							FHRF
							One
							SHRF
							ADBG("End WWAN PR _RST")
							Release(WWMT)
							ADBG("WWAN PLDR Mutex: Release Done")
							DOSV
						}
					}
				}
			}
			If(LOr(WIST, LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT))))
			{
				Method(_PRR, 0, NotSerialized)
				{
					If(WIST)
					{
						If(CondRefOf(WRST))
						{
							Return(Package(1) {WRST})
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(CondRefOf(MRST))
						{
							Return(Package(1) {MRST})
						}
					}
					Return(Package(1) {WRST})
				}
				Name(FDEL, Zero)
				Name(PDEL, Zero)
				Name(VDEL, Zero)
				Method(IFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(One)
							{
								0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						ADBG(Concatenate("vPro: ", CVPR))
						ShiftLeft(CVPR, Zero, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x02))
					{
						CreateWordField(Arg3, Zero, CMDT)
						CreateWordField(Arg3, 0x02, CMDP)
						ADBG(Concatenate("CmdType = ", ToHexString(CMDT)))
						ADBG(Concatenate("CmdPayload = ", ToHexString(CMDP)))
						If(LEqual(CMDT, One))
						{
							If(WIST)
							{
								Return(RSTY)
							}
							Else
							{
								If(CondRefOf(\_SB.PC02.CNVW.RSTT))
								{
									ADBG(Concatenate("Get _PRR Mode = ", ^^^CNVW.RSTT))
									Return(^^^CNVW.RSTT)
								}
								Else
								{
									Return(Zero)
								}
							}
						}
						If(LEqual(CMDT, 0x02))
						{
							If(WIST)
							{
								And(CMDP, One, Local0)
								Store(Local0, RSTY)
								And(CMDP, 0x02, Local1)
								ShiftRight(Local1, One, Local1)
								Store(Local1, FLRC)
								And(CMDP, 0x04, Local2)
								ShiftRight(Local2, 0x02, Local2)
								Store(Local2, BOFC)
							}
							Else
							{
								If(CondRefOf(\_SB.PC02.CNVW.RSTT))
								{
									ADBG(Concatenate("Set _PRR Mode = ", ToHexString(CMDP)))
									Store(CMDP, ^^^CNVW.RSTT)
								}
							}
							Return(Zero)
						}
						If(LEqual(CMDT, 0x03))
						{
							If(CondRefOf(\_SB.PC02.CNVW.PRRS))
							{
								ADBG(Concatenate("Get Last_PRR status PRRS = ", ToHexString(^^^CNVW.PRRS)))
								Return(^^^CNVW.PRRS)
							}
							Else
							{
								If(WIST)
								{
									ADBG(Concatenate("Get Last_PRR status DPRS = ", ToHexString(DPRS)))
									Return(DPRS)
								}
							}
						}
						Return(Zero)
					}
					If(LEqual(Arg2, 0x04))
					{
						CreateWordField(Arg3, Zero, PRTT)
						CreateWordField(Arg3, 0x02, PRTD)
						ADBG(Concatenate("TimerType = ", ToHexString(PRTT)))
						ADBG(Concatenate("TimerDuration (ms) = ", ToDecimalString(PRTD)))
						If(LEqual(PRTT, One))
						{
							Store(PRTD, FDEL)
						}
						Else
						{
							If(LEqual(PRTT, 0x02))
							{
								Store(PRTD, PDEL)
							}
							Else
							{
								If(LEqual(PRTT, 0x03))
								{
									Store(PRTD, VDEL)
								}
								Else
								{
									ADBG("TimerDuration not set")
								}
							}
						}
					}
					Return(Zero)
				}
				Method(IDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0x2C, 0x17, 0x66, 0x72, 0x0B, 0x22, 0x29, 0x4B, 
						0x81, 0x4F, 0x75, 0xE4, 0xDD, 0x26, 0xB5, 0xFD
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
				Method(EFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(0x02)
							{
								0xFF, 0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						Store(ACSD, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x02))
					{
						Store(I5BS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x03))
					{
						Store(UHBS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x06))
					{
						Store(AXMU, Local0)
						ShiftLeft(Local0, One, Local0)
						Or(Local0, AXSU, Local0)
						Store(AXMR, Local1)
						ShiftLeft(Local1, One, Local1)
						Or(Local1, AXSR, Local1)
						ShiftLeft(Local1, 0x02, Local1)
						Or(Local0, Local1, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x04))
					{
						Return(WFRC)
					}
					If(LEqual(Arg2, 0x05))
					{
						Return(WFUC)
					}
					If(LEqual(Arg2, 0x07))
					{
						Return(UNI4)
					}
					If(LEqual(Arg2, 0x08))
					{
						Return(WFIC)
					}
					If(LEqual(Arg2, 0x09))
					{
						Return(WFBS)
					}
					If(LEqual(Arg2, 0x0A))
					{
						Return(WEDT)
					}
					If(LEqual(Arg2, 0x0B))
					{
						If(CondRefOf(DRIE))
						{
							If(CondRefOf(CRFI))
							{
								If(LAnd(LEqual(DRIE, One), LEqual(CRFI, One)))
								{
									Return(Zero)
								}
								Else
								{
									If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, One)))
									{
										Return(One)
									}
									Else
									{
										If(LAnd(LEqual(DRIE, One), LEqual(CRFI, Zero)))
										{
											Return(0x02)
										}
										Else
										{
											If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, Zero)))
											{
												Return(0x03)
											}
										}
									}
								}
							}
						}
						Return(Zero)
					}
					If(LEqual(Arg2, 0x0C))
					{
						Return(WF7C)
					}
					Return(Zero)
				}
				Method(EDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0xBF, 0x02, 0x12, 0xF2, 0x78, 0x8F, 0xC6, 0x4D, 
						0xA5, 0xB3, 0x1F, 0x73, 0x8E, 0x28, 0x5A, 0xDE
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
			}
			Method(_DSM, 4, Serialized)
			{
				If(LOr(WIST, LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT))))
				{
					If(WIST)
					{
						If(EDSM)
						{
							Arg0
							Return(EFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
						If(IDSM)
						{
							Arg0
							Return(IFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(LEqual(Arg0, ToUUID("BAD01B75-22A84F48-8792BDDE9467747D")}))
						{
							If(LEqual(Arg2, Zero))
							{
								Return(Buffer(One)
								{
									0x09
								})
							}
							If(LEqual(Arg2, One)) {}
							If(LEqual(Arg2, 0x02)) {}
							If(LEqual(Arg2, 0x03))
							{
								If(LEqual(WRTO, One))
								{
									ADBG("WWAN Power _DSM D0/L1.2")
								}
								Else
								{
									If(LEqual(WRTO, 0x02))
									{
										ADBG("WWAN Power _DSM D3/L1.2")
									}
									Else
									{
										If(LEqual(WRTO, 0x03))
										{
											ADBG("WWAN Power _DSM D3/L2")
										}
										Else
										{
											ADBG("WWAN Power _DSM Disabled")
										}
									}
								}
								Return(WRTO)
							}
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
		}
	}
	If(CondRefOf(\_SB.PC02.RP09.PXSX))
	{
		Scope(_SB.PC02.RP09.PXSX)
		{
			OperationRegion(RPXX, SystemMemory, GMIO(PBNU, ^_ADR, _ADR), 0x30)
			Field(RPXX, AnyAcc, NoLock, Preserve)
			{
				VDID, 32,
				Offset(0x2C),	//Offset(44),
				SVID, 16,
			}
			OperationRegion(FLDR, SystemMemory, Add(GMIO(PBNU, ^_ADR, _ADR), WDCO), 0x06)
			Field(FLDR, ByteAcc, NoLock, Preserve)
			{
				DCAP, 32,
				DCTR, 16,
			}
			OperationRegion(VSEC, SystemMemory, Add(GMIO(PBNU, ^_ADR, _ADR), WVHO), 0x10)
			Field(VSEC, AnyAcc, NoLock, Preserve)
			{
				Offset(0xC),	//Offset(12),
				, 1,
				BTIE, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				, 1,
				PDRC, 1,
			}
			OperationRegion(PBRR, SystemMemory, GMIO(PBNU, ^_ADR, _ADR), 0x02B8)
			Field(PBRR, AnyAcc, NoLock, Preserve)
			{
				Offset(0x18C),	//Offset(396),
				MSNL, 32,
				Offset(0x198),	//Offset(408),
				L1C1, 32,
				L1C2, 32,
				Offset(0x2B4),	//Offset(692),
				PTMR, 32,
			}
			Method(WIST, 0, Serialized)
			{
				Name(_T_0, Zero)
				If(CondRefOf(VDID))
				{
					While(One)
					{
						Store(ToInteger(VDID), _T_0)
						If(LEqual(_T_0, 0x25268086))
						{
							Return(One)
						}
						Else
						{
							If(LEqual(_T_0, 0x271B8086))
							{
								Return(One)
							}
							Else
							{
								If(LEqual(_T_0, 0x27238086))
								{
									Return(One)
								}
								Else
								{
									If(LEqual(_T_0, 0x27258086))
									{
										Return(One)
									}
									Else
									{
										If(LEqual(_T_0, 0x272B8086))
										{
											Return(One)
										}
										Else
										{
											If(LEqual(SVDC, One))
											{
												Return(One)
											}
											Return(Zero)
										}
									}
								}
							}
						}
						Break
					}
				}
				Else
				{
					Return(Zero)
				}
			}
			Method(WWST, 0, Serialized)
			{
				Name(_T_0, Zero)
				If(CondRefOf(VDID))
				{
					While(One)
					{
						Store(ToInteger(VDID), _T_0)
						If(LEqual(_T_0, 0x73608086))
						{
							Return(One)
						}
						Else
						{
							If(LEqual(_T_0, 0x75608086))
							{
								Return(One)
							}
							Else
							{
								If(LEqual(_T_0, 0x4D7514C3))
								{
									Return(One)
								}
								Else
								{
									If(LEqual(_T_0, 0x080014C3))
									{
										Return(One)
									}
									Else
									{
										Return(Zero)
									}
								}
							}
						}
						Break
					}
				}
				Else
				{
					Return(Zero)
				}
			}
			If(WIST)
			{
				Name(RSTY, Zero)
				Name(FLRC, Zero)
				Name(BOFC, Zero)
				Name(DPRS, Zero)
				PowerResource(WRST, 5, 0)
				{
					Method(_STA, 0, NotSerialized)
					{
						ADBG("Wifi PR _STA")
						Return(One)
					}
					Method(_ON, 0, NotSerialized)
					{
						ADBG("Wifi PR _ON")
					}
					Method(_OFF, 0, NotSerialized)
					{
						ADBG("Wifi PR _OFF")
					}
					Method(_RST, 0, NotSerialized)
					{
						If(LEqual(RSTY, One))
						{
							ADBG("Wifi Product RST")
							Store(Acquire(CNMT, 0x03E8), Local0)
							If(LEqual(Local0, Zero))
							{
								If(LEqual(FLRC, One))
								{
									Store(DCTR, Local0)
									Or(Local0, 0x8000, Local0)
									Store(Local0, DCTR)
									Sleep(FDEL)
								}
								Store(One, DPRS)
								If(LEqual(BOFC, One))
								{
									If(LEqual(BRMT, Zero))
									{
										BTRK(Zero)
									}
									Else
									{
										If(LNotEqual(WVHO, Zero))
										{
											Store(Zero, BTIE)
										}
									}
									Sleep(RDLY)
								}
								Store(One, PDRC)
								Sleep(VDEL)
								^^^^^PGPI.SGOV
								WLRT
								Zero
								Sleep(PDEL)
								^^^^^PGPI.SGOV
								WLRT
								One
								If(LEqual(BOFC, One))
								{
									If(LEqual(BRMT, Zero))
									{
										BTRK(One)
									}
									Else
									{
										If(LNotEqual(WVHO, Zero))
										{
											Store(One, BTIE)
										}
									}
									Sleep(RDLY)
								}
								Store(0x02, DPRS)
								Release(CNMT)
							}
						}
						Else
						{
