																Return(Buffer(One)
																{
																	0x00
																})
															}
														}
													}
												}
											}
										}
									}
									Break
								}
								Return(Buffer(One)
								{
									0x00
								})
							}
							If(LEqual(Arg0, ToUUID("300D35B7-AC20413E-8E9C92E4DAFD0AFE")}))
							{
								While(One)
								{
									Store(ToInteger(Arg2), _T_2)
