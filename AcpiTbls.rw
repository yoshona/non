		Scope(_SB.PC00)
		{
			If(LEqual(CRFP, One))
			{
				If(LEqual(CWFC, One))
				{
					Device(CNVW)
					{
						Name(_ADR, 0x00140003)
						Name(PU2C, Zero)
						Store(\PU2C, PU2C)
						Method(BASE, 0, NotSerialized)
						{
							Store(PC2M(_ADR, Zero), Local0)
							Return(Local0)
						}
						Method(_PS0, 0, Serialized)
						{
							ADBG("CNVW Ctrlr D0")
							S023(0x02, One)
						}
						Method(_PS3, 0, Serialized)
						{
							ADBG("CNVW Ctrlr D3")
							Store(PCRR(PCNV, 0x8100), Local0)
							If(LEqual(And(Local0, 0x7F), 0x4C))
							{
								S023(0x02, Zero)
							}
						}
						Method(_PRW, 0, NotSerialized)
						{
							If(CondRefOf(GP1E))
							{
								If(LNotEqual(GP1E, Zero))
								{
									Return(GPRW(0x85, 0x04))
								}
							}
							Return(GPRW(0x6D, 0x04))
						}
						Name(ADEL, Zero)
						If(LEqual(ARLM, One))
						{
							Store(0x32, ADEL)
						}
						Else
						{
							Store(0x0A, ADEL)
						}
						Name(RSTT, Zero)
						Name(PRRS, Zero)
						OperationRegion(CWAR, SystemMemory, BASE, 0x0100)
						Field(CWAR, WordAcc, NoLock, Preserve)
						{
							VDID, 32,
							Offset(0x44),	//Offset(68),
							Offset(0x47),	//Offset(71),
							, 4,
							WFLR, 1,
							, 3,
							Offset(0x49),	//Offset(73),
							, 7,
							WIFR, 1,
						}
						Method(_S0W, 0, NotSerialized)
						{
							Return(0x03)
						}
						Method(_DSW, 3, NotSerialized)
						{
						}
						PowerResource(WRST, 5, 0)
						{
							Method(_STA, 0, NotSerialized)
							{
								Return(One)
							}
							Method(_ON, 0, NotSerialized)
							{
							}
							Method(_OFF, 0, NotSerialized)
							{
							}
							Method(_RST, 0, NotSerialized)
							{
								Store(Acquire(CNMT, 0x03E8), Local0)
								If(LEqual(Local0, Zero))
								{
									CFLR
									Store(One, PRRS)
									If(LAnd(CondRefOf(RSTT), LEqual(RSTT, One)))
									{
										ADBG("WiFi Product Reset")
										ADBG(Concatenate("PID of CNVi = ", ToHexString(PCNV)))
										Store(^^^SBSC.PCRR, PCNV)
										0x80
										Local5
										ADBG(Concatenate("Register PLDB Value = ", ToHexString(Local5)))
										If(LEqual(And(^^^SBSC.PCRR, PCNV, NameObject), 0x80))
										{
											0x02
											Zero
											Zero
											ADBG("ABORT_REQUEST = 0, previous PLDR completed")
											If(LEqual(GBTR(), One))
											{
												BTRK(Zero)
												Sleep(0xA0)
												Store(One, Local2)
											}
											^^^SBSC.PCRO
											PCNV
											0x80
											0x03
											ADBG(Concatenate("WiFi PLDR Timeout wait(ms) = ", ToHexString(ADEL)))
											Sleep(ADEL)
											Store(^^^SBSC.PCRR, PCNV)
											0x80
											Local1
											ADBG(Concatenate("CNVI_PLDR_ABORT = ", ToHexString(Local1)))
											If(LAnd(LEqual(And(Local1, 0x02), Zero), And(Local1, 0x04)))
											{
												ADBG("WiFi Product Reset Completed")
												Store(0x02, PRRS)
												If(LEqual(Local2, One))
												{
													BTRK(One)
													Sleep(0xA0)
												}
											}
											Else
											{
												Store(0x04, PRRS)
												BTRK(One)
											}
										}
										Else
										{
											Store(0x03, PRRS)
										}
									}
									ADBG(Concatenate("WiFi PRRS = ", PRRS))
									Release(CNMT)
								}
							}
						}
						Name(_PRR, Package(1) {WRST})
						Method(CFLR, 0, NotSerialized)
						{
							ADBG(Concatenate("WiFi Core Reset, WFLR = ", WFLR))
							If(LEqual(WFLR, One))
							{
								Store(One, WIFR)
							}
						}
					}
				}
			}
		}
