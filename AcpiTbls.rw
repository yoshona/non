				}
				Else
				{
					If(LEqual(_T_0, 0x03))
					{
						ADBG("IOM_BIOS_MBX_GET_HPD_COUNT")
						If(LNotEqual(And(IMCD, 0x80000000), Zero))
						{
							ADBG("Timeout!")
							ADBG(Concatenate("IOM MB CMD Reg ", ToHexString(IMCD)))
							ADBG(Concatenate("IOM MB DATA Reg ", ToHexString(IMDA)))
							Store(One, CMST)
							Return(OPTS)
						}
						Else
