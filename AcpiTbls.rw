								ADBG(Concatenate("IOM MB CMD Reg ", ToHexString(IMCD)))
								Store(One, CMST)
							}
							Else
							{
								ADBG("Passed")
								ADBG(Concatenate("IOM MB CMD Reg :: ", ToHexString(IMCD)))
								ADBG(Concatenate("IOM MB DATA Reg :: ", ToHexString(IMDA)))
								ADBG(Concatenate("Arg2 is Port Number :: ", ToHexString(Arg2)))
								Store(Zero, CMST)
								Store(IMDA, RTB1)
							}
						}
						Return(OPTS)
					}
					Else
					{
						If(LEqual(_T_0, 0x06))
						{
							ADBG("BIOS_MBX_DEC_HPD_COUNT")
							Store(Zero, RTB1)
							If(LNotEqual(And(IMCD, 0x80000000), Zero))
							{
								ADBG("Timeout!")
								Store(One, CMST)
							}
							Else
							{
								If(LNotEqual(And(IMCD, 0xFF), Zero))
								{
									ADBG("Completion Code Fail")
									ADBG(Concatenate("IOM MB CMD Reg ", ToHexString(IMCD)))
									Store(One, CMST)
									Store(IMDA, RTB1)
								}
								Else
								{
									ADBG("Passed")
									Store(Zero, CMST)
								}
							}
							Return(OPTS)
						}
						Else
						{
							Store(One, CMST)
							Return(OPTS)
						}
					}
				}
				Break
			}
