		Method(SPMV, 2, Serialized)
		{
			Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
			OperationRegion(PDW0, SystemMemory, Local2, 0x04)
			Field(PDW0, AnyAcc, NoLock, Preserve)
			{
				Offset(0x1),	//Offset(1),
				, 2,
				TEMP, 3,
				Offset(0x4),	//Offset(4),
			}
			Store(Arg1, TEMP)
		}
		Method(GHPO, 1, Serialized)
		{
			Store(GNMB(Arg0), Local1)
			Add(GADR(Arg0, 0x02), Multiply(ShiftRight(Local1, 0x05), 0x04), Local3)
			And(Local1, 0x1F, Local4)
			OperationRegion(PREG, SystemMemory, Local3, 0x04)
			Field(PREG, AnyAcc, NoLock, Preserve)
			{
				TEMP, 32,
			}
			Return(And(ShiftRight(TEMP, Local4), One))
		}
		Method(SHPO, 2, Serialized)
		{
			Store(GNMB(Arg0), Local1)
			ADBG("Pad number")
			ADBG(ToHexString(Local1))
			Add(GADR(Arg0, 0x02), Multiply(ShiftRight(Local1, 0x05), 0x04), Local3)
			ADBG("HOST owner offset")
			ADBG(ToHexString(Local3))
			And(Local1, 0x1F, Local4)
			ADBG("Pad position")
			ADBG(ToHexString(Local4))
			OperationRegion(PREG, SystemMemory, Local3, 0x04)
			Field(PREG, AnyAcc, NoLock, Preserve)
			{
				TEMP, 32,
			}
			ADBG("HOST own before")
			ADBG(ToHexString(TEMP))
			If(Arg1)
			{
				Or(TEMP, ShiftLeft(One, Local4), TEMP)
			}
			Else
			{
				And(TEMP, Not(ShiftLeft(One, Local4)), TEMP)
			}
			ADBG("HOST own after")
			ADBG(ToHexString(TEMP))
		}
		Method(GGPO, 1, Serialized)
		{
			Store(GNMB(Arg0), Local1)
			Store(Add(GADR(Arg0, 0x03), Multiply(ShiftRight(Local1, 0x03), 0x04)), Local2)
			OperationRegion(PREG, SystemMemory, Local2, 0x04)
			Field(PREG, AnyAcc, NoLock, Preserve)
			{
				TEMP, 32,
			}
			Return(And(ShiftRight(TEMP, Multiply(And(Local1, 0x07), 0x04)), 0x03))
		}
		Method(SGRA, 2, Serialized)
		{
			Store(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), Local2)
			OperationRegion(PDW0, SystemMemory, Local2, 0x04)
			Field(PDW0, AnyAcc, NoLock, Preserve)
			{
				Offset(0x2),	//Offset(2),
				, 4,
				TEMP, 1,
				Offset(0x4),	//Offset(4),
			}
			Store(Arg1, TEMP)
		}
		Method(SGWP, 2, Serialized)
		{
			Store(Add(Add(GADR(Arg0, One), Multiply(GNMB(Arg0), 0x10)), 0x04), Local2)
			OperationRegion(PDW0, SystemMemory, Local2, 0x04)
			Field(PDW0, AnyAcc, NoLock, Preserve)
			{
				Offset(0x1),	//Offset(1),
				, 2,
				TEMP, 4,
				Offset(0x4),	//Offset(4),
			}
			Store(Arg1, TEMP)
		}
		Method(CGPI, 1, Serialized)
		{
			Store(GNMB(Arg0), Local1)
			ADBG("Pad number")
			ADBG(ToHexString(Local1))
			Store(ShiftRight(Local1, 0x05), Local4)
			ADBG("Group DW")
			ADBG(ToHexString(Local4))
			Store(GADR(Arg0, 0x04), Local3)
			ADBG("Reg offset")
			ADBG(ToHexString(Local3))
			If(LNotEqual(And(Local3, 0xFFFF), 0xFFFF))
			{
				ADBG("Clearing GPI")
				OperationRegion(GPPX, SystemMemory, Add(Local3, Multiply(Local4, 0x04)), 0x04)
				Field(GPPX, AnyAcc, NoLock, Preserve)
				{
					STSX, 32,
				}
				ShiftLeft(One, Mod(Local1, 0x20), Local2)
				ADBG("STSX before")
				ADBG(ToHexString(STSX))
				Store(Local2, STSX)
				ADBG("STSX after")
				ADBG(ToHexString(STSX))
			}
		}
		Method(CAGS, 1, Serialized)
		{
			Store(GGGP(Arg0), Local0)
			Store(GNMB(Arg0), Local1)
			Store(ShiftRight(Local1, 0x05), Local4)
			If(LNot(Or(Or(LAnd(LEqual(GEI0, Local0), LEqual(GED0, Local4)), LAnd(LEqual(GEI1, Local0), LEqual(GED1, Local4))), LAnd(LEqual(GEI2, Local0), LEqual(GED2, Local4)))))
			{
				Store(GADR(Arg0, 0x04), Local3)
				If(LNotEqual(And(Local3, 0xFFFF), 0xFFFF))
				{
					OperationRegion(GPPX, SystemMemory, Add(Local3, Multiply(Local4, 0x04)), 0x04)
					Field(GPPX, AnyAcc, NoLock, Preserve)
					{
						STSX, 32,
					}
					ShiftLeft(One, Mod(Local1, 0x20), Local2)
					Store(Local2, STSX)
				}
			}
		}
		Method(IGPI, 1, Serialized)
		{
			Store(GNMB(Arg0), Local1)
			Store(ShiftRight(Local1, 0x05), Local4)
			If(LEqual(And(GADR(Arg0, 0x04), 0xFFFF), 0xFFFF))
			{
				Return(Zero)
			}
			Add(GADR(Arg0, 0x04), Multiply(Local4, 0x04), Local2)
			And(Local1, 0x1F, Local3)
			OperationRegion(GPPX, SystemMemory, Local2, 0x24)
			Field(GPPX, AnyAcc, NoLock, Preserve)
			{
