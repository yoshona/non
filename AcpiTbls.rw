					}
				}
			})
			Method(UPDE, 4, NotSerialized)
			{
				If(LLess(DEVC, DEVS))
				{
					If(LNotEqual(SizeOf(Arg1), Zero))
					{
						Store(Concatenate(Concatenate(Arg0, "."), Arg1), Local0)
					}
					Else
					{
						Store(Arg0, Local0)
					}
					Store(Local0, Index(DerefOf(Index(DEVY, DEVC)), Zero))
					If(LEqual(Arg0, "Reserved"))
					{
						Increment(DEVC)
						Return(Zero)
					}
					Store(Arg2, Index(DerefOf(Index(DEVY, DEVC)), One))
					If(LEqual(Arg3, Zero))
					{
						Store(PCP0, Index(DerefOf(Index(DEVY, DEVC)), 0x02))
					}
					Else
					{
						If(LEqual(Arg3, One))
						{
							Store(PCP1, Index(DerefOf(Index(DEVY, DEVC)), 0x02))
						}
						Else
						{
							If(LEqual(Arg3, 0x02))
							{
								Store(PCP2, Index(DerefOf(Index(DEVY, DEVC)), 0x02))
							}
							Else
							{
								If(LEqual(Arg3, 0x03))
								{
									Store(PCP3, Index(DerefOf(Index(DEVY, DEVC)), 0x02))
								}
								Else
								{
									ADBG("PEP Error !!! Unknown D- state constraint is passed..")
								}
							}
						}
					}
					ADBG(Concatenate("DEVY entry index :", ToDecimalString(DEVC)))
					ADBG(Concatenate("Device Descriptor                  :", DerefOf(Index(DerefOf(Index(DEVY, DEVC)), Zero))))
					ADBG(Concatenate("Constraint (Enable/Disable)        :", DerefOf(Index(DerefOf(Index(DEVY, DEVC)), One))))
					ADBG(Concatenate("Constraint applied (D0/D0F1/D2/D3) :", Arg3))
					ADBG("------------ ")
					ADBG("")
					Increment(DEVC)
				}
				Else
				{
					ADBG(Concatenate("PEP UPDE Error!!!! DEVY size is excedded, DEVY size = ", ToDecimalString(DEVS)))
				}
			}
			Method(UPPR, 4, Serialized)
			{
				If(CondRefOf(Arg0))
				{
					Store(GRPC(Arg1), Local0)
					If(LNotEqual(Local0, Zero))
					{
						UPDE(Arg2, Arg3, One, Local0)
					}
					Else
					{
						UPDE(Arg2, Arg3, Zero, Local0)
					}
				}
			}
			Method(GUCP, 2, Serialized)
			{
				If(LEqual(And(PEPC, Arg0), Arg0))
				{
					If(LEqual(And(PEPC, Or(Arg1, Arg0)), Or(Arg1, Arg0)))
					{
						ADBG("D3 F0 constraint")
						Return(0x03)
					}
					Else
					{
						ADBG("D0 F1 constraint")
						Return(One)
					}
				}
				Else
				{
					ADBG("No constraint")
					Return(Zero)
				}
			}
			Method(GRPC, 1, Serialized)
			{
				If(LEqual(Arg0, One))
				{
					ADBG("PCIE Storage PEP")
					Return(Zero)
				}
				If(LEqual(Arg0, 0x02))
				{
					ADBG("PCIE LAN PEP")
					Return(GUCP(0x0E00000001000000, 0xA000000002000000))
				}
				If(LEqual(Arg0, 0x03))
				{
					ADBG("PCIE WLAN PEP")
					Return(GUCP(0x0E00000004000000, 0xA000000008000000))
				}
				If(LEqual(Arg0, 0x04))
				{
					ADBG("PCIE Graphics PEP")
					Return(GUCP(0x0E00000010000000, 0xA000000020000000))
				}
				If(LEqual(Arg0, 0x05))
				{
					ADBG("PCH PCIE DTBT PEP")
					Return(GUCP(0x00400000, 0x00400000))
				}
				If(LEqual(Arg0, 0x06))
				{
					ADBG("PCIE WWAN PEP")
					If(LEqual(WRTO, 0x03))
					{
						ADBG("PEP Constraint = D3")
						Return(0x03)
					}
					Else
					{
						If(LEqual(WRTO, 0x02))
						{
							ADBG("PEP Constraint = D0")
							Return(One)
						}
						Else
						{
							ADBG("PEP Constraint = no constraint")
							Return(Zero)
						}
					}
				}
				If(LEqual(Arg0, Zero))
				{
					ADBG("PCIE Others")
					Return(GUCP(0x0E00000040000000, 0x4100000080000000))
				}
				ADBG("PCIE EP NOT present")
				Return(Zero)
			}
			Method(SPDE, 0, Serialized)
			{
				If(LNot(ESPC))
				{
					Return(Zero)
				}
				If(CondRefOf(\_SB.PC02.SAT0))
				{
					UPDE("\\_SB.PC02", "SAT0.PRT0", ^^PC02.SAT0.PRT0.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT1", ^^PC02.SAT0.PRT1.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT2", ^^PC02.SAT0.PRT2.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT3", ^^PC02.SAT0.PRT3.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT4", ^^PC02.SAT0.PRT4.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT5", ^^PC02.SAT0.PRT5.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT6", ^^PC02.SAT0.PRT6.PRES, 0x03)
					UPDE("\\_SB.PC02", "SAT0.PRT7", ^^PC02.SAT0.PRT7.PRES, 0x03)
				}
			}
			Method(UPDV, 0, Serialized)
			{
				Store(SizeOf(DEVY), DEVS)
				ADBG(Concatenate("PEP DEVY size = ", ToDecimalString(DEVS)))
				SPDE()
				If(LEqual(ShiftRight(And(PEPC, 0x10000000), 0x1C), One))
				{
					If(LEqual(ShiftRight(And(PEPC, 0x30000000), 0x1C), One))
					{
						UPDE("\\_SB.PC02", "SAT0", ShiftRight(And(PEPC, 0x10000000), 0x1C), One)
					}
					Else
					{
						If(LEqual(ShiftRight(And(PEPC, 0x30000000), 0x1C), 0x03))
						{
							UPDE("\\_SB.PC02", "SAT0", ShiftRight(And(PEPC, 0x10000000), 0x1C), 0x03)
						}
					}
				}
				Else
				{
					If(LEqual(ShiftRight(And(PEPC, 0x30000000), 0x1C), 0x02))
					{
						UPDE("\\_SB.PC02", "SAT0.VOL0", One, One)
					}
				}
				ADBG(Concatenate("Pep TCNT : ", ToHexString(TCNT)))
				Store(Zero, Local0)
				While(LLess(Local0, TCNT))
				{
					If(LLess(Local0, 0x0A))
					{
						Concatenate("PR0", Local0, Local1)
					}
					Else
					{
						Concatenate("PR", ToDecimalString(Local0), Local1)
					}
					If(LEqual(And(PEPC, 0x00010000), Zero))
					{
						UPDE("\\_SB", Local1, Zero, Zero)
					}
					Else
					{
						UPDE("\\_SB", Local1, One, Zero)
					}
					Add(Local0, One, Local0)
				}
				UPDE("\\_SB.PC00", "GFX0", ShiftRight(And(PEPC, 0x8000), 0x0F), 0x03)
				UPDE("\\_SB.PC02", "HDAS", One, GUCP(0x04000000, 0x08000000))
				UPDE("\\_SB.PC02", "UA00", ShiftRight(And(PEPC, One), Zero), 0x03)
				UPDE("\\_SB.PC02", "UA01", ShiftRight(And(PEPC, 0x02), One), 0x03)
				UPDE("\\_SB.PC02", "UA02", ShiftRight(And(PEPC, 0x04), 0x02), 0x03)
				UPDE("\\_SB.PC02", "I2C0", ShiftRight(And(PEPC, 0x08), 0x03), 0x03)
				UPDE("\\_SB.PC02", "I2C1", ShiftRight(And(PEPC, 0x10), 0x04), 0x03)
				UPDE("\\_SB.PC02", "I2C2", ShiftRight(And(PEPC, 0x20), 0x05), 0x03)
				UPDE("\\_SB.PC02", "I2C3", ShiftRight(And(PEPC, 0x40), 0x06), 0x03)
				UPDE("\\_SB.PC02", "I2C4", ShiftRight(And(PEPC, 0x80), 0x07), 0x03)
				UPDE("\\_SB.PC02", "I2C5", ShiftRight(And(PEPC, 0x0100), 0x08), 0x03)
				UPDE("\\_SB.PC00", "I2C6", ShiftRight(And(PEPC, 0x0200), 0x09), 0x03)
				UPDE("\\_SB.PC00", "I2C7", ShiftRight(And(PEPC, 0x0400), 0x0A), 0x03)
				UPDE("\\_SB.PC02", "SPI0", ShiftRight(And(PEPC, 0x0800), 0x0B), 0x03)
				UPDE("\\_SB.PC02", "SPI1", ShiftRight(And(PEPC, 0x1000), 0x0C), 0x03)
				UPDE("\\_SB.PC02", "SPI2", ShiftRight(And(PEPC, 0x2000), 0x0D), 0x03)
				UPDE("\\_SB.PC02", "XHCI", ShiftRight(And(PEPC, 0x4000), 0x0E), 0x03)
				UPDE("\\_SB.PC00", "PEMC", ShiftRight(And(PEPC, 0x0000000100000000), 0x28), 0x03)
				UPDE("\\_SB.PC00", "PSDC", ShiftRight(And(PEPC, 0x0000000200000000), 0x29), 0x03)
				UPDE("\\_SB.PC00", "IPU0", ShiftRight(And(PEPC, 0x00020000), 0x11), 0x03)
				UPDE("\\_SB.PC02", "HECI", ShiftRight(And(PEPC, 0x00040000), 0x12), One)
				If(LOr(LEqual(ShiftRight(And(PEPC, 0x00080000), 0x13), Zero), LEqual(^^PC02.GBES, Zero)))
				{
					UPDE("\\_SB.PC02", "GLAN", Zero, 0x03)
				}
				Else
				{
					UPDE("\\_SB.PC02", "GLAN", One, 0x03)
				}
				UPDE("\\_SB.PC00", "THC0", ShiftRight(And(PEPC, 0x00100000), 0x14), 0x03)
				UPDE("\\_SB.PC00", "THC1", ShiftRight(And(PEPC, 0x00200000), 0x15), 0x03)
				If(LEqual(WRTO, One))
				{
					UPDE("USB\\VID_8087&PID_0AC9&MI*", "", One, WRTO)
					ADBG("PEP Constraint for CDC MBIM = D0F1")
				}
				Else
				{
					UPDE("USB\\VID_8087&PID_0AC9&MI*", "", Zero, 0x02)
				}
				UPDE("\\_SB.PC00", "GNA0", ShiftRight(And(PEPC, 0x00800000), 0x17), 0x03)
				UPDE("\\_SB.PC00", "VMD0", ShiftRight(And(PEPC, 0x01000000), 0x18), 0x03)
				If(CondRefOf(\_SB.PC00.HEC3))
				{
					ADBG("HECI3 PEP")
					UPDE("\\_SB.PC00", "HEC3", ShiftRight(And(PEPC, 0x02000000), 0x19), One)
				}
				UPDE("\\_SB.PC00", "PUF0", ShiftRight(And(PEPC, 0x0000000800000000), 0x2B), 0x03)
				UPDE("\\_SB.PC00", "PUF1", ShiftRight(And(PEPC, 0x0000001000000000), 0x2C), 0x03)
				UPDE("\\_SB.PC00", "VPU0", ShiftRight(And(PEPC, 0x0000000400000000), 0x2A), 0x03)
				If(LNotEqual(And(PEPC, 0x00400000), Zero))
				{
					If(LEqual(THCE, One))
					{
						UPDE("\\_SB.PC00", "TXHC", One, 0x03)
					}
					Else
					{
						UPDE("\\_SB.PC00", "TXHC", Zero, 0x03)
					}
					If(LEqual(TDCE, One))
					{
						UPDE("\\_SB.PC00", "TXDC", One, 0x03)
					}
					Else
					{
						UPDE("\\_SB.PC00", "TXDC", Zero, 0x03)
					}
					UPDE("\\_SB.PC00", "TRP0", TRE0, 0x03)
					UPDE("\\_SB.PC00", "TRP1", TRE1, 0x03)
					UPDE("\\_SB.PC00", "TRP2", TRE2, 0x03)
					UPDE("\\_SB.PC00", "TRP3", TRE3, 0x03)
					UPDE("\\_SB.PC00", "TDM0", DME0, 0x03)
					UPDE("\\_SB.PC00", "TDM1", DME1, 0x03)
				}
				Else
				{
					UPDE("\\_SB.PC00", "TXHC", Zero, 0x03)
					UPDE("\\_SB.PC00", "TXDC", Zero, 0x03)
					UPDE("\\_SB.PC00", "TRP0", Zero, 0x03)
					UPDE("\\_SB.PC00", "TRP1", Zero, 0x03)
					UPDE("\\_SB.PC00", "TRP2", Zero, 0x03)
					UPDE("\\_SB.PC00", "TRP3", Zero, 0x03)
					UPDE("\\_SB.PC00", "TDM0", Zero, 0x03)
					UPDE("\\_SB.PC00", "TDM1", Zero, 0x03)
				}
				UPDE("\\_SB.PC01", "TRP0", Zero, Zero)
				UPDE("\\_SB.PC01", "TRP1", Zero, Zero)
				UPDE("\\_SB.PC01", "TRP2", Zero, Zero)
				UPDE("\\_SB.PC01", "TRP3", Zero, Zero)
				UPPR(^^PC00.RP01, ^^PC00.RP01.PXSX.GRPT(), "\\_SB.PC00", "RP01")
				UPPR(^^PC00.RP09, ^^PC00.RP09.PXSX.GRPT(), "\\_SB.PC00", "RP09")
				UPPR(^^PC00.RP13, ^^PC00.RP13.PXSX.GRPT(), "\\_SB.PC00", "RP13")
				UPPR(^^PC00.RP17, ^^PC00.RP17.PXSX.GRPT(), "\\_SB.PC00", "RP17")
				UPPR(^^PC00.RP21, ^^PC00.RP21.PXSX.GRPT(), "\\_SB.PC00", "RP21")
				UPPR(^^PC02.RP01, ^^PC02.RP01.PXSX.GRPT(), "\\_SB.PC02", "RP01")
				UPPR(^^PC02.RP02, ^^PC02.RP02.PXSX.GRPT(), "\\_SB.PC02", "RP02")
				UPPR(^^PC02.RP03, ^^PC02.RP03.PXSX.GRPT(), "\\_SB.PC02", "RP03")
				UPPR(^^PC02.RP04, ^^PC02.RP04.PXSX.GRPT(), "\\_SB.PC02", "RP04")
				UPPR(^^PC02.RP05, ^^PC02.RP05.PXSX.GRPT(), "\\_SB.PC02", "RP05")
				UPPR(^^PC02.RP06, ^^PC02.RP06.PXSX.GRPT(), "\\_SB.PC02", "RP06")
				UPPR(^^PC02.RP07, ^^PC02.RP07.PXSX.GRPT(), "\\_SB.PC02", "RP07")
				UPPR(^^PC02.RP08, ^^PC02.RP08.PXSX.GRPT(), "\\_SB.PC02", "RP08")
				UPPR(^^PC02.RP09, ^^PC02.RP09.PXSX.GRPT(), "\\_SB.PC02", "RP09")
				UPPR(^^PC02.RP10, ^^PC02.RP10.PXSX.GRPT(), "\\_SB.PC02", "RP10")
				UPPR(^^PC02.RP11, ^^PC02.RP11.PXSX.GRPT(), "\\_SB.PC02", "RP11")
				UPPR(^^PC02.RP12, ^^PC02.RP12.PXSX.GRPT(), "\\_SB.PC02", "RP12")
				UPPR(^^PC02.RP13, ^^PC02.RP13.PXSX.GRPT(), "\\_SB.PC02", "RP13")
				UPPR(^^PC02.RP14, ^^PC02.RP14.PXSX.GRPT(), "\\_SB.PC02", "RP14")
				UPPR(^^PC02.RP15, ^^PC02.RP15.PXSX.GRPT(), "\\_SB.PC02", "RP15")
				UPPR(^^PC02.RP16, ^^PC02.RP16.PXSX.GRPT(), "\\_SB.PC02", "RP16")
				UPPR(^^PC02.RP17, ^^PC02.RP17.PXSX.GRPT(), "\\_SB.PC02", "RP17")
				UPPR(^^PC02.RP18, ^^PC02.RP18.PXSX.GRPT(), "\\_SB.PC02", "RP18")
				UPPR(^^PC02.RP19, ^^PC02.RP19.PXSX.GRPT(), "\\_SB.PC02", "RP19")
				UPPR(^^PC02.RP20, ^^PC02.RP20.PXSX.GRPT(), "\\_SB.PC02", "RP20")
				UPPR(^^PC02.RP21, ^^PC02.RP21.PXSX.GRPT(), "\\_SB.PC02", "RP21")
				UPPR(^^PC02.RP22, ^^PC02.RP22.PXSX.GRPT(), "\\_SB.PC02", "RP22")
				UPPR(^^PC02.RP23, ^^PC02.RP23.PXSX.GRPT(), "\\_SB.PC02", "RP23")
				UPPR(^^PC02.RP24, ^^PC02.RP24.PXSX.GRPT(), "\\_SB.PC02", "RP24")
				If(CondRefOf(\_SB.PC02.CNVW.VDID))
				{
					If(LNotEqual(^^PC02.CNVW.VDID, 0xFFFFFFFF))
					{
						ADBG("CNVi- WiFI PEP")
						UPDE("\\_SB.PC02", "CNVW", One, 0x03)
					}
				}
				Store(DEVC, Local0)
				While(LLess(Local0, DEVS))
				{
					UPDE("Reserved", ToDecimalString(Local0), Zero, Zero)
					Add(Local0, One, Local0)
				}
				Store(Zero, DEVC)
				ADBG("[PEP] All Pep Constraints are updated ")
			}
			Name(BCCD, Package(0){})
			Name(DSDV, Package(2)
			{
				Buffer(0x10)
				{
					0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
					0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
				}, 
				Package(1)
				{
					Package(2) {"intel-cec-pson-switching-enabled-in-s0", Zero}
				}
			})
			Method(_DSD, 0, NotSerialized)
			{
				Store(Zero, Local0)
				While(LLess(Local0, SizeOf(DSDV)))
				{
					If(LNotEqual(DerefOf(Index(DSDV, Local0)), Buffer(0x10)
					{
						0x14, 0xD8, 0xFF, 0xDA, 0xBA, 0x6E, 0x8C, 0x4D, 
						0x8A, 0x91, 0xBC, 0x9B, 0xBF, 0x4A, 0xA3, 0x01
					}))
					{
						Continue
					}
					Store(DerefOf(Index(DSDV, Add(Local0, One))), Local1)
					Store(Zero, Local2)
					While(LLess(Local2, SizeOf(Local1)))
					{
						Store(DerefOf(Index(Local1, Local2)), Local3)
						If(LAnd(LEqual("intel-cec-pson-switching-enabled-in-s0", DerefOf(Index(Local3, Zero))), PSON))
						{
							ADBG("PEPD: Storing 1 in DSDV Object")
							Store(One, Index(DerefOf(Index(DerefOf(Index(DSDV, Add(Local0, One))), Local2)), One))
						}
						Increment(Local2)
					}
					Add(Local0, 0x02, Local0)
				}
				Return(DSDV)
			}
			Method(_STA, 0, NotSerialized)
			{
				If(LEqual(S0ID, One))
				{
					Return(0x0F)
				}
				Return(Zero)
			}
			Method(_DSM, 4, Serialized)
			{
				ADBG(Concatenate("PEPC = ", ToHexString(PEPC)))
				If(LEqual(Arg0, ToUUID("11E00D56-CE6447CE-837B1F898F9AA461")}))
				{
					If(LEqual(Arg2, Zero))
					{
						Return(Buffer(0x02)
						{
							0x81, 0x01
						})
					}
					If(LEqual(Arg2, 0x07))
					{
						If(LEqual(PFLV, 0x02))
						{
							If(CondRefOf(ECON))
							{
								If(LEqual(ECON, One))
								{
									If(LEqual(PPOE, One))
									{
										If(CondRefOf(\_SB.PC00.LPCB.NRTS))
										{
											^^PC00.LPCB.NRTS(Zero)
										}
									}
								}
							}
						}
					}
					If(LEqual(Arg2, 0x08))
					{
						If(LEqual(PFLV, 0x02))
						{
							If(CondRefOf(ECON))
							{
								If(LEqual(ECON, One))
								{
									If(LEqual(PPOE, One))
									{
										If(CondRefOf(\_SB.PC00.LPCB.NRTS))
										{
											^^PC00.LPCB.NRTS(One)
										}
									}
								}
							}
						}
					}
				}
				If(LEqual(Arg0, ToUUID("C4EB40A0-6CD211E2-BCFD0800200C9A66")}))
				{
					If(LEqual(Arg2, Zero))
					{
						Return(Buffer(One)
						{
							0x7F
						})
					}
					If(LEqual(Arg2, One))
					{
						If(LEqual(S0ID, Zero))
						{
							Return(Package(0){})
						}
						If(LEqual(IPDI, Zero))
						{
							UPDV()
							Store(One, IPDI)
						}
						Else
						{
							ADBG("PEP DEVY is already initialized !!! ")
						}
						Return(DEVY)
					}
					If(LEqual(Arg2, 0x02))
					{
						Return(BCCD)
					}
					If(LEqual(Arg2, 0x03))
					{
						If(CondRefOf(\_SB.PC00.IMNG))
						{
							^^PC00.IMNG(Arg2)
						}
						If(LEqual(S0ID, One))
						{
							D8XH(Zero, 0xC5)
							D8XH(One, Zero)
							Store(One, ^^PC00.LPCB.EC0.S0E1)
						}
					}
					If(LEqual(Arg2, 0x04))
					{
						If(CondRefOf(\_SB.PC00.IMNG))
						{
							^^PC00.IMNG(Arg2)
						}
						If(LEqual(S0ID, One))
						{
							D8XH(Zero, 0xC5)
							D8XH(One, 0xAB)
							^^PC00.LPCB.EC0.OPML()
							Store(Zero, ^^PC00.LPCB.EC0.S0E1)
						}
					}
					Store(Zero, Local0)
					If(LEqual(Arg2, 0x05))
					{
						ADBG("[PEP] deep standby entry")
						If(LEqual(S0ID, One))
						{
							GUAM(One)
						}
						If(LEqual(ECON, Zero))
						{
							If(LEqual(ITSI, One)) {}
						}
						If(CondRefOf(\_SB.PC00.TXHC))
						{
							If(CondRefOf(\_SB.PC00.TDM0))
							{
								If(LEqual(^^PC00.TDM0._STA(), 0x0F))
								{
									If(LEqual(^^PC00.TDM0.SCME, Zero))
									{
										Store(One, Local0)
										ADBG(Concatenate("TDM0 set DPOF to ", ToHexString(Local0)))
									}
								}
							}
							If(CondRefOf(\_SB.PC00.TDM1))
							{
								If(LEqual(^^PC00.TDM1._STA(), 0x0F))
								{
									If(LEqual(^^PC00.TDM1.SCME, Zero))
									{
										Store(One, Local0)
										ADBG(Concatenate("TDM1 set DPOF to ", ToHexString(Local0)))
									}
								}
							}
							If(LEqual(Local0, One))
							{
								Store(One, ^^PC00.DPOF)
							}
							ADBG(Concatenate("All Monitor off flag: ", ToHexString(^^PC00.DPOF)))
							If(CondRefOf(\GPRV))
							{
								ADBG("[PEP] allow PS_ON")
								GPRV(0x03, Zero)
							}
						}
						^^PC00.LPCB.EC0.CPML()
						Store(One, ^^PC00.LPCB.EC0.S0E3)
					}
					If(LEqual(Arg2, 0x06))
					{
						ADBG("[PEP] deep standby exit")
						Store(Zero, ^^PC00.LPCB.EC0.S0E3)
						If(LEqual(S0ID, One))
						{
							GUAM(Zero)
						}
						If(LEqual(ECON, Zero))
						{
							If(LEqual(ITSI, One)) {}
						}
						If(CondRefOf(\_SB.PC00.TXHC))
						{
							Store(Zero, ^^PC00.DPOF)
						}
						If(CondRefOf(\GPRV))
						{
							ADBG("[PEP] veto PS_ON")
							GPRV(0x03, One)
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
		}
	}
	Device(PSM)
	{
		Name(_HID, EISAID("INT3420"))
		Name(_UID, Zero)
		Name(_STR, Unicode("Power Sharing Manager")})
		Method(_STA, 0, NotSerialized)
		{
			If(LEqual(PSME, One))
			{
				Return(0x0F)
			}
			Else
			{
				Return(Zero)
			}
		}
		Name(SPLX, Package(2)
		{
			Zero, 
			Package(3) {0x80000000, 0x80000000, 0x80000000}
		})
		Method(SPLC, 0, Serialized)
		{
			Store(PDT1, Index(DerefOf(Index(SPLX, One)), Zero))
			Store(PLM1, Index(DerefOf(Index(SPLX, One)), One))
			Store(PTW1, Index(DerefOf(Index(SPLX, One)), 0x02))
			Return(SPLX)
		}
		Name(DPLX, Package(2)
		{
			Zero, 
			Package(3)
			{
				0x80000000, 
				0x80000000, 
				Package(6) {0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000, 0x80000000}
			}
		})
		Method(DPLC, 0, Serialized)
		{
			Store(DDT1, Index(DerefOf(Index(DPLX, One)), Zero))
			Store(DDP1, Index(DerefOf(Index(DPLX, One)), One))
			Store(DLI1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), Zero))
			Store(DPL1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), One))
			Store(DTW1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), 0x02))
			Store(DMI1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), 0x03))
			Store(DMA1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), 0x04))
			Store(DMT1, Index(DerefOf(Index(DerefOf(Index(DPLX, One)), 0x02)), 0x05))
			Return(DPLX)
		}
	}
	Scope(_SB)
	{
		Method(WFRK, 1, Serialized)
		{
			If(LNotEqual(DWFK, Zero))
			{
				^PGPI.SGOV
				DWFK
				Arg0
			}
		}
		Method(BTRK, 1, Serialized)
		{
			If(LNotEqual(GBTK, Zero))
			{
				^PGPI.SGOV
				GBTK
				Arg0
			}
		}
		Method(GBTR, 0, NotSerialized)
		{
			Return(^PGPI.GGOV)
			GBTK
		}
	}
	If(LEqual(CRFP, One))
	{
		If(LEqual(CWFC, One))
		{
			Scope(_SB.PC02.CNVW)
			{
				Name(SPLX, Package(2)
				{
					Zero, 
