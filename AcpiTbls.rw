								}
							}
						}
					}
					Return(Zero)
				}
				Method(IDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0x2C, 0x17, 0x66, 0x72, 0x0B, 0x22, 0x29, 0x4B, 
						0x81, 0x4F, 0x75, 0xE4, 0xDD, 0x26, 0xB5, 0xFD
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
				Method(EFUN, 4, Serialized)
				{
					If(LEqual(Arg2, Zero))
					{
						If(LEqual(Arg1, Zero))
						{
							Return(Buffer(0x02)
							{
								0xFF, 0x1F
							})
						}
						Else
						{
							Return(Buffer(One)
							{
								0x00
							})
						}
					}
					If(LEqual(Arg2, One))
					{
						Store(ACSD, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x02))
					{
						Store(I5BS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x03))
					{
						Store(UHBS, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x06))
					{
						Store(AXMU, Local0)
						ShiftLeft(Local0, One, Local0)
						Or(Local0, AXSU, Local0)
						Store(AXMR, Local1)
						ShiftLeft(Local1, One, Local1)
						Or(Local1, AXSR, Local1)
						ShiftLeft(Local1, 0x02, Local1)
						Or(Local0, Local1, Local0)
						Return(Local0)
					}
					If(LEqual(Arg2, 0x04))
					{
						Return(WFRC)
					}
					If(LEqual(Arg2, 0x05))
					{
						Return(WFUC)
					}
					If(LEqual(Arg2, 0x07))
					{
						Return(UNI4)
					}
					If(LEqual(Arg2, 0x08))
					{
						Return(WFIC)
					}
					If(LEqual(Arg2, 0x09))
					{
						Return(WFBS)
					}
					If(LEqual(Arg2, 0x0A))
					{
						Return(WEDT)
					}
					If(LEqual(Arg2, 0x0B))
					{
						If(CondRefOf(DRIE))
						{
							If(CondRefOf(CRFI))
							{
								If(LAnd(LEqual(DRIE, One), LEqual(CRFI, One)))
								{
									Return(Zero)
								}
								Else
								{
									If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, One)))
									{
										Return(One)
									}
									Else
									{
										If(LAnd(LEqual(DRIE, One), LEqual(CRFI, Zero)))
										{
											Return(0x02)
										}
										Else
										{
											If(LAnd(LEqual(DRIE, Zero), LEqual(CRFI, Zero)))
											{
												Return(0x03)
											}
										}
									}
								}
							}
						}
						Return(Zero)
					}
					If(LEqual(Arg2, 0x0C))
					{
						Return(WF7C)
					}
					Return(Zero)
				}
				Method(EDSM, 1, Serialized)
				{
					If(LEqual(Arg0, Buffer(0x10)
					{
						0xBF, 0x02, 0x12, 0xF2, 0x78, 0x8F, 0xC6, 0x4D, 
						0xA5, 0xB3, 0x1F, 0x73, 0x8E, 0x28, 0x5A, 0xDE
					}))
					{
						Return(One)
					}
					Return(Zero)
				}
			}
			Method(_DSM, 4, Serialized)
			{
				If(LOr(WIST, LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT))))
				{
					If(WIST)
					{
						If(EDSM)
						{
							Arg0
							Return(EFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
						If(IDSM)
						{
							Arg0
							Return(IFUN)
							Arg0
							Arg1
							Arg2
							Arg3
						}
					}
					If(LAnd(LNotEqual(WWEN, Zero), LEqual(WWRP, SLOT)))
					{
						If(LEqual(Arg0, ToUUID("BAD01B75-22A84F48-8792BDDE9467747D")}))
						{
							If(LEqual(Arg2, Zero))
							{
								Return(Buffer(One)
								{
									0x09
								})
							}
							If(LEqual(Arg2, One)) {}
							If(LEqual(Arg2, 0x02)) {}
							If(LEqual(Arg2, 0x03))
							{
								If(LEqual(WRTO, One))
								{
									ADBG("WWAN Power _DSM D0/L1.2")
								}
								Else
								{
									If(LEqual(WRTO, 0x02))
									{
										ADBG("WWAN Power _DSM D3/L1.2")
									}
									Else
									{
										If(LEqual(WRTO, 0x03))
										{
											ADBG("WWAN Power _DSM D3/L2")
										}
										Else
										{
											ADBG("WWAN Power _DSM Disabled")
										}
									}
								}
								Return(WRTO)
							}
						}
					}
				}
				Return(Buffer(One)
				{
					0x00
				})
			}
		}
	}
