										{
											If(CondRefOf(ECR1))
											{
												If(LEqual(ECR1, One))
												{
													If(LGreaterEqual(Arg1, 0x03))
													{
														Return(Package(5) {0xC350, Ones, Ones, 0xC350, Ones})
													}
												}
											}
										}
										Else
