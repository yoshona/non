										}
										Else
										{
											If(LEqual(_T_0, 0x07))
											{
												Store("Tcss Dma 1", Local0)
											}
											Else
											{
												If(LEqual(_T_0, 0x08))
												{
													Store("Tcss iTbt Pcie 1 RP 0", Local0)
												}
												Else
												{
													If(LEqual(_T_0, 0x09))
													{
														Store("Tcss iTbt Pcie 1 RP 1", Local0)
													}
													Else
