		{
			Name(_HID, EISAID("PNP0C02"))
			Name(_UID, "SOCCLK")
			OperationRegion(CKOR, SystemMemory, Add(SBRG, Add(ShiftLeft(ICKP, 0x10), 0x8000)), 0x40)
			Field(CKOR, AnyAcc, Lock, Preserve)
			{
