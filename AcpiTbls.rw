				CreateBitField(BUF0,0x0908,DCRW)
				Store(Zero, DCRW)
			}
			If(^MC.PM5L)
			{
				CreateDWordField(BUF0, 0x014C, E0LN)
				Store(Zero, E0LN)
			}
			If(LEqual(^MC.PM5L, One))
			{
				CreateBitField(BUF0,0x09D8,E0RW)
				Store(Zero, E0RW)
			}
			If(^MC.PM5H)
			{
				CreateDWordField(BUF0, 0x0166, E4LN)
				Store(Zero, E4LN)
			}
			If(LEqual(^MC.PM5H, One))
			{
				CreateBitField(BUF0,0x0AA8,E4RW)
				Store(Zero, E4RW)
			}
			If(^MC.PM6L)
			{
				CreateDWordField(BUF0, 0x0180, E8LN)
				Store(Zero, E8LN)
			}
			If(LEqual(^MC.PM6L, One))
			{
				CreateBitField(BUF0,0x0B78,E8RW)
				Store(Zero, E8RW)
			}
			If(^MC.PM6H)
			{
				CreateDWordField(BUF0, 0x019A, ECLN)
				Store(Zero, ECLN)
			}
			If(LEqual(^MC.PM6H, One))
			{
				CreateBitField(BUF0,0x0C48,ECRW)
				Store(Zero, ECRW)
			}
			If(^MC.PM0H)
			{
				CreateDWordField(BUF0, 0x01B4, F0LN)
				Store(Zero, F0LN)
			}
			If(LEqual(^MC.PM0H, One))
			{
				CreateBitField(BUF0,0x0D18,F0RW)
				Store(Zero, F0RW)
			}
			CreateDWordField(BUF0, 0x3C, I1MN)
			CreateDWordField(BUF0, 0x40, I1MX)
			CreateDWordField(BUF0, 0x48, I1LN)
			CreateDWordField(BUF0, 0x01C2, M1MN)
			CreateDWordField(BUF0, 0x01C6, M1MX)
			CreateDWordField(BUF0, 0x01CE, M1LN)
			Store(M32L, M1LN)
			Store(M32B, M1MN)
			Subtract(Add(M1MN, M1LN), One, M1MX)
			If(LEqual(M64L, Zero))
			{
				CreateQWordField(BUF0, 0x01F8, MSLN)
				Store(Zero, MSLN)
			}
			Else
			{
				CreateQWordField(BUF0, 0x01F8, M2LN)
				CreateQWordField(BUF0, 0x01E0, M2MN)
				CreateQWordField(BUF0, 0x01E8, M2MX)
				Store(M64L, M2LN)
				Store(M64B, M2MN)
				Subtract(Add(M2MN, M2LN), One, M2MX)
			}
			If(LNotEqual(PCHA, Zero))
			{
				Store(SBSB, PBMN)
				Store(SBSL, PBMX)
				Subtract(SBSL, SBSB, PBLN)
				Add(PBLN, One, PBLN)
				Store(SIOB, I1MN)
				Store(SIOL, I1MX)
				Subtract(I1MX, I1MN, I1LN)
				Add(I1LN, One, I1LN)
				Store(SMEB, M1MN)
				Store(SMEL, M1MX)
				Subtract(M1MX, M1MN, M1LN)
				Add(M1LN, One, M1LN)
				Store(SPMB, M2MN)
				Store(SPML, M2MX)
				Subtract(M2MX, M2MN, M2LN)
				Add(M2LN, One, M2LN)
			}
			Return(BUF0)
		}
		Name(GUID, Buffer(0x10)
		{
			0x5B, 0x4D, 0xDB, 0x33, 0xF7, 0x1F, 0x1C, 0x40, 
			0x96, 0x57, 0x74, 0x41, 0xC0, 0x3D, 0xD7, 0x66
		})
		Name(SUPP, Zero)
		Name(CTRL, Zero)
		Name(XCNT, Zero)
		Method(_OSC, 4, Serialized)
		{
			Store(Arg3, Local0)
			CreateDWordField(Local0, Zero, CDW1)
			CreateDWordField(Local0, 0x04, CDW2)
			CreateDWordField(Local0, 0x08, CDW3)
			If(LEqual(Arg0, GUID))
			{
				Store(CDW2, SUPP)
				Store(CDW3, CTRL)
				If(LNot(NEXP))
				{
					And(CTRL, 0xFFFFFFF8, CTRL)
				}
				If(Not(And(CDW1, One)))
				{
					Store(CTRL, OSCC)
					If(CondRefOf(SWAK))
					{
						SWAK(0xFFFF, Zero)
					}
				}
				If(LNotEqual(Arg1, One))
				{
					Or(CDW1, 0x08, CDW1)
				}
				If(LNotEqual(CDW3, CTRL))
				{
					Or(CDW1, 0x10, CDW1)
				}
				Store(CTRL, CDW3)
				Store(CTRL, OSCC)
				Return(Local0)
			}
			Else
			{
				Or(CDW1, 0x04, CDW1)
				Return(Local0)
			}
		}
